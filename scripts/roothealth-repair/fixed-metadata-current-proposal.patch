index 0000000000000000000000000000000000000000..931948a3a27e7c876c4aa318c3ea51785a637641
--- /dev/null
+++ b/tests/roothealth_fixed_metadata_mutate.c
@@ -0,0 +1,87 @@
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "roothealth_fixed_metadata.h"
+
+int main(int argc, char **argv)
+{
+	struct rh_writer writer;
+	struct rh_ntfs_overlay overlay;
+	struct rh_fixed_metadata_inspection inspection;
+	enum rh_fixed_metadata_kind kind;
+	uint64_t logical, physical = 0;
+	unsigned char byte;
+	size_t i;
+	int fd = -1, mounted = 0, result = 1;
+
+	memset(&inspection, 0, sizeof(inspection));
+	if (argc != 3)
+		return 5;
+	if (!strcmp(argv[2], "upcase-tail")) {
+		kind = RH_FIXED_METADATA_UPCASE;
+		logical = RH_UPCASE_CANONICAL_SIZE - 1U;
+	} else if (!strcmp(argv[2], "upcase-ascii")) {
+		kind = RH_FIXED_METADATA_UPCASE;
+		logical = 2U * (uint64_t)'a';
+	} else if (!strcmp(argv[2], "attrdef")) {
+		kind = RH_FIXED_METADATA_ATTRDEF;
+		logical = RH_ATTRDEF_CANONICAL_SIZE - 1U;
+	} else if (!strcmp(argv[2], "attrdef-structural")) {
+		kind = RH_FIXED_METADATA_ATTRDEF;
+		logical = 0x8cU;
+	} else
+		return 5;
+	if (rh_writer_open(&writer, argv[1]))
+		return 3;
+	if (rh_ntfs_overlay_mount(&overlay, &writer, 0))
+		goto out_writer;
+	mounted = 1;
+	if (rh_fixed_metadata_inspect(overlay.volume, &writer, kind,
+			&inspection) || !inspection.canonical) {
+		fprintf(stderr, "fixed metadata inspect failed: %s canonical=%d\n",
+			strerror(errno), inspection.canonical);
+		goto out;
+	}
+	for (i = 0; i < inspection.slice_count; i++) {
+		const struct rh_fixed_metadata_slice *slice = &inspection.slices[i];
+
+		if (logical >= slice->logical_offset &&
+				logical - slice->logical_offset < slice->length) {
+			physical = slice->physical_offset + logical -
+				slice->logical_offset;
+			break;
+		}
+	}
+	if (!physical || rh_writer_read(&writer, physical, 1, &byte))
+		goto out;
+	rh_fixed_metadata_inspection_destroy(&inspection);
+	rh_ntfs_overlay_unmount(&overlay);
+	mounted = 0;
+	rh_writer_close(&writer);
+	byte ^= 0x5aU;
+	fd = open(argv[1], O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0 || pwrite(fd, &byte, 1, (off_t)physical) != 1 || fsync(fd) ||
+			close(fd)) {
+		if (fd >= 0)
+			close(fd);
+		return 3;
+	}
+	printf("fixed-metadata-mutated kind=%u logical=%llu physical=%llu\n",
+		(unsigned int)kind, (unsigned long long)logical,
+		(unsigned long long)physical);
+	return 0;
+out:
+	rh_fixed_metadata_inspection_destroy(&inspection);
+	if (mounted)
+		rh_ntfs_overlay_unmount(&overlay);
+out_writer:
+	rh_writer_close(&writer);
+	return result;
+}
