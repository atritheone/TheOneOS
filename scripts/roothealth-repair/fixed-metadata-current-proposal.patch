+static void tagged_hash(const char *label, enum rh_fixed_metadata_kind kind,
+		enum rh_fixed_metadata_view view, uint64_t serial,
+		unsigned char output[32])
+{
+	char text[160];
+
+	snprintf(text, sizeof(text), "%s:%u:%u:%016llx", label,
+		(unsigned int)kind, (unsigned int)view,
+		(unsigned long long)serial);
+	rh_sha256(text, strlen(text), output);
+}
+
+static int flagless_mount_probe(struct rh_writer *writer, int expected,
+		int *mounted_out)
+{
+	struct rh_ntfs_overlay ordinary;
+	int mounted;
+
+	errno = 0;
+	mounted = !rh_ntfs_overlay_mount(&ordinary, writer, 0);
+	if (mounted)
+		rh_ntfs_overlay_unmount(&ordinary);
+	if ((expected >= 0 && mounted != expected) || writer->operation_count ||
+			writer->write_boundaries)
+		return -1;
+	*mounted_out = mounted;
+	return 0;
+}
+
+static int make_authority(enum rh_fixed_metadata_kind kind,
+		enum rh_fixed_metadata_view view, uint64_t generation, uint64_t serial,
+		struct rh_fixed_metadata_authority *authority)
+{
+	struct rh_fixed_metadata_census census;
+
+	memset(&census, 0, sizeof(census));
+	census.kind = kind;
+	census.view = view;
+	census.coverage_ledger_format = RH_FIXED_METADATA_LEDGER_FORMAT;
+	census.generation = generation;
+	census.volume_serial = serial;
+	census.coverage_complete = 1;
+	census.identity_bound = 1;
+	census.no_io_uncertainty = 1;
+	census.target_runs_complete = 1;
+	census.target_ownership_exact = 1;
+	census.targets_outside_wal = 1;
+	census.mft_slots_expected = census.mft_slots_completed = 32;
+	census.attributes_expected = census.attributes_completed = 96;
+	census.extents_expected = census.extents_completed = 96;
+	census.runs_expected = census.runs_completed = 24;
+	tagged_hash("ledger", kind, view, serial, census.coverage_ledger_hash);
+	tagged_hash("raw-census", kind, view, serial, census.raw_census_hash);
+	tagged_hash("target-mapping", kind, view, serial,
+		census.target_mapping_hash);
+	tagged_hash("allocation-bitmap", kind, view, serial,
+		census.allocation_bitmap_hash);
+	tagged_hash("identity", kind, view, serial, census.identity_graph_hash);
+	if (kind == RH_FIXED_METADATA_UPCASE) {
+		census.namespace_links_expected = 18;
+		census.namespace_links_completed = 18;
+		census.namespace_links_reciprocal = 18;
+		census.indexes_expected = census.indexes_completed = 4;
+		census.index_blocks_allocated = 2;
+		census.index_blocks_reachable = 2;
+		census.index_blocks_examined = 2;
+		census.canonical_ordered_indexes = 4;
+		tagged_hash("namespace", kind, view, serial,
+			census.namespace_manifest_hash);
+		tagged_hash("indexes", kind, view, serial,
+			census.index_census_hash);
+	} else {
+		census.attribute_types_expected = 14;
+		census.attribute_types_examined = 14;
+		tagged_hash("type-use", kind, view, serial,
+			census.attribute_type_use_hash);
+	}
+	return rh_fixed_metadata_authority_seal(&census, authority);
+}
+
+static int incomplete_authorities_refused(
+		const struct rh_fixed_metadata_authority *valid)
+{
+	struct rh_fixed_metadata_census census;
+	struct rh_fixed_metadata_authority rejected;
+	int cases = 0;
+
+	census = valid->census;
+	census.coverage_ledger_format = 2;
+	if (!rh_fixed_metadata_authority_seal(&census, &rejected))
+		return -1;
+	cases++;
+	census = valid->census;
+	if (census.kind == RH_FIXED_METADATA_UPCASE) {
+		census.namespace_links_reciprocal--;
+		if (!rh_fixed_metadata_authority_seal(&census, &rejected))
+			return -1;
+		cases++;
+		census = valid->census;
+		census.canonical_ordered_indexes--;
+		if (!rh_fixed_metadata_authority_seal(&census, &rejected))
+			return -1;
+		cases++;
+	} else {
+		census.attribute_types_examined--;
+		if (!rh_fixed_metadata_authority_seal(&census, &rejected))
+			return -1;
+		cases++;
+		census = valid->census;
+		census.custom_attribute_types = 1;
+		if (!rh_fixed_metadata_authority_seal(&census, &rejected))
+			return -1;
+		cases++;
+		census = valid->census;
+		census.incompatible_attribute_bounds = 1;
+		if (!rh_fixed_metadata_authority_seal(&census, &rejected))
+			return -1;
+		cases++;
+	}
+	return cases == (valid->census.kind == RH_FIXED_METADATA_UPCASE ? 3 : 4) ?
+		0 : -1;
+}
+
+static void writer_pretransaction_view(const struct rh_writer *writer,
+		struct rh_writer *pre)
+{
+	*pre = *writer;
+	pre->write_fd = -1;
+	pre->operations = NULL;
+	pre->operation_count = 0;
+	pre->operation_capacity = 0;
+	pre->planned_bytes = 0;
+	pre->backend = NULL;
+	pre->backend_opaque = NULL;
+	pre->commit_started = 0;
+	pre->commit_completed = 0;
+}
+
+static int recovery_entries(const struct rh_writer *writer,
+		const struct rh_fixed_metadata_plan *plan,
+		struct rh_fixed_metadata_recovery_entry **entries_out)
+{
+	struct rh_fixed_metadata_recovery_entry *entries;
+	size_t i;
+
+	entries = calloc(plan->operation_count, sizeof(*entries));
+	if (!entries)
+		return -1;
+	for (i = 0; i < plan->operation_count; i++) {
+		const struct rh_write_operation *operation = &writer->operations[
+			plan->first_operation_ordinal - 1U + i];
+		entries[i].kind = operation->kind;
+		entries[i].target_offset = operation->offset;
+		entries[i].length = operation->length;
+		rh_sha256(operation->before, operation->length, entries[i].old_hash);
+		rh_sha256(operation->after, operation->length, entries[i].new_hash);
+		entries[i].target = operation->target;
+		entries[i].old_bytes = operation->before;
+	}
+	*entries_out = entries;
+	return 0;
+}
+
+static int negative_recovery_cases(struct rh_ntfs_overlay *pre_overlay,
+		struct rh_writer *pre_writer,
+		const struct rh_fixed_metadata_authority *pre_authority,
+		struct rh_ntfs_overlay *post_overlay, struct rh_writer *post_writer,
+		const struct rh_fixed_metadata_authority *post_authority,
+		const struct rh_fixed_metadata_recovery_entry *entries,
+		size_t entry_count)
+{
+	struct rh_fixed_metadata_recovery_entry *mutated;
+	int cases = 0;
+
+	mutated = malloc(entry_count * sizeof(*mutated));
+	if (!mutated)
+		return -1;
+#define EXPECT_REJECT(mutation) do { \
+	memcpy(mutated, entries, entry_count * sizeof(*mutated)); \
+	mutation; \
+	errno = 0; \
+	if (!rh_fixed_metadata_rederive_recovery(pre_overlay->volume, pre_writer, \
+		pre_authority, post_overlay->volume, post_writer, post_authority, \
+		mutated, entry_count, 1)) { \
+		free(mutated); \
+		return -1; \
+	} \
+	cases++; \
+} while (0)
+	EXPECT_REJECT(mutated[0].target_offset += 512U);
+	EXPECT_REJECT(mutated[0].new_hash[0] ^= 1U);
+	EXPECT_REJECT(mutated[0].length -= 512U);
+	EXPECT_REJECT(mutated[0].target.attribute_name_length = 1U);
+	EXPECT_REJECT(mutated[0].target.owner_mft_record += 1U);
+	EXPECT_REJECT(mutated[0].target.evidence_hash[0] ^= 1U);
+	EXPECT_REJECT(mutated[0].target.staged_view_hash[0] ^= 1U);
+#undef EXPECT_REJECT
+	free(mutated);
+	return cases == 7 ? 0 : -1;
+}
+
+static int partial_second_refusal_probe(const char *path,
+		const struct rh_fixed_metadata_authority *upcase_authority,
+		const struct rh_fixed_metadata_authority *attrdef_authority,
+		int first_corrupt)
+{
+	struct rh_writer writer;
+	struct rh_ntfs_overlay overlay;
+	struct rh_fixed_metadata_batch batch;
+	unsigned char zero[sizeof(batch)];
+	enum rh_fixed_metadata_stage_result stage_result =
+		RH_FIXED_METADATA_STAGE_ERROR;
+	int mounted = 0, result = -1;
+
+	memset(&overlay, 0, sizeof(overlay));
+	memset(&batch, 0xa5, sizeof(batch));
+	memset(zero, 0, sizeof(zero));
+	if (rh_writer_open(&writer, path))
+		return -1;
+	if (rh_ntfs_overlay_mount_fixed_metadata_bootstrap(&overlay, &writer, 0))
+		goto out;
+	mounted = 1;
+	if (setenv("ROOTHEALTH_FIXED_METADATA_TEST_REFUSE_SECOND", "1", 1))
+		goto out;
+	stage_result = rh_fixed_metadata_stage_batch(&overlay, upcase_authority,
+		attrdef_authority, &batch);
+	unsetenv("ROOTHEALTH_FIXED_METADATA_TEST_REFUSE_SECOND");
+	if (stage_result != RH_FIXED_METADATA_STAGE_REFUSED ||
+			writer.operation_count || writer.write_boundaries ||
+			overlay.fixed_metadata_examined_mask ||
+			overlay.fixed_metadata_abort_examined_mask != 0x1U ||
+			!!overlay.fixed_metadata_abort_discarded_operations !=
+				!!first_corrupt || memcmp(&batch, zero, sizeof(batch)))
+		goto out;
+	result = 0;
+out:
+	unsetenv("ROOTHEALTH_FIXED_METADATA_TEST_REFUSE_SECOND");
+	if (mounted)
+		rh_ntfs_overlay_unmount(&overlay);
+	rh_writer_close(&writer);
+	return result;
+}
+
+int main(int argc, char **argv)
+{
+	struct rh_writer writer, pre_writer;
+	struct rh_ntfs_overlay overlay, pre_overlay;
+	struct rh_fixed_metadata_inspection upcase_inspection, attrdef_inspection;
+	struct rh_fixed_metadata_authority pre_upcase, pre_attrdef;
+	struct rh_fixed_metadata_authority post_upcase, post_attrdef, tampered;
+	struct rh_fixed_metadata_batch batch, probe_batch;
+	struct rh_fixed_metadata_recovery_entry *upcase_entries = NULL;
+	struct rh_fixed_metadata_recovery_entry *attrdef_entries = NULL;
+	const struct rh_policy_definition *definition;
+	enum rh_fixed_metadata_stage_result stage_result;
+	uint64_t generation = 7;
+	int mounted = 0, pre_mounted = 0, writer_opened = 0;
+	int expect_upcase_corrupt = 0;
+	int expect_attrdef_corrupt = 0, flagless_expected, flagless_mounted = 0;
+	int recovery_negatives = 0, result = 1;
+	const char *failure = "arguments";
+
+	memset(&upcase_inspection, 0, sizeof(upcase_inspection));
+	memset(&attrdef_inspection, 0, sizeof(attrdef_inspection));
+	memset(&overlay, 0, sizeof(overlay));
+	memset(&pre_overlay, 0, sizeof(pre_overlay));
+	if (argc != 5)
+		return 5;
+	if (!strcmp(argv[3], "corrupt")) {
+		expect_upcase_corrupt = !strcmp(argv[2], "upcase") ||
+			!strcmp(argv[2], "both");
+		expect_attrdef_corrupt = !strcmp(argv[2], "attrdef") ||
+			!strcmp(argv[2], "both");
+		if (!expect_upcase_corrupt && !expect_attrdef_corrupt)
+			return 5;
+	} else if (strcmp(argv[3], "clean") ||
+			(strcmp(argv[2], "upcase") && strcmp(argv[2], "attrdef")))
+		return 5;
+	if (!strcmp(argv[4], "flagless-success"))
+		flagless_expected = 1;
+	else if (!strcmp(argv[4], "flagless-fail"))
+		flagless_expected = 0;
+	else if (!strcmp(argv[4], "flagless-any"))
+		flagless_expected = -1;
+	else
+		return 5;
+	if (strcmp(rh_fixed_metadata_check_id(RH_FIXED_METADATA_UPCASE),
+			RH_FIXED_METADATA_UPCASE_CHECK_ID) ||
+			strcmp(rh_fixed_metadata_check_id(RH_FIXED_METADATA_ATTRDEF),
+				RH_FIXED_METADATA_ATTRDEF_CHECK_ID))
+		return 1;
+	definition = rh_policy_problem(PR_UPCASE_CORRUPTED);
+	if (!definition || rh_policy_implementation(definition))
+		return 1;
+	definition = rh_policy_problem(PR_ATTRDEF_CORRUPTED);
+	if (!definition || rh_policy_implementation(definition))
+		return 1;
+	if (rh_writer_open(&writer, argv[1]))
+		return 3;
+	writer_opened = 1;
+	failure = "flagless-or-bootstrap";
+	if (flagless_mount_probe(&writer, flagless_expected, &flagless_mounted) ||
+			rh_ntfs_overlay_mount_fixed_metadata_bootstrap(&overlay,
+				&writer, 0))
+		goto out_writer;
+	mounted = 1;
+	failure = "raw-inspection-or-authority";
+	if (rh_fixed_metadata_inspect(overlay.volume, &writer,
+			RH_FIXED_METADATA_UPCASE, &upcase_inspection) ||
+			rh_fixed_metadata_inspect(overlay.volume, &writer,
+				RH_FIXED_METADATA_ATTRDEF, &attrdef_inspection) ||
+			upcase_inspection.canonical == expect_upcase_corrupt ||
+			attrdef_inspection.canonical == expect_attrdef_corrupt ||
+			upcase_inspection.volume_serial != attrdef_inspection.volume_serial ||
+			make_authority(RH_FIXED_METADATA_UPCASE,
+				RH_FIXED_METADATA_PRETRANSACTION, generation,
+				upcase_inspection.volume_serial, &pre_upcase) ||
+			make_authority(RH_FIXED_METADATA_ATTRDEF,
+				RH_FIXED_METADATA_PRETRANSACTION, generation,
+				attrdef_inspection.volume_serial, &pre_attrdef) ||
+			incomplete_authorities_refused(&pre_upcase) ||
+			incomplete_authorities_refused(&pre_attrdef))
+		goto out;
+	rh_fixed_metadata_inspection_destroy(&upcase_inspection);
+	rh_fixed_metadata_inspection_destroy(&attrdef_inspection);
+	rh_ntfs_overlay_unmount(&overlay);
+	mounted = 0;
+	rh_writer_close(&writer);
+	writer_opened = 0;
+	if (partial_second_refusal_probe(argv[1], &pre_upcase, &pre_attrdef,
+			expect_upcase_corrupt) || rh_writer_open(&writer, argv[1]))
+		goto out;
+	writer_opened = 1;
+	if (rh_ntfs_overlay_mount_fixed_metadata_bootstrap(&overlay, &writer, 0))
+		goto out;
+	mounted = 1;
+	failure = "reopened-raw-inspection";
+	if (rh_fixed_metadata_inspect(overlay.volume, &writer,
+			RH_FIXED_METADATA_UPCASE, &upcase_inspection) ||
+			rh_fixed_metadata_inspect(overlay.volume, &writer,
+				RH_FIXED_METADATA_ATTRDEF, &attrdef_inspection))
+		goto out;
+	rh_fixed_metadata_inspection_destroy(&upcase_inspection);
+	rh_fixed_metadata_inspection_destroy(&attrdef_inspection);
+	failure = "missing-authority-probe";
+	stage_result = rh_fixed_metadata_stage_batch(&overlay, NULL, &pre_attrdef,
+		&probe_batch);
+	if (stage_result != RH_FIXED_METADATA_STAGE_REFUSED ||
+			writer.operation_count || overlay.fixed_metadata_examined_mask)
+		goto out;
+	tampered = pre_upcase;
+	tampered.seal[0] ^= 1U;
+	failure = "tampered-authority-probe";
+	stage_result = rh_fixed_metadata_stage_batch(&overlay, &tampered,
+		&pre_attrdef, &probe_batch);
+	if (stage_result != RH_FIXED_METADATA_STAGE_REFUSED ||
+			writer.operation_count || overlay.fixed_metadata_examined_mask)
+		goto out;
+	failure = "batch-stage-or-finalize";
+	stage_result = rh_fixed_metadata_stage_batch(&overlay, &pre_upcase,
+		&pre_attrdef, &batch);
+	if (stage_result != (expect_upcase_corrupt || expect_attrdef_corrupt ?
+			RH_FIXED_METADATA_STAGE_PLANNED : RH_FIXED_METADATA_STAGE_CLEAN) ||
+			!batch.staged || overlay.fixed_metadata_startup_only ||
+			batch.upcase.clean == expect_upcase_corrupt ||
+			batch.attrdef.clean == expect_attrdef_corrupt ||
+			writer.write_boundaries ||
+			make_authority(RH_FIXED_METADATA_UPCASE, RH_FIXED_METADATA_STAGED,
+				generation, batch.upcase.volume_serial, &post_upcase) ||
+			make_authority(RH_FIXED_METADATA_ATTRDEF, RH_FIXED_METADATA_STAGED,
+				generation, batch.attrdef.volume_serial, &post_attrdef) ||
+			rh_fixed_metadata_verify_finalize_batch(&overlay, &post_upcase,
+				&post_attrdef, &batch) || !batch.finalized ||
+			writer.write_boundaries)
+		goto out;
+	if (!expect_upcase_corrupt && !expect_attrdef_corrupt) {
+		if (writer.operation_count)
+			goto out;
+		printf("fixed-metadata-clean actions=20,21 operations=0 "
+			"checks=system.upcase,system.attrdef flagless_mount_unchanged=1 "
+			"raw_batch=2 ordinary_full_remount=1 source_writes=0 "
+			"first_clean_second_refused_aborted=1 "
+			"missing_authority_refused=1 tampered_authority_refused=1 "
+			"incomplete_census_refused=2 policy_closed=1\n");
+		result = 0;
+		goto out;
+	}
+	failure = "whole-stream-operation-shape";
+	if ((expect_upcase_corrupt &&
+			(batch.upcase.operation_count != 1U ||
+			 writer.operations[batch.upcase.first_operation_ordinal - 1U].length !=
+				RH_UPCASE_CANONICAL_SIZE ||
+			 writer.operations[batch.upcase.first_operation_ordinal - 1U].
+				target.logical_offset ||
+			 writer.operations[batch.upcase.first_operation_ordinal - 1U].
+				target.logical_length != RH_UPCASE_CANONICAL_SIZE)) ||
+			(expect_attrdef_corrupt &&
+			(batch.attrdef.operation_count != 1U ||
+			 writer.operations[batch.attrdef.first_operation_ordinal - 1U].length !=
+				RH_ATTRDEF_CANONICAL_SIZE ||
+			 writer.operations[batch.attrdef.first_operation_ordinal - 1U].
+				target.logical_offset ||
+			 writer.operations[batch.attrdef.first_operation_ordinal - 1U].
+				target.logical_length != RH_ATTRDEF_CANONICAL_SIZE)))
+		goto out;
+	failure = "recovery-entry-build";
+	if ((expect_upcase_corrupt && (!batch.upcase.operation_count ||
+			recovery_entries(&writer, &batch.upcase, &upcase_entries))) ||
+			(expect_attrdef_corrupt && (!batch.attrdef.operation_count ||
+			recovery_entries(&writer, &batch.attrdef, &attrdef_entries))))
+		goto out;
+	writer_pretransaction_view(&writer, &pre_writer);
+	failure = "recovery-bootstrap";
+	if (rh_ntfs_overlay_mount_fixed_metadata_bootstrap(&pre_overlay,
+			&pre_writer, 0))
+		goto out;
+	pre_mounted = 1;
+	failure = "recovery-rederivation";
+#define CHECK_RECOVERY(plan, entries, pre_auth, post_auth) do { \
+	if (rh_fixed_metadata_rederive_recovery(pre_overlay.volume, &pre_writer, \
+		&(pre_auth), overlay.volume, &writer, &(post_auth), (entries), \
+		(plan).operation_count, 0) || \
+		rh_fixed_metadata_rederive_recovery(pre_overlay.volume, &pre_writer, \
+			&(pre_auth), overlay.volume, &writer, &(post_auth), (entries), \
+			(plan).operation_count, 1) || \
+		negative_recovery_cases(&pre_overlay, &pre_writer, &(pre_auth), \
+			&overlay, &writer, &(post_auth), (entries), \
+			(plan).operation_count)) \
+		goto out; \
+	recovery_negatives += 7; \
+} while (0)
+	if (expect_upcase_corrupt)
+		CHECK_RECOVERY(batch.upcase, upcase_entries, pre_upcase, post_upcase);
+	if (expect_attrdef_corrupt)
+		CHECK_RECOVERY(batch.attrdef, attrdef_entries, pre_attrdef, post_attrdef);
+#undef CHECK_RECOVERY
+	printf("fixed-metadata-plan actions=20,21 operations=%zu "
+		"checks=system.upcase,system.attrdef corrupt_upcase=%d "
+		"corrupt_attrdef=%d flagless_mounted=%d raw_batch=2 "
+		"staged_overlay_only=1 source_writes=%zu ordinary_full_remount=1 "
+		"first_%s_second_refused_aborted=1 "
+		"preparing_rederived=1 committed_rederived=1 recovery_negatives=%d "
+		"missing_authority_refused=1 tampered_authority_refused=1 "
+		"incomplete_census_refused=2 policy_closed=1\n",
+		writer.operation_count, expect_upcase_corrupt, expect_attrdef_corrupt,
+		flagless_mounted, writer.write_boundaries,
+		expect_upcase_corrupt ? "corrupt" : "clean", recovery_negatives);
+	result = 0;
+out:
+	if (result)
+		fprintf(stderr, "fixed-metadata-test-failure step=%s errno=%d "
+			"stage_result=%d operations=%zu examined=%u startup=%d failed=%d "
+			"batch_checkpoint=%zu writer_checkpoint=%zu abort_mask=%u "
+			"abort_ops=%zu\n", failure,
+			errno, (int)stage_result, writer.operation_count,
+			overlay.fixed_metadata_examined_mask,
+			overlay.fixed_metadata_startup_only, overlay.failed,
+			overlay.fixed_metadata_batch_checkpoint,
+			rh_writer_plan_checkpoint(&writer),
+			overlay.fixed_metadata_abort_examined_mask,
+			overlay.fixed_metadata_abort_discarded_operations);
+	free(attrdef_entries);
+	free(upcase_entries);
+	rh_fixed_metadata_inspection_destroy(&attrdef_inspection);
+	rh_fixed_metadata_inspection_destroy(&upcase_inspection);
+	if (pre_mounted)
+		rh_ntfs_overlay_unmount(&pre_overlay);
+	if (mounted)
+		rh_ntfs_overlay_unmount(&overlay);
+out_writer:
+	if (writer_opened)
+		rh_writer_close(&writer);
+	return result;
+}
diff --git a/tests/roothealth_fixed_metadata_qualification.sh b/tests/roothealth_fixed_metadata_qualification.sh
new file mode 100755
index 0000000000000000000000000000000000000000..21c025c0d4ccf2334eb3f03c781420d03dbe29c5
--- /dev/null
+++ b/tests/roothealth_fixed_metadata_qualification.sh
@@ -0,0 +1,103 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+top=$(cd "$(dirname "$0")/.." && pwd)
+scratch=$(mktemp -d /var/tmp/roothealth-fixed-metadata-qualification.XXXXXX)
+trap 'case "$scratch" in /var/tmp/roothealth-fixed-metadata-qualification.*) rm -rf -- "$scratch";; esac' EXIT
+
+common=(
+	-std=gnu11 -DHAVE_CONFIG_H -D_GNU_SOURCE
+	-DROOTHEALTH_REPAIR_TESTING
+	-I"$top" -I"$top/include" -I"$top/src" -I"$top/libntfs"
+	-Wall -Wextra -Werror -Wno-address-of-packed-member -fno-common
+)
+strict="$scratch/strict"
+san="$scratch/san"
+mkdir -p "$strict" "$san"
+
+make -C "$top/libntfs" libntfs.la >/dev/null
+
+gcc "${common[@]}" -c "$top/src/roothealth_fixed_metadata.c" -o "$strict/fixed.o"
+gcc "${common[@]}" -c "$top/src/roothealth_write.c" -o "$strict/write.o"
+gcc "${common[@]}" -c "$top/src/roothealth_overlay.c" -o "$strict/overlay.o"
+gcc "${common[@]}" -c "$top/src/roothealth_policy.c" -o "$strict/policy.o"
+gcc "${common[@]}" -c "$top/src/roothealth_coverage.c" -o "$strict/coverage.o"
+gcc "${common[@]}" -c "$top/src/attrdef.c" -o "$strict/attrdef.o"
+gcc "${common[@]}" -c "$top/tests/roothealth_fixed_metadata_mutate.c" \
+	-o "$strict/mutate.o"
+gcc "${common[@]}" -c "$top/tests/roothealth_fixed_metadata_plan.c" \
+	-o "$strict/plan.o"
+gcc -o "$strict/mutate" "$strict/mutate.o" "$strict/fixed.o" \
+	"$strict/overlay.o" "$strict/write.o" "$strict/attrdef.o" \
+	"$strict/coverage.o" \
+	"$top/libntfs/.libs/libntfs.a"
+gcc -o "$strict/plan" "$strict/plan.o" "$strict/fixed.o" \
+	"$strict/overlay.o" "$strict/write.o" "$strict/policy.o" \
+	"$strict/attrdef.o" "$strict/coverage.o" "$top/libntfs/.libs/libntfs.a"
+
+truncate -s 64M "$scratch/base.ntfs"
+"$top/src/mkntfs" -F -q -s 512 -c 4096 -L T1OS \
+	"$scratch/base.ntfs" >/dev/null
+upcase_hash=$("$top/src/ntfscat" -f -i 10 "$scratch/base.ntfs" | sha256sum | cut -d' ' -f1)
+attrdef_hash=$("$top/src/ntfscat" -f -i 4 "$scratch/base.ntfs" | sha256sum | cut -d' ' -f1)
+upcase_size=$("$top/src/ntfscat" -f -i 10 "$scratch/base.ntfs" | wc -c)
+attrdef_size=$("$top/src/ntfscat" -f -i 4 "$scratch/base.ntfs" | wc -c)
+test "$upcase_hash" = 41c26bc7a12bdaeb26025c93118697c7e3ef81ee048b00fe5cce2a472e0e0742
+test "$attrdef_hash" = d7de5b1b2f79f45f235ceb1adbc46908ed64eae174eb90ed66aefe5f25165da3
+test "$upcase_size" -eq 131072
+test "$attrdef_size" -eq 2560
+
+sha256sum "$scratch/base.ntfs" >"$scratch/base.sha256"
+"$strict/plan" "$scratch/base.ntfs" upcase clean flagless-success
+"$strict/plan" "$scratch/base.ntfs" attrdef clean flagless-success
+(cd "$scratch" && sha256sum -c base.sha256 >/dev/null)
+
+run_corrupt_plan() {
+	local name=$1 mutation=$2 kind=$3 flagless=$4
+	cp --reflink=auto "$scratch/base.ntfs" "$scratch/$name.ntfs"
+	"$strict/mutate" "$scratch/$name.ntfs" "$mutation"
+	sha256sum "$scratch/$name.ntfs" >"$scratch/$name.sha256"
+	"$strict/plan" "$scratch/$name.ntfs" "$kind" corrupt "$flagless"
+	(cd "$scratch" && sha256sum -c "$name.sha256" >/dev/null)
+}
+
+run_corrupt_plan upcase-tail upcase-tail upcase flagless-any
+run_corrupt_plan upcase-ascii upcase-ascii upcase flagless-fail
+run_corrupt_plan attrdef-tail attrdef attrdef flagless-any
+run_corrupt_plan attrdef-structural attrdef-structural attrdef flagless-any
+
+cp --reflink=auto "$scratch/base.ntfs" "$scratch/both-corrupt.ntfs"
+"$strict/mutate" "$scratch/both-corrupt.ntfs" attrdef-structural
+"$strict/mutate" "$scratch/both-corrupt.ntfs" upcase-ascii
+sha256sum "$scratch/both-corrupt.ntfs" >"$scratch/both-corrupt.sha256"
+"$strict/plan" "$scratch/both-corrupt.ntfs" both corrupt flagless-fail
+(cd "$scratch" && sha256sum -c both-corrupt.sha256 >/dev/null)
+
+# shellcheck disable=SC2054 # comma belongs to GCC's sanitizer option
+sanflags=(-g3 -O1 -fno-omit-frame-pointer -fsanitize=address,undefined)
+for source in roothealth_fixed_metadata roothealth_write roothealth_overlay roothealth_policy roothealth_coverage; do
+	gcc "${common[@]}" "${sanflags[@]}" -c "$top/src/$source.c" \
+		-o "$san/$source.o"
+done
+gcc "${common[@]}" "${sanflags[@]}" -c "$top/src/attrdef.c" \
+	-o "$san/attrdef.o"
+gcc "${common[@]}" "${sanflags[@]}" \
+	-c "$top/tests/roothealth_fixed_metadata_plan.c" -o "$san/plan.o"
+gcc "${sanflags[@]}" -o "$san/plan" "$san/plan.o" \
+	"$san/roothealth_fixed_metadata.o" "$san/roothealth_overlay.o" \
+	"$san/roothealth_write.o" "$san/roothealth_policy.o" \
+	"$san/roothealth_coverage.o" "$san/attrdef.o" \
+	"$top/libntfs/.libs/libntfs.a"
+ASAN_OPTIONS=detect_leaks=1:abort_on_error=1 \
+UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
+	"$san/plan" "$scratch/upcase-ascii.ntfs" upcase corrupt flagless-fail
+ASAN_OPTIONS=detect_leaks=1:abort_on_error=1 \
+UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
+	"$san/plan" "$scratch/attrdef-structural.ntfs" attrdef corrupt flagless-any
+ASAN_OPTIONS=detect_leaks=1:abort_on_error=1 \
+UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
+	"$san/plan" "$scratch/both-corrupt.ntfs" both corrupt flagless-fail
+
+printf 'fixed-metadata-qualification canonical=2 fixed_checks=2 clean_noop=2 '
+printf 'corrupt_plans=5 both_corrupt=1 no_write_probes=7 '
+printf 'recovery_negative_cases=42 werror=1 asan_ubsan=1 passed=1\n'
