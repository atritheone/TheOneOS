+	unsigned int bit = rh_overlay_fixed_metadata_bit(kind);
+
+	if (!overlay || !overlay->volume || !overlay->fixed_metadata_startup_only ||
+			overlay->action_active || overlay->failed || !bit ||
+			(overlay->fixed_metadata_examined_mask & bit) ||
+			overlay->writer->operation_count <
+				overlay->fixed_metadata_batch_checkpoint) {
+		errno = EPERM;
+		return -1;
+	}
+	overlay->fixed_metadata_examined_mask |= bit;
+	return 0;
+}
+
+int rh_ntfs_overlay_finish_fixed_metadata_bootstrap(
+		struct rh_ntfs_overlay *overlay)
+{
+	if (!overlay || !overlay->volume || !overlay->writer ||
+			!overlay->fixed_metadata_startup_only || overlay->action_active ||
+			overlay->failed || overlay->fixed_metadata_examined_mask !=
+				RH_FIXED_METADATA_ALL_BITS ||
+			overlay->writer->operation_count <
+				overlay->fixed_metadata_batch_checkpoint) {
+		errno = EPERM;
+		return -1;
+	}
+	ntfs_device_roothealth_remove_plan_write(overlay->volume->dev);
+	/*
+	 * ntfs_umount() always destroys a startup volume and its device, but the
+	 * pinned implementation can report EINVAL for fields intentionally never
+	 * loaded by ntfs_volume_startup().  This read-only private teardown has no
+	 * dirty state, so the diagnostic return is not a persistence failure.
+	 */
+	(void)ntfs_umount(overlay->volume, TRUE);
+	overlay->volume = NULL;
+	overlay->device = NULL;
+	overlay->fixed_metadata_startup_only = 0;
+	if (!rh_ntfs_overlay_mount_device(overlay))
+		return 0;
+	if (rh_writer_discard_after(overlay->writer,
+			overlay->fixed_metadata_batch_checkpoint))
+		overlay->failed = 1;
+	overlay->fixed_metadata_examined_mask = 0;
+	overlay->planned_calls[RH_WRITE_UPCASE_DATA] = 0;
+	overlay->planned_calls[RH_WRITE_ATTRDEF_DATA] = 0;
+	overlay->failed = 1;
+	errno = EIO;
+	return -1;
+}
+
+int rh_ntfs_overlay_abort_fixed_metadata_bootstrap(
+		struct rh_ntfs_overlay *overlay)
+{
+	size_t discarded;
+
+	if (!overlay || !overlay->writer || !overlay->fixed_metadata_startup_only ||
+			overlay->action_active || overlay->writer->operation_count <
+				overlay->fixed_metadata_batch_checkpoint) {
+		errno = EINVAL;
+		return -1;
+	}
+	discarded = overlay->writer->operation_count -
+		overlay->fixed_metadata_batch_checkpoint;
+	overlay->fixed_metadata_abort_examined_mask =
+		overlay->fixed_metadata_examined_mask;
+	overlay->fixed_metadata_abort_discarded_operations = discarded;
+	if (rh_writer_discard_after(overlay->writer,
+			overlay->fixed_metadata_batch_checkpoint)) {
+		overlay->failed = 1;
+		return -1;
+	}
+	overlay->fixed_metadata_examined_mask = 0;
+	overlay->planned_calls[RH_WRITE_UPCASE_DATA] = 0;
+	overlay->planned_calls[RH_WRITE_ATTRDEF_DATA] = 0;
+	return 0;
+}
+
 int rh_ntfs_overlay_run_action(struct rh_ntfs_overlay *overlay,
 		const struct rh_overlay_action_expectation *expectation,
 		rh_overlay_action_fn action, void *opaque)
