index 0000000000000000000000000000000000000000..7f9532f51d8d9504b6f7b9fc83ecb938bf0d9bfa
--- /dev/null
+++ b/src/roothealth_fixed_metadata.c
@@ -0,0 +1,1631 @@
+/* ROOTHEALTH_REPAIR_ROLE(DIAGNOSTIC) ROOTHEALTH_IO_ROLE(PLANNER) */
+#include "config.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "attrib.h"
+#include "attrdef.h"
+#include "device.h"
+#include "endians.h"
+#include "inode.h"
+#include "layout.h"
+#include "roothealth_bitmap.h"
+#include "roothealth_coverage.h"
+#include "roothealth_fixed_metadata.h"
+#include "roothealth_namespace.h"
+#include "roothealth_raw_mft.h"
+#include "runlist.h"
+#include "unistr.h"
+
+#define RH_FIXED_MAX_VOLUME_BYTES (UINT64_C(256) * 1024U * 1024U * 1024U)
+#define RH_FIXED_AUTH_ENCODED_BYTES 536U
+#define RH_FIXED_MAPPING_HEADER_BYTES 80U
+#define RH_FIXED_MAPPING_SLICE_BYTES 40U
+
+/* ntfs-next d4f481d inputs, checked again by their normative output digests. */
+static const char rh_upcase_source[] =
+	"ntfs-next:d4f481d:libntfs/unistr.c:ntfs_upcase_build_default";
+static const char rh_attrdef_source[] =
+	"ntfs-next:d4f481d:src/attrdef.c:attrdef_ntfs3x_array";
+
+struct rh_fixed_stage_context {
+	const struct rh_fixed_metadata_inspection *inspection;
+	const unsigned char *canonical;
+	const size_t *changed;
+	size_t changed_count;
+};
+
+const char *rh_fixed_metadata_check_id(enum rh_fixed_metadata_kind kind)
+{
+	if (kind == RH_FIXED_METADATA_UPCASE)
+		return RH_FIXED_METADATA_UPCASE_CHECK_ID;
+	if (kind == RH_FIXED_METADATA_ATTRDEF)
+		return RH_FIXED_METADATA_ATTRDEF_CHECK_ID;
+	return NULL;
+}
+
+static int rh_fixed_all_zero(const unsigned char *bytes, size_t length)
+{
+	size_t i;
+
+	for (i = 0; i < length; i++)
+		if (bytes[i])
+			return 0;
+	return 1;
+}
+
+static int rh_fixed_bool(int value)
+{
+	return value == 0 || value == 1;
+}
+
+static void rh_fixed_put_u16(unsigned char *out, uint16_t value)
+{
+	out[0] = (unsigned char)value;
+	out[1] = (unsigned char)(value >> 8);
+}
+
+static void rh_fixed_put_u32(unsigned char *out, uint32_t value)
+{
+	out[0] = (unsigned char)value;
+	out[1] = (unsigned char)(value >> 8);
+	out[2] = (unsigned char)(value >> 16);
+	out[3] = (unsigned char)(value >> 24);
+}
+
+static void rh_fixed_put_u64(unsigned char *out, uint64_t value)
+{
+	unsigned int i;
+
+	for (i = 0; i < 8U; i++)
+		out[i] = (unsigned char)(value >> (i * 8U));
+}
+
+static uint64_t rh_fixed_record(enum rh_fixed_metadata_kind kind)
+{
+	if (kind == RH_FIXED_METADATA_UPCASE)
+		return FILE_UpCase;
+	if (kind == RH_FIXED_METADATA_ATTRDEF)
+		return FILE_AttrDef;
+	return UINT64_MAX;
+}
+
+static enum rh_write_kind rh_fixed_write_kind(
+		enum rh_fixed_metadata_kind kind)
+{
+	return kind == RH_FIXED_METADATA_UPCASE ? RH_WRITE_UPCASE_DATA :
+		RH_WRITE_ATTRDEF_DATA;
+}
+
+static uint64_t rh_fixed_canonical_size(enum rh_fixed_metadata_kind kind)
+{
+	if (kind == RH_FIXED_METADATA_UPCASE)
+		return RH_UPCASE_CANONICAL_SIZE;
+	if (kind == RH_FIXED_METADATA_ATTRDEF)
+		return RH_ATTRDEF_CANONICAL_SIZE;
+	return 0;
+}
+
+static const char *rh_fixed_canonical_hex(enum rh_fixed_metadata_kind kind)
+{
+	if (kind == RH_FIXED_METADATA_UPCASE)
+		return RH_UPCASE_CANONICAL_SHA256;
+	if (kind == RH_FIXED_METADATA_ATTRDEF)
+		return RH_ATTRDEF_CANONICAL_SHA256;
+	return NULL;
+}
+
+int rh_fixed_metadata_canonical_build(enum rh_fixed_metadata_kind kind,
+		unsigned char **bytes, size_t *length, unsigned char hash[32])
+{
+	unsigned char *result = NULL;
+	char actual_hex[65];
+	size_t expected;
+
+	if (!bytes || !length || !hash || !rh_fixed_canonical_hex(kind)) {
+		errno = EINVAL;
+		return -1;
+	}
+	*bytes = NULL;
+	*length = 0;
+	expected = (size_t)rh_fixed_canonical_size(kind);
+	if (kind == RH_FIXED_METADATA_UPCASE) {
+		ntfschar *upcase = NULL;
+		u32 count = ntfs_upcase_build_default(&upcase);
+
+		if (count != RH_UPCASE_CANONICAL_SIZE / sizeof(*upcase) || !upcase) {
+			free(upcase);
+			errno = EIO;
+			return -1;
+		}
+		result = (unsigned char *)upcase;
+	} else {
+		result = malloc(expected);
+		if (!result)
+			return -1;
+		memcpy(result, attrdef_ntfs3x_array, expected);
+	}
+	rh_sha256(result, expected, hash);
+	rh_sha256_hex(result, expected, actual_hex);
+	if (strcmp(actual_hex, rh_fixed_canonical_hex(kind))) {
+		memset(result, 0, expected);
+		free(result);
+		errno = EILSEQ;
+		return -1;
+	}
+	*bytes = result;
+	*length = expected;
+	return 0;
+}
+
+static int rh_fixed_census_common_valid(
+		const struct rh_fixed_metadata_census *census)
+{
+	return census && census->coverage_ledger_format ==
+		RH_FIXED_METADATA_LEDGER_FORMAT && census->generation &&
+		census->volume_serial &&
+		rh_fixed_bool(census->coverage_complete) && census->coverage_complete &&
+		rh_fixed_bool(census->identity_bound) && census->identity_bound &&
+		rh_fixed_bool(census->no_io_uncertainty) &&
+		census->no_io_uncertainty &&
+		rh_fixed_bool(census->target_runs_complete) &&
+		census->target_runs_complete &&
+		rh_fixed_bool(census->target_ownership_exact) &&
+		census->target_ownership_exact &&
+		rh_fixed_bool(census->targets_outside_wal) &&
+		census->targets_outside_wal && census->mft_slots_expected &&
+		census->mft_slots_completed == census->mft_slots_expected &&
+		census->attributes_expected &&
+		census->attributes_completed == census->attributes_expected &&
+		census->extents_completed == census->extents_expected &&
+		census->runs_expected && census->runs_completed == census->runs_expected &&
+		!rh_fixed_all_zero(census->coverage_ledger_hash, 32) &&
+		!rh_fixed_all_zero(census->raw_census_hash, 32) &&
+		!rh_fixed_all_zero(census->target_mapping_hash, 32) &&
+		!rh_fixed_all_zero(census->allocation_bitmap_hash, 32) &&
+		!rh_fixed_all_zero(census->identity_graph_hash, 32);
+}
+
+static int rh_fixed_census_kind_valid(
+		const struct rh_fixed_metadata_census *census)
+{
+	if (!rh_fixed_census_common_valid(census))
+		return 0;
+	if (census->kind == RH_FIXED_METADATA_UPCASE)
+		return census->namespace_links_expected &&
+			census->namespace_links_completed ==
+				census->namespace_links_expected &&
+			census->namespace_links_reciprocal ==
+				census->namespace_links_expected &&
+			!census->namespace_links_unresolved &&
+			census->indexes_expected &&
+			census->indexes_completed == census->indexes_expected &&
+			census->index_blocks_allocated ==
+				census->index_blocks_reachable &&
+			census->index_blocks_reachable ==
+				census->index_blocks_examined &&
+			!census->index_blocks_unreadable &&
+			census->canonical_ordered_indexes == census->indexes_expected &&
+			!census->incompatible_collations &&
+			!rh_fixed_all_zero(census->namespace_manifest_hash, 32) &&
+			!rh_fixed_all_zero(census->index_census_hash, 32);
+	if (census->kind == RH_FIXED_METADATA_ATTRDEF)
+		return census->attribute_types_expected &&
+			census->attribute_types_examined ==
+				census->attribute_types_expected &&
+			!census->custom_attribute_types &&
+			!census->incompatible_attribute_bounds &&
+			!rh_fixed_all_zero(census->attribute_type_use_hash, 32);
+	return 0;
+}
+
+static void rh_fixed_authority_encode(
+		const struct rh_fixed_metadata_census *census,
+		unsigned char output[RH_FIXED_AUTH_ENCODED_BYTES])
+{
+	uint64_t counters[] = {
+		(uint64_t)census->coverage_ledger_format,
+		census->generation, census->volume_serial,
+		(uint64_t)census->coverage_complete,
+		(uint64_t)census->identity_bound,
+		(uint64_t)census->no_io_uncertainty,
+		(uint64_t)census->target_runs_complete,
+		(uint64_t)census->target_ownership_exact,
+		(uint64_t)census->targets_outside_wal,
+		census->mft_slots_expected, census->mft_slots_completed,
+		census->attributes_expected, census->attributes_completed,
+		census->extents_expected, census->extents_completed,
+		census->runs_expected, census->runs_completed,
+		census->namespace_links_expected,
+		census->namespace_links_completed,
+		census->namespace_links_reciprocal,
+		census->namespace_links_unresolved,
+		census->indexes_expected, census->indexes_completed,
+		census->index_blocks_allocated,
+		census->index_blocks_reachable,
+		census->index_blocks_examined,
+		census->index_blocks_unreadable,
+		census->canonical_ordered_indexes,
+		census->incompatible_collations,
+		census->attribute_types_expected,
+		census->attribute_types_examined,
+		census->custom_attribute_types,
+		census->incompatible_attribute_bounds,
+	};
+	size_t cursor = 16U, i;
+
+	memset(output, 0, RH_FIXED_AUTH_ENCODED_BYTES);
+	memcpy(output, "RHFIXAUTH1", 10);
+	rh_fixed_put_u32(output + 10, RH_FIXED_METADATA_AUTHORITY_VERSION);
+	output[14] = (unsigned char)census->kind;
+	output[15] = (unsigned char)census->view;
+	for (i = 0; i < sizeof(counters) / sizeof(counters[0]); i++) {
+		rh_fixed_put_u64(output + cursor, counters[i]);
+		cursor += 8U;
+	}
+	memcpy(output + cursor, census->coverage_ledger_hash, 32);
+	cursor += 32U;
+	memcpy(output + cursor, census->raw_census_hash, 32);
+	cursor += 32U;
+	memcpy(output + cursor, census->target_mapping_hash, 32);
+	cursor += 32U;
+	memcpy(output + cursor, census->allocation_bitmap_hash, 32);
+	cursor += 32U;
+	memcpy(output + cursor, census->identity_graph_hash, 32);
+	cursor += 32U;
+	memcpy(output + cursor, census->namespace_manifest_hash, 32);
+	cursor += 32U;
+	memcpy(output + cursor, census->index_census_hash, 32);
+	cursor += 32U;
+	memcpy(output + cursor, census->attribute_type_use_hash, 32);
+}
+
+static int rh_fixed_metadata_authority_seal_validated(
+		const struct rh_fixed_metadata_census *census,
+		struct rh_fixed_metadata_authority *authority)
+{
+	unsigned char encoded[RH_FIXED_AUTH_ENCODED_BYTES];
+
+	if (!authority || !rh_fixed_census_kind_valid(census) ||
+			(census->view != RH_FIXED_METADATA_PRETRANSACTION &&
+			 census->view != RH_FIXED_METADATA_STAGED)) {
+		errno = EINVAL;
+		return -1;
+	}
+	memset(authority, 0, sizeof(*authority));
+	authority->version = RH_FIXED_METADATA_AUTHORITY_VERSION;
+	authority->census = *census;
+	rh_fixed_authority_encode(census, encoded);
+	rh_sha256(encoded, sizeof(encoded), authority->seal);
+	return 0;
+}
+
+#ifdef ROOTHEALTH_REPAIR_TESTING
+int rh_fixed_metadata_authority_seal(
+		const struct rh_fixed_metadata_census *census,
+		struct rh_fixed_metadata_authority *authority)
+{
+	return rh_fixed_metadata_authority_seal_validated(census, authority);
+}
+#endif
+
+int rh_fixed_metadata_authority_valid(
+		const struct rh_fixed_metadata_authority *authority,
+		enum rh_fixed_metadata_kind kind, enum rh_fixed_metadata_view view,
+		uint64_t volume_serial)
+{
+	unsigned char encoded[RH_FIXED_AUTH_ENCODED_BYTES], seal[32];
+
+	if (!authority || authority->version !=
+			RH_FIXED_METADATA_AUTHORITY_VERSION ||
+			authority->census.kind != kind || authority->census.view != view ||
+			authority->census.volume_serial != volume_serial ||
+			!rh_fixed_census_kind_valid(&authority->census))
+		return 0;
+	rh_fixed_authority_encode(&authority->census, encoded);
+	rh_sha256(encoded, sizeof(encoded), seal);
+	return !memcmp(seal, authority->seal, sizeof(seal));
+}
+
+static int rh_fixed_read_serial(struct rh_writer *writer, uint64_t *serial)
+{
+	unsigned char boot[512];
+
+	if (!writer || !serial || rh_writer_read(writer, 0,
+			sizeof(boot), boot) || memcmp(boot + 3, "NTFS    ", 8) ||
+			boot[510] != 0x55 || boot[511] != 0xaa) {
+		errno = EIO;
+		return -1;
+	}
+	*serial = (uint64_t)boot[72] | ((uint64_t)boot[73] << 8) |
+		((uint64_t)boot[74] << 16) | ((uint64_t)boot[75] << 24) |
+		((uint64_t)boot[76] << 32) | ((uint64_t)boot[77] << 40) |
+		((uint64_t)boot[78] << 48) | ((uint64_t)boot[79] << 56);
+	if (!*serial) {
+		errno = EIO;
+		return -1;
+	}
+	return 0;
+}
+
+static int rh_fixed_counter_is(const struct rh_coverage_counter *counter,
+		uint64_t value)
+{
+	return counter && counter->known && counter->value == value;
+}
+
+static int rh_fixed_coverage_authority(
+		const struct rh_coverage_ledger *coverage,
+		const struct rh_raw_mft_census *raw,
+		const struct rh_namespace_census *namespace_census,
+		const struct rh_cluster_bitmap_census *cluster_census,
+		unsigned char coverage_hash[32])
+{
+	struct rh_coverage_ledger normalized;
+	struct rh_fixed_check *checks = NULL;
+	size_t i;
+	uint64_t allowed_failures = 0;
+	int result = 0;
+
+	if (!coverage || !raw || !namespace_census || !cluster_census ||
+			!coverage_hash || !coverage->fixed_system.check_count ||
+			!coverage->fixed_system.checks)
+		return 0;
+	checks = malloc(coverage->fixed_system.check_count * sizeof(*checks));
+	if (!checks)
+		return -1;
+	memcpy(checks, coverage->fixed_system.checks,
+		coverage->fixed_system.check_count * sizeof(*checks));
+	for (i = 0; i < coverage->fixed_system.check_count; i++) {
+		if (checks[i].result == RH_FIXED_CHECK_PASS)
+			continue;
+		if (checks[i].result != RH_FIXED_CHECK_FAIL ||
+				(strcmp(checks[i].id, RH_FIXED_METADATA_UPCASE_CHECK_ID) &&
+				 strcmp(checks[i].id, RH_FIXED_METADATA_ATTRDEF_CHECK_ID)))
+			goto out;
+		checks[i].result = RH_FIXED_CHECK_PASS;
+		allowed_failures++;
+	}
+	normalized = *coverage;
+	normalized.fixed_system.checks = checks;
+	if (!normalized.fixed_system.failed.known ||
+			normalized.fixed_system.failed.value != allowed_failures)
+		goto out;
+	normalized.fixed_system.failed.value = 0;
+	if (!rh_coverage_is_clean(&normalized) ||
+			!rh_fixed_counter_is(&coverage->mft_slots.expected,
+				raw->slots_expected) ||
+			!rh_fixed_counter_is(&coverage->mft_slots.completed,
+				raw->slots_completed) ||
+			!rh_fixed_counter_is(&coverage->mft_slots.unreadable,
+				raw->unreadable_records) ||
+			!rh_fixed_counter_is(&coverage->mft_slots.invalid,
+				raw->invalid_records) ||
+			!rh_fixed_counter_is(&coverage->attributes.expected,
+				raw->attribute_count) ||
+			!rh_fixed_counter_is(&coverage->attributes.completed,
+				raw->attribute_count) ||
+			!rh_fixed_counter_is(&coverage->attributes.resident,
+				raw->resident_attributes) ||
+			!rh_fixed_counter_is(&coverage->attributes.nonresident,
+				raw->nonresident_attributes) ||
+			!rh_fixed_counter_is(&coverage->attributes.user_defined,
+				raw->user_defined_attributes) ||
+			!rh_fixed_counter_is(&coverage->attributes.extents_expected,
+				raw->extents_expected) ||
+			!rh_fixed_counter_is(&coverage->attributes.extents_completed,
+				raw->extents_completed) ||
+			!rh_fixed_counter_is(&coverage->attributes.runs_expected,
+				raw->runs_expected) ||
+			!rh_fixed_counter_is(&coverage->attributes.runs_completed,
+				raw->runs_completed) ||
+			!rh_fixed_counter_is(&coverage->namespace_links.expected,
+				namespace_census->links_expected) ||
+			!rh_fixed_counter_is(&coverage->namespace_links.completed,
+				namespace_census->links_completed) ||
+			!rh_fixed_counter_is(&coverage->namespace_links.reciprocal,
+				namespace_census->reciprocity_complete ?
+					namespace_census->links_expected : 0) ||
+			!rh_fixed_counter_is(&coverage->indexes.expected,
+				namespace_census->i30_indexes_expected) ||
+			!rh_fixed_counter_is(&coverage->indexes.completed,
+				namespace_census->i30_indexes_completed) ||
+			!rh_fixed_counter_is(&coverage->indexes.blocks_allocated,
+				namespace_census->i30_blocks_expected) ||
+			!rh_fixed_counter_is(&coverage->indexes.blocks_reachable,
+				namespace_census->i30_blocks_reachable) ||
+			!rh_fixed_counter_is(&coverage->indexes.blocks_examined,
+				namespace_census->i30_blocks_examined) ||
+			!rh_fixed_counter_is(&coverage->bitmaps.cluster_bits_expected,
+				cluster_census->cluster_count) ||
+			!rh_fixed_counter_is(&coverage->bitmaps.cluster_bits_examined,
+				cluster_census->bitmap_bits_examined) ||
+			rh_coverage_hash(coverage, coverage_hash))
+		goto out;
+	result = 1;
+out:
+	free(checks);
+	return result;
+}
+
+static const struct rh_raw_attribute *rh_fixed_raw_target(
+		const struct rh_raw_mft_census *raw,
+		enum rh_fixed_metadata_kind kind)
+{
+	const struct rh_raw_attribute *matched = NULL;
+	const struct rh_raw_mft_slot *slot;
+	uint64_t record = rh_fixed_record(kind);
+	uint64_t size = rh_fixed_canonical_size(kind);
+	uint64_t allocation = (size + 4095U) & ~UINT64_C(4095);
+	size_t i;
+
+	if (!raw || record >= raw->slot_count || !raw->records_complete ||
+			!raw->records_bounded || !raw->layout_complete ||
+			!raw->attribute_lists_complete || !raw->extents_complete ||
+			raw->slots_completed != raw->slots_expected ||
+			raw->unreadable_records || raw->invalid_records ||
+			raw->runs_completed != raw->runs_expected ||
+			rh_fixed_all_zero(raw->census_hash, 32))
+		return NULL;
+	slot = &raw->slots[record];
+	if (slot->state != RH_RAW_SLOT_LIVE_BASE || !slot->sequence ||
+			slot->record != record || slot->has_attribute_list ||
+			slot->attribute_list_assembled)
+		return NULL;
+	for (i = 0; i < raw->attribute_count; i++) {
+		const struct rh_raw_attribute *attribute = &raw->attributes[i];
+		const struct rh_raw_run *run;
+
+		if (attribute->owner.record != record ||
+				attribute->owner.sequence != slot->sequence ||
+				attribute->type != le32_to_cpu(AT_DATA) ||
+				attribute->name_length)
+			continue;
+		if (matched || !attribute->nonresident || attribute->flags ||
+				attribute->lowest_vcn ||
+				attribute->data_size != (int64_t)size ||
+				attribute->initialized_size != (int64_t)size ||
+				attribute->allocated_size != (int64_t)allocation ||
+				attribute->run_count != 1U ||
+				attribute->run_first >= raw->run_count)
+			return NULL;
+		run = &raw->runs[attribute->run_first];
+		if (run->attribute_index != i || run->vcn || run->lcn < 0 ||
+				run->sparse || run->length != allocation / 4096U)
+			return NULL;
+		matched = attribute;
+	}
+	return matched;
+}
+
+int rh_fixed_metadata_attrdef_type_census(
+		const struct rh_raw_mft_census *raw, unsigned char output[32])
+{
+	const ATTR_DEF *definitions = (const ATTR_DEF *)attrdef_ntfs3x_array;
+	const size_t definition_count = sizeof(attrdef_ntfs3x_array) /
+		sizeof(*definitions);
+	unsigned char encoded[112];
+	size_t i, j;
+
+	if (!raw || !output || !raw->attribute_count ||
+			raw->user_defined_attributes)
+		return 0;
+	for (i = 0; i < raw->attribute_count; i++) {
+		const struct rh_raw_attribute *attribute = &raw->attributes[i];
+		uint64_t size = attribute->nonresident ?
+			(uint64_t)attribute->data_size : attribute->value_length;
+		int found = 0;
+
+		if (attribute->data_size < 0)
+			return 0;
+		for (j = 0; j < definition_count; j++) {
+			uint32_t type = le32_to_cpu(definitions[j].type);
+			uint32_t flags;
+			int64_t minimum, maximum;
+
+			if (type != attribute->type)
+				continue;
+			flags = le32_to_cpu(definitions[j].flags);
+			minimum = sle64_to_cpu(definitions[j].min_size);
+			maximum = sle64_to_cpu(definitions[j].max_size);
+			if ((flags & le32_to_cpu(ATTR_DEF_RESIDENT)) &&
+					attribute->nonresident)
+				return 0;
+			if ((minimum >= 0 && size < (uint64_t)minimum) ||
+					(maximum >= 0 && size > (uint64_t)maximum))
+				return 0;
+			found = 1;
+			break;
+		}
+		if (!found)
+			return 0;
+	}
+	memset(encoded, 0, sizeof(encoded));
+	memcpy(encoded, "RHFIXTYPE1", 10U);
+	rh_fixed_put_u64(encoded + 16U, raw->attribute_count);
+	memcpy(encoded + 24U, raw->attribute_hash, 32U);
+	rh_sha256(attrdef_ntfs3x_array, sizeof(attrdef_ntfs3x_array),
+		encoded + 56U);
+	memcpy(encoded + 88U, raw->census_hash, 24U);
+	rh_sha256(encoded, sizeof(encoded), output);
+	return !rh_fixed_all_zero(output, 32);
+}
+
+int rh_fixed_metadata_authority_build(
+		const struct rh_coverage_ledger *coverage,
+		const struct rh_raw_mft_census *raw,
+		const struct rh_namespace_census *namespace_census,
+		const struct rh_cluster_bitmap_census *cluster_census,
+		struct rh_writer *writer, enum rh_fixed_metadata_kind kind,
+		enum rh_fixed_metadata_view view, uint64_t volume_serial,
+		struct rh_fixed_metadata_authority *authority)
+{
+	const struct rh_raw_attribute *target;
+	const struct rh_raw_run *run;
+	struct rh_fixed_metadata_census census;
+	unsigned char coverage_hash[32], type_hash[32];
+	uint64_t serial, first_cluster, cluster_count, i;
+	int coverage_result;
+
+	if (!writer || !authority || !raw || !namespace_census ||
+			!cluster_census || !volume_serial ||
+			(view != RH_FIXED_METADATA_PRETRANSACTION &&
+			 view != RH_FIXED_METADATA_STAGED) ||
+			raw->generation != namespace_census->generation ||
+			raw->generation != cluster_census->generation ||
+			rh_fixed_read_serial(writer, &serial) || serial != volume_serial ||
+			!namespace_census->graph_bounded ||
+			!namespace_census->graph_complete ||
+			!namespace_census->i30_complete ||
+			!namespace_census->reciprocity_complete ||
+			!namespace_census->identity_checked ||
+			namespace_census->identity != RH_T1OS_IDENTITY_MATCH ||
+			namespace_census->i30_bitmap_changes ||
+			namespace_census->i30_clear_bits_required ||
+			!cluster_census->complete ||
+			!cluster_census->structurally_valid ||
+			!cluster_census->ownership_exact ||
+			!cluster_census->targets_outside_wal || !cluster_census->clean ||
+			cluster_census->duplicate_clusters ||
+			cluster_census->unreadable_slots ||
+			!cluster_census->expected_bitmap ||
+			!cluster_census->observed_bitmap ||
+			rh_fixed_all_zero(cluster_census->allocation_hash, 32) ||
+			!writer->excluded_count || !writer->raw_wal_allowed_count) {
+		errno = EPERM;
+		return -1;
+	}
+	coverage_result = rh_fixed_coverage_authority(coverage, raw,
+		namespace_census, cluster_census, coverage_hash);
+	if (coverage_result <= 0) {
+		if (!coverage_result)
+			errno = EPERM;
+		return -1;
+	}
+	target = rh_fixed_raw_target(raw, kind);
+	if (!target) {
+		errno = EPERM;
+		return -1;
+	}
+	run = &raw->runs[target->run_first];
+	first_cluster = (uint64_t)run->lcn;
+	cluster_count = (uint64_t)run->length;
+	if (first_cluster > UINT64_MAX / 4096U ||
+			cluster_count > UINT64_MAX / 4096U ||
+			first_cluster * 4096U > writer->device_size ||
+			cluster_count * 4096U > writer->device_size -
+				first_cluster * 4096U ||
+			rh_writer_range_excluded(writer, first_cluster * 4096U,
+				(uint64_t)target->data_size)) {
+		errno = EPERM;
+		return -1;
+	}
+	for (i = 0; i < cluster_count; i++) {
+		uint64_t bit = first_cluster + i;
+		if (bit >= cluster_census->cluster_count ||
+				bit / 8U >= cluster_census->bitmap_bytes ||
+				!(cluster_census->expected_bitmap[bit / 8U] &
+					(1U << (bit & 7U))) ||
+				!(cluster_census->observed_bitmap[bit / 8U] &
+					(1U << (bit & 7U)))) {
+			errno = EPERM;
+			return -1;
+		}
+	}
+	memset(&census, 0, sizeof(census));
+	census.kind = kind;
+	census.view = view;
+	census.coverage_ledger_format = RH_COVERAGE_FORMAT;
+	census.generation = raw->generation;
+	census.volume_serial = serial;
+	census.coverage_complete = 1;
+	census.identity_bound = 1;
+	census.no_io_uncertainty = 1;
+	census.target_runs_complete = 1;
+	census.target_ownership_exact = 1;
+	census.targets_outside_wal = 1;
+	census.mft_slots_expected = raw->slots_expected;
+	census.mft_slots_completed = raw->slots_completed;
+	census.attributes_expected = raw->attribute_count;
+	census.attributes_completed = raw->attribute_count;
+	census.extents_expected = raw->extents_expected;
+	census.extents_completed = raw->extents_completed;
+	census.runs_expected = raw->runs_expected;
+	census.runs_completed = raw->runs_completed;
+	memcpy(census.coverage_ledger_hash, coverage_hash, 32U);
+	memcpy(census.raw_census_hash, raw->census_hash, 32U);
+	memcpy(census.target_mapping_hash, target->mapping_hash, 32U);
+	memcpy(census.allocation_bitmap_hash,
+		cluster_census->allocation_hash, 32U);
+	memcpy(census.identity_graph_hash,
+		namespace_census->census_hash, 32U);
+	if (kind == RH_FIXED_METADATA_UPCASE) {
+		census.namespace_links_expected = namespace_census->links_expected;
+		census.namespace_links_completed = namespace_census->links_completed;
+		census.namespace_links_reciprocal = namespace_census->links_expected;
+		census.indexes_expected = namespace_census->i30_indexes_expected;
+		census.indexes_completed = namespace_census->i30_indexes_completed;
+		census.index_blocks_allocated = namespace_census->i30_blocks_expected;
+		census.index_blocks_reachable = namespace_census->i30_blocks_reachable;
+		census.index_blocks_examined = namespace_census->i30_blocks_examined;
+		census.canonical_ordered_indexes =
+			namespace_census->i30_indexes_completed;
+		memcpy(census.namespace_manifest_hash,
+			namespace_census->manifest_hash, 32U);
+		memcpy(census.index_census_hash,
+			namespace_census->i30_index_census_hash, 32U);
+	} else {
+		if (!rh_fixed_metadata_attrdef_type_census(raw, type_hash)) {
+			errno = EPERM;
+			return -1;
+		}
+		census.attribute_types_expected = raw->attribute_count;
+		census.attribute_types_examined = raw->attribute_count;
+		memcpy(census.attribute_type_use_hash, type_hash, 32U);
+	}
+	return rh_fixed_metadata_authority_seal_validated(&census, authority);
+}
+
+static int rh_fixed_mapping_pairs_tail_zero(const ATTR_RECORD *attribute)
+{
+	const unsigned char *raw = (const unsigned char *)attribute;
+	uint32_t length = le32_to_cpu(attribute->length);
+	uint16_t offset = le16_to_cpu(attribute->mapping_pairs_offset);
+	size_t cursor;
+
+	if (!attribute->non_resident || offset < 64U || offset >= length)
+		return 0;
+	for (cursor = offset; cursor < length;) {
+		unsigned int length_bytes, offset_bytes;
+
+		if (!raw[cursor]) {
+			cursor++;
+			while (cursor < length)
+				if (raw[cursor++])
+					return 0;
+			return 1;
+		}
+		length_bytes = raw[cursor] & 15U;
+		offset_bytes = raw[cursor] >> 4;
+		if (!length_bytes || length_bytes > 8U || offset_bytes > 8U ||
+				cursor + 1U > length ||
+				length_bytes + offset_bytes > length - cursor - 1U)
+			return 0;
+		cursor += 1U + length_bytes + offset_bytes;
+	}
+	return 0;
+}
+
+static int rh_fixed_attr_record_valid(const ATTR_RECORD *attribute,
+		uint64_t canonical_size, uint32_t cluster_size,
+		uint16_t *instance)
+{
+	uint64_t clusters = (canonical_size + cluster_size - 1U) / cluster_size;
+	uint64_t allocated = clusters * cluster_size;
+	uint32_t length;
+
+	if (!attribute || !instance || attribute->type != AT_DATA ||
+			!attribute->non_resident || attribute->name_length ||
+			attribute->flags || attribute->compression_unit ||
+			!rh_fixed_all_zero(attribute->reserved1,
+				sizeof(attribute->reserved1)) ||
+			sle64_to_cpu(attribute->lowest_vcn) != 0 ||
+			sle64_to_cpu(attribute->highest_vcn) != (int64_t)clusters - 1 ||
+			sle64_to_cpu(attribute->allocated_size) != (int64_t)allocated ||
+			sle64_to_cpu(attribute->data_size) != (int64_t)canonical_size ||
+			sle64_to_cpu(attribute->initialized_size) !=
+				(int64_t)canonical_size)
+		return 0;
+	length = le32_to_cpu(attribute->length);
+	if (length < 72U || (length & 7U) ||
+			le16_to_cpu(attribute->mapping_pairs_offset) < 64U ||
+			le16_to_cpu(attribute->mapping_pairs_offset) >= length ||
+			!rh_fixed_mapping_pairs_tail_zero(attribute))
+		return 0;
+	*instance = le16_to_cpu(attribute->instance);
+	return 1;
+}
+
+static int rh_fixed_mapping_hash(
+		const struct rh_fixed_metadata_inspection *inspection,
+		unsigned char output[32])
+{
+	unsigned char *encoded;
+	size_t total, cursor, i;
+
+	if (!inspection || !inspection->slice_count ||
+			inspection->slice_count > RH_FIXED_METADATA_MAX_SLICES ||
+			inspection->slice_count >
+			(SIZE_MAX - RH_FIXED_MAPPING_HEADER_BYTES) /
+				RH_FIXED_MAPPING_SLICE_BYTES)
+		return -1;
+	total = RH_FIXED_MAPPING_HEADER_BYTES + inspection->slice_count *
+		RH_FIXED_MAPPING_SLICE_BYTES;
+	encoded = calloc(1, total);
+	if (!encoded)
+		return -1;
+	memcpy(encoded, "RHFIXMAP1", 9);
+	encoded[9] = (unsigned char)inspection->kind;
+	rh_fixed_put_u64(encoded + 16, inspection->volume_serial);
+	rh_fixed_put_u64(encoded + 24, inspection->owner_mft_record);
+	rh_fixed_put_u16(encoded + 32, inspection->owner_sequence);
+	rh_fixed_put_u16(encoded + 34, inspection->attribute_instance);
+	rh_fixed_put_u64(encoded + 40, inspection->data_size);
+	rh_fixed_put_u64(encoded + 48, inspection->allocated_size);
+	rh_fixed_put_u64(encoded + 56, inspection->slice_count);
+	cursor = RH_FIXED_MAPPING_HEADER_BYTES;
+	for (i = 0; i < inspection->slice_count; i++) {
+		const struct rh_fixed_metadata_slice *slice = &inspection->slices[i];
+		rh_fixed_put_u64(encoded + cursor, slice->logical_offset);
+		rh_fixed_put_u64(encoded + cursor + 8, slice->length);
+		rh_fixed_put_u64(encoded + cursor + 16, slice->physical_offset);
+		rh_fixed_put_u64(encoded + cursor + 24,
+			(uint64_t)slice->logical_vcn);
+		rh_fixed_put_u64(encoded + cursor + 32, (uint64_t)slice->lcn);
+		cursor += RH_FIXED_MAPPING_SLICE_BYTES;
+	}
+	rh_sha256(encoded, total, output);
+	free(encoded);
+	return 0;
+}
+
+int rh_fixed_metadata_inspect(ntfs_volume *volume, struct rh_writer *writer,
+		enum rh_fixed_metadata_kind kind,
+		struct rh_fixed_metadata_inspection *inspection)
+{
+	ntfs_inode *inode = NULL;
+	ntfs_attr_search_ctx *search = NULL;
+	ntfs_attr *attribute = NULL;
+	unsigned char *canonical = NULL;
+	unsigned char canonical_hash[32];
+	size_t canonical_length = 0, slice_count = 0;
+	uint64_t expected_record = rh_fixed_record(kind), expected_vcn = 0;
+	uint64_t allocated_clusters, covered = 0, volume_serial;
+	runlist_element *run;
+	uint16_t instance = 0;
+	int result = -1;
+
+	if (!volume || !writer || !inspection || expected_record == UINT64_MAX ||
+			volume->sector_size != 512U || volume->cluster_size != 4096U ||
+			volume->mft_record_size != 1024U ||
+			volume->indx_record_size != 4096U ||
+			writer->device_size > RH_FIXED_MAX_VOLUME_BYTES ||
+			rh_fixed_read_serial(writer, &volume_serial) ||
+			rh_fixed_metadata_canonical_build(kind, &canonical,
+				&canonical_length, canonical_hash)) {
+		if (!errno)
+			errno = EINVAL;
+		return -1;
+	}
+	memset(inspection, 0, sizeof(*inspection));
+	inode = ntfs_inode_open(volume, expected_record);
+	if (!inode || !inode->mrec || inode->mft_no != expected_record ||
+			inode->mrec->magic != magic_FILE ||
+			le32_to_cpu(inode->mrec->mft_record_number) != expected_record ||
+			!(inode->mrec->flags & MFT_RECORD_IN_USE) ||
+			(inode->mrec->flags & MFT_RECORD_IS_DIRECTORY) ||
+			le64_to_cpu(inode->mrec->base_mft_record) ||
+			!le16_to_cpu(inode->mrec->sequence_number) ||
+			NInoAttrList(inode) || inode->nr_extents)
+		goto out;
+	search = ntfs_attr_get_search_ctx(inode, NULL);
+	if (!search || ntfs_attr_lookup(AT_DATA, AT_UNNAMED, 0,
+			CASE_SENSITIVE, 0, NULL, 0, search) || search->ntfs_ino != inode ||
+			!rh_fixed_attr_record_valid(search->attr, canonical_length,
+				volume->cluster_size, &instance))
+		goto out;
+	attribute = ntfs_attr_open(inode, AT_DATA, AT_UNNAMED, 0);
+	if (!attribute || !NAttrNonResident(attribute) || attribute->name_len ||
+			attribute->type != AT_DATA || attribute->data_flags ||
+			attribute->data_size != (int64_t)canonical_length ||
+			attribute->initialized_size != (int64_t)canonical_length ||
+			attribute->allocated_size != (int64_t)((canonical_length +
+				volume->cluster_size - 1U) &
+				~((uint64_t)volume->cluster_size - 1U)) ||
+			ntfs_attr_map_whole_runlist(attribute))
+		goto out;
+	allocated_clusters = (uint64_t)attribute->allocated_size /
+		volume->cluster_size;
+	for (run = attribute->rl; run && run->length; run++) {
+		uint64_t run_bytes, take, physical;
+
+		if (slice_count >= RH_FIXED_METADATA_MAX_SLICES || run->vcn < 0 ||
+				run->lcn < 0 || run->length <= 0 ||
+				(uint64_t)run->vcn != expected_vcn ||
+				(uint64_t)run->length > allocated_clusters - expected_vcn ||
+				(uint64_t)run->length > UINT64_MAX / volume->cluster_size ||
+				(uint64_t)run->lcn > UINT64_MAX / volume->cluster_size)
+			goto out;
+		run_bytes = (uint64_t)run->length * volume->cluster_size;
+		physical = (uint64_t)run->lcn * volume->cluster_size;
+		if (physical > writer->device_size || run_bytes >
+				writer->device_size - physical)
+			goto out;
+		take = run_bytes;
+		if (take > canonical_length - covered)
+			take = canonical_length - covered;
+		if (take) {
+			struct rh_fixed_metadata_slice *grown;
+
+			if ((take % volume->sector_size) ||
+					rh_writer_range_excluded(writer, physical, (size_t)take))
+				goto out;
+			grown = realloc(inspection->slices,
+				(slice_count + 1U) * sizeof(*grown));
+			if (!grown)
+				goto out;
+			inspection->slices = grown;
+			inspection->slices[slice_count].logical_offset = covered;
+			inspection->slices[slice_count].length = take;
+			inspection->slices[slice_count].physical_offset = physical;
+			inspection->slices[slice_count].logical_vcn = run->vcn;
+			inspection->slices[slice_count].lcn = run->lcn;
+			slice_count++;
+			covered += take;
+		}
+		expected_vcn += (uint64_t)run->length;
+	}
+	if (!run || run->length || run->vcn < 0 ||
+			(uint64_t)run->vcn != expected_vcn || run->lcn != LCN_ENOENT ||
+			expected_vcn != allocated_clusters ||
+			covered != canonical_length || slice_count != 1U ||
+			inspection->slices[0].logical_offset ||
+			inspection->slices[0].length != canonical_length)
+		goto out;
+	for (size_t i = 0; i < slice_count; i++)
+		for (size_t j = i + 1U; j < slice_count; j++) {
+			uint64_t first_end = inspection->slices[i].physical_offset +
+				inspection->slices[i].length;
+			uint64_t second_end = inspection->slices[j].physical_offset +
+				inspection->slices[j].length;
+
+			if (inspection->slices[i].physical_offset < second_end &&
+					inspection->slices[j].physical_offset < first_end)
+				goto out;
+		}
+	inspection->current_data = malloc(canonical_length);
+	if (!inspection->current_data || ntfs_attr_pread(attribute, 0,
+			canonical_length, inspection->current_data) !=
+			(int64_t)canonical_length)
+		goto out;
+	inspection->kind = kind;
+	inspection->volume_serial = volume_serial;
+	inspection->owner_mft_record = expected_record;
+	inspection->owner_sequence =
+		le16_to_cpu(inode->mrec->sequence_number);
+	inspection->attribute_instance = instance;
+	inspection->data_size = canonical_length;
+	inspection->allocated_size = attribute->allocated_size;
+	inspection->slice_count = slice_count;
+	rh_sha256(inspection->current_data, canonical_length,
+		inspection->current_hash);
+	memcpy(inspection->canonical_hash, canonical_hash, 32);
+	inspection->canonical = !memcmp(inspection->current_hash,
+		canonical_hash, 32);
+	if (rh_fixed_mapping_hash(inspection, inspection->mapping_hash))
+		goto out;
+	result = 0;
+out:
+	if (attribute)
+		ntfs_attr_close(attribute);
+	if (search)
+		ntfs_attr_put_search_ctx(search);
+	if (inode)
+		ntfs_inode_close(inode);
+	if (canonical) {
+		memset(canonical, 0, canonical_length);
+		free(canonical);
+	}
+	if (result) {
+		rh_fixed_metadata_inspection_destroy(inspection);
+		if (!errno)
+			errno = ENOTSUP;
+	}
+	return result;
+}
+
+void rh_fixed_metadata_inspection_destroy(
+		struct rh_fixed_metadata_inspection *inspection)
+{
+	if (!inspection)
+		return;
+	if (inspection->current_data) {
+		memset(inspection->current_data, 0, (size_t)inspection->data_size);
+		free(inspection->current_data);
+	}
+	free(inspection->slices);
+	memset(inspection, 0, sizeof(*inspection));
+}
+
+static void rh_fixed_unnamed_hash(unsigned char hash[32])
+{
+	rh_sha256("", 0, hash);
+}
+
+static void rh_fixed_target(const struct rh_fixed_metadata_inspection *inspection,
+		const struct rh_fixed_metadata_slice *slice,
+		struct rh_write_semantic_target *target)
+{
+	memset(target, 0, sizeof(*target));
+	target->seal_version = 1;
+	target->object = RH_WRITE_TARGET_NONRESIDENT_ATTRIBUTE;
+	target->owner_mft_record = inspection->owner_mft_record;
+	target->owner_sequence = inspection->owner_sequence;
+	target->attribute_instance = inspection->attribute_instance;
+	target->attribute_type = AT_DATA;
+	target->flags = RH_WRITE_TARGET_NONRESIDENT;
+	rh_fixed_unnamed_hash(target->attribute_name_hash);
+	target->lowest_vcn = 0;
+	target->logical_vcn = slice->logical_vcn;
+	target->logical_offset = slice->logical_offset;
+	target->logical_length = slice->length;
+	target->semantic_target_offset = slice->physical_offset;
+	target->semantic_target_length = slice->length;
+	target->lcn = slice->lcn;
+}
+
+static void rh_fixed_evidence_hash(
+		const struct rh_fixed_metadata_authority *authority,
+		const struct rh_fixed_metadata_inspection *inspection,
+		unsigned char output[32])
+{
+	unsigned char encoded[240];
+	const char *source = inspection->kind == RH_FIXED_METADATA_UPCASE ?
+		rh_upcase_source : rh_attrdef_source;
+
+	memset(encoded, 0, sizeof(encoded));
+	memcpy(encoded, "RHFIXEVID1", 10);
+	encoded[10] = (unsigned char)inspection->kind;
+	encoded[11] = (unsigned char)authority->census.view;
+	rh_fixed_put_u64(encoded + 16, authority->census.generation);
+	rh_fixed_put_u64(encoded + 24, inspection->volume_serial);
+	rh_fixed_put_u64(encoded + 32, inspection->owner_mft_record);
+	rh_fixed_put_u16(encoded + 40, inspection->owner_sequence);
+	rh_fixed_put_u16(encoded + 42, inspection->attribute_instance);
+	rh_fixed_put_u64(encoded + 48, inspection->data_size);
+	memcpy(encoded + 56, authority->seal, 32);
+	memcpy(encoded + 88, inspection->current_hash, 32);
+	memcpy(encoded + 120, inspection->canonical_hash, 32);
+	memcpy(encoded + 152, inspection->mapping_hash, 32);
+	rh_sha256(source, strlen(source), encoded + 184);
+	rh_sha256(encoded, sizeof(encoded), output);
+}
+
+static int rh_fixed_stage_action(ntfs_volume *volume, void *opaque)
+{
+	const struct rh_fixed_stage_context *context = opaque;
+	size_t i;
+
+	if (!volume || !volume->dev || !context || !context->inspection ||
+			!context->canonical || !context->changed) {
+		errno = EINVAL;
+		return RH_OVERLAY_ACTION_ERROR;
+	}
+	for (i = 0; i < context->changed_count; i++) {
+		const struct rh_fixed_metadata_slice *slice =
+			&context->inspection->slices[context->changed[i]];
+
+		if (slice->physical_offset > INT64_MAX || slice->length > INT64_MAX ||
+				ntfs_pwrite(volume->dev, (int64_t)slice->physical_offset,
+					(int64_t)slice->length,
+					context->canonical + slice->logical_offset) !=
+					(int64_t)slice->length)
+			return RH_OVERLAY_ACTION_ERROR;
+	}
+	return RH_OVERLAY_ACTION_OK;
+}
+
+static enum rh_fixed_metadata_stage_result rh_fixed_metadata_stage_one(
+		struct rh_ntfs_overlay *overlay,
+		const struct rh_fixed_metadata_authority *authority,
+		enum rh_fixed_metadata_kind kind, struct rh_fixed_metadata_plan *plan)
+{
+	struct rh_fixed_metadata_inspection inspection;
+	struct rh_overlay_expected_write *writes = NULL;
+	struct rh_overlay_action_expectation expectation;
+	struct rh_fixed_stage_context context;
+	unsigned char *canonical = NULL;
+	unsigned char canonical_hash[32], plan_hash[32];
+	size_t canonical_length = 0, *changed = NULL, changed_count = 0;
+	size_t checkpoint, i;
+	enum rh_fixed_metadata_stage_result result = RH_FIXED_METADATA_STAGE_ERROR;
+
+	memset(&inspection, 0, sizeof(inspection));
+	if (!overlay || !overlay->volume || !overlay->writer || !plan ||
+			!overlay->fixed_metadata_startup_only) {
+		errno = EINVAL;
+		return RH_FIXED_METADATA_STAGE_ERROR;
+	}
+	memset(plan, 0, sizeof(*plan));
+	if (!rh_fixed_metadata_authority_valid(authority, kind,
+			RH_FIXED_METADATA_PRETRANSACTION,
+			authority ? authority->census.volume_serial : 0)) {
+		errno = EPERM;
+		return RH_FIXED_METADATA_STAGE_REFUSED;
+	}
+	if (rh_fixed_metadata_inspect(overlay->volume, overlay->writer, kind,
+			&inspection))
+		return errno == EIO ? RH_FIXED_METADATA_STAGE_ERROR :
+			RH_FIXED_METADATA_STAGE_REFUSED;
+	if (!rh_fixed_metadata_authority_valid(authority, kind,
+			RH_FIXED_METADATA_PRETRANSACTION, inspection.volume_serial)) {
+		errno = EPERM;
+		result = RH_FIXED_METADATA_STAGE_REFUSED;
+		goto out;
+	}
+	plan->kind = kind;
+	plan->owner_mft_record = inspection.owner_mft_record;
+	plan->owner_sequence = inspection.owner_sequence;
+	plan->attribute_instance = inspection.attribute_instance;
+	plan->generation = authority->census.generation;
+	plan->volume_serial = inspection.volume_serial;
+	plan->writer_checkpoint = rh_writer_plan_checkpoint(overlay->writer);
+	memcpy(plan->canonical_hash, inspection.canonical_hash, 32);
+	memcpy(plan->current_hash, inspection.current_hash, 32);
+	memcpy(plan->mapping_hash, inspection.mapping_hash, 32);
+	rh_fixed_evidence_hash(authority, &inspection, plan->pre_evidence_hash);
+	if (inspection.canonical) {
+		plan->clean = 1;
+		if (rh_ntfs_overlay_fixed_metadata_note_clean(overlay,
+				rh_fixed_write_kind(kind))) {
+			plan->clean = 0;
+			goto out;
+		}
+		result = RH_FIXED_METADATA_STAGE_CLEAN;
+		goto out;
+	}
+	if (rh_fixed_metadata_canonical_build(kind, &canonical,
+			&canonical_length, canonical_hash) ||
+			canonical_length != inspection.data_size ||
+			memcmp(canonical_hash, inspection.canonical_hash, 32))
+		goto out;
+	changed = calloc(inspection.slice_count, sizeof(*changed));
+	writes = calloc(inspection.slice_count, sizeof(*writes));
+	if (!changed || !writes)
+		goto out;
+	for (i = 0; i < inspection.slice_count; i++) {
+		const struct rh_fixed_metadata_slice *slice = &inspection.slices[i];
+		struct rh_write_semantic_target target;
+
+		if (!memcmp(inspection.current_data + slice->logical_offset,
+				canonical + slice->logical_offset, (size_t)slice->length))
+			continue;
+		changed[changed_count] = i;
+		writes[changed_count].offset = slice->physical_offset;
+		writes[changed_count].length = slice->length;
+		rh_fixed_target(&inspection, slice, &target);
+		if (!rh_write_semantic_target_valid(rh_fixed_write_kind(kind),
+				&target, slice->physical_offset, (size_t)slice->length, 0)) {
+			errno = EINVAL;
+			goto out;
+		}
+		writes[changed_count].target = target;
+		changed_count++;
+	}
+	if (!changed_count) {
+		errno = EILSEQ;
+		goto out;
+	}
+	checkpoint = rh_writer_plan_checkpoint(overlay->writer);
+	expectation.kind = rh_fixed_write_kind(kind);
+	expectation.writes = writes;
+	expectation.write_count = changed_count;
+	context.inspection = &inspection;
+	context.canonical = canonical;
+	context.changed = changed;
+	context.changed_count = changed_count;
+	if (rh_ntfs_overlay_run_action(overlay, &expectation,
+			rh_fixed_stage_action, &context) != RH_OVERLAY_ACTION_OK ||
+			overlay->writer->operation_count != checkpoint + changed_count ||
+			overlay->writer->write_boundaries ||
+			rh_writer_plan_hash(overlay->writer,
+				overlay->writer->operation_count, plan_hash))
+		goto out;
+	plan->first_operation_ordinal = checkpoint + 1U;
+	plan->operation_count = changed_count;
+	plan->writer_checkpoint = overlay->writer->operation_count;
+	memcpy(plan->staged_plan_hash, plan_hash, 32);
+	result = RH_FIXED_METADATA_STAGE_PLANNED;
+out:
+	if (canonical) {
+		memset(canonical, 0, canonical_length);
+		free(canonical);
+	}
+	free(changed);
+	free(writes);
+	rh_fixed_metadata_inspection_destroy(&inspection);
+	if (result == RH_FIXED_METADATA_STAGE_ERROR && !errno)
+		errno = EIO;
+	return result;
+}
+
+static void rh_fixed_metadata_batch_discard(struct rh_ntfs_overlay *overlay,
+		size_t checkpoint)
+{
+	if (!overlay || !overlay->writer)
+		return;
+	if (overlay->fixed_metadata_startup_only) {
+		if (rh_ntfs_overlay_abort_fixed_metadata_bootstrap(overlay))
+			overlay->failed = 1;
+	} else {
+		overlay->fixed_metadata_abort_examined_mask =
+			overlay->fixed_metadata_examined_mask;
+		overlay->fixed_metadata_abort_discarded_operations =
+			overlay->writer->operation_count - checkpoint;
+		if (rh_writer_discard_after(overlay->writer, checkpoint))
+			overlay->failed = 1;
+		overlay->fixed_metadata_examined_mask = 0;
+		overlay->planned_calls[RH_WRITE_UPCASE_DATA] = 0;
+		overlay->planned_calls[RH_WRITE_ATTRDEF_DATA] = 0;
+	}
+}
+
+enum rh_fixed_metadata_stage_result rh_fixed_metadata_stage_batch(
+		struct rh_ntfs_overlay *overlay,
+		const struct rh_fixed_metadata_authority *upcase_authority,
+		const struct rh_fixed_metadata_authority *attrdef_authority,
+		struct rh_fixed_metadata_batch *batch)
+{
+	enum rh_fixed_metadata_stage_result upcase_result =
+		RH_FIXED_METADATA_STAGE_ERROR;
+	enum rh_fixed_metadata_stage_result attrdef_result =
+		RH_FIXED_METADATA_STAGE_ERROR;
+	unsigned char plan_hash[32];
+	size_t final_count;
+
+	if (!overlay || !overlay->volume || !overlay->writer || !batch ||
+			!overlay->fixed_metadata_startup_only || overlay->failed ||
+			overlay->fixed_metadata_examined_mask ||
+			overlay->writer->operation_count !=
+				overlay->fixed_metadata_batch_checkpoint) {
+		errno = EINVAL;
+		return RH_FIXED_METADATA_STAGE_ERROR;
+	}
+	memset(batch, 0, sizeof(*batch));
+	batch->writer_checkpoint = overlay->fixed_metadata_batch_checkpoint;
+	/* Close before touching either target: both complete ledgers are atomic. */
+	if (!rh_fixed_metadata_authority_valid(upcase_authority,
+			RH_FIXED_METADATA_UPCASE, RH_FIXED_METADATA_PRETRANSACTION,
+			upcase_authority ? upcase_authority->census.volume_serial : 0) ||
+			!rh_fixed_metadata_authority_valid(attrdef_authority,
+				RH_FIXED_METADATA_ATTRDEF,
+				RH_FIXED_METADATA_PRETRANSACTION,
+				attrdef_authority ?
+					attrdef_authority->census.volume_serial : 0) ||
+			upcase_authority->census.generation !=
+				attrdef_authority->census.generation ||
+			upcase_authority->census.volume_serial !=
+				attrdef_authority->census.volume_serial) {
+		errno = EPERM;
+		return RH_FIXED_METADATA_STAGE_REFUSED;
+	}
+	upcase_result = rh_fixed_metadata_stage_one(overlay, upcase_authority,
+		RH_FIXED_METADATA_UPCASE, &batch->upcase);
+	if (upcase_result != RH_FIXED_METADATA_STAGE_CLEAN &&
+			upcase_result != RH_FIXED_METADATA_STAGE_PLANNED)
+		goto fail;
+#ifdef ROOTHEALTH_REPAIR_TESTING
+	if (getenv("ROOTHEALTH_FIXED_METADATA_TEST_REFUSE_SECOND")) {
+		errno = EPERM;
+		attrdef_result = RH_FIXED_METADATA_STAGE_REFUSED;
+		goto fail;
+	}
+#endif
+	attrdef_result = rh_fixed_metadata_stage_one(overlay, attrdef_authority,
+		RH_FIXED_METADATA_ATTRDEF, &batch->attrdef);
+	if (attrdef_result != RH_FIXED_METADATA_STAGE_CLEAN &&
+			attrdef_result != RH_FIXED_METADATA_STAGE_PLANNED)
+		goto fail;
+	final_count = overlay->writer->operation_count;
+	memset(plan_hash, 0, sizeof(plan_hash));
+	if (final_count != batch->writer_checkpoint &&
+			rh_writer_plan_hash(overlay->writer, final_count, plan_hash))
+		goto fail;
+	batch->upcase.writer_checkpoint = final_count;
+	batch->attrdef.writer_checkpoint = final_count;
+	if (!batch->upcase.clean)
+		memcpy(batch->upcase.staged_plan_hash, plan_hash, 32);
+	if (!batch->attrdef.clean)
+		memcpy(batch->attrdef.staged_plan_hash, plan_hash, 32);
+	if (rh_ntfs_overlay_finish_fixed_metadata_bootstrap(overlay)) {
+		memset(batch, 0, sizeof(*batch));
+		return RH_FIXED_METADATA_STAGE_ERROR;
+	}
+	batch->staged = 1;
+	return upcase_result == RH_FIXED_METADATA_STAGE_PLANNED ||
+		attrdef_result == RH_FIXED_METADATA_STAGE_PLANNED ?
+		RH_FIXED_METADATA_STAGE_PLANNED : RH_FIXED_METADATA_STAGE_CLEAN;
+fail:
+	rh_fixed_metadata_batch_discard(overlay, batch->writer_checkpoint);
+	memset(batch, 0, sizeof(*batch));
+	if (!errno)
+		errno = EIO;
+	return upcase_result == RH_FIXED_METADATA_STAGE_REFUSED ||
+		attrdef_result == RH_FIXED_METADATA_STAGE_REFUSED ?
+		RH_FIXED_METADATA_STAGE_REFUSED : RH_FIXED_METADATA_STAGE_ERROR;
+}
+
+static const struct rh_fixed_metadata_slice *rh_fixed_find_slice(
+		const struct rh_fixed_metadata_inspection *inspection,
+		const struct rh_write_operation *operation)
+{
+	size_t i;
+
+	for (i = 0; i < inspection->slice_count; i++)
+		if (inspection->slices[i].physical_offset == operation->offset &&
+				inspection->slices[i].length == operation->length)
+			return &inspection->slices[i];
+	return NULL;
+}
+
+static int rh_fixed_target_identity_equal(
+		const struct rh_write_semantic_target *actual,
+		const struct rh_write_semantic_target *expected)
+{
+	return actual->seal_version == expected->seal_version &&
+		actual->object == expected->object &&
+		actual->owner_mft_record == expected->owner_mft_record &&
+		actual->owner_sequence == expected->owner_sequence &&
+		actual->attribute_instance == expected->attribute_instance &&
+		actual->attribute_type == expected->attribute_type &&
+		actual->attribute_name_length == expected->attribute_name_length &&
+		actual->flags == expected->flags &&
+		!memcmp(actual->attribute_name_hash, expected->attribute_name_hash, 32) &&
+		actual->lowest_vcn == expected->lowest_vcn &&
+		actual->logical_vcn == expected->logical_vcn &&
+		actual->logical_offset == expected->logical_offset &&
+		actual->logical_length == expected->logical_length &&
+		actual->semantic_target_offset == expected->semantic_target_offset &&
+		actual->semantic_target_length == expected->semantic_target_length &&
+		actual->lcn == expected->lcn;
+}
+
+int rh_fixed_metadata_verify_staged(struct rh_ntfs_overlay *overlay,
+		const struct rh_fixed_metadata_authority *authority,
+		struct rh_fixed_metadata_plan *plan)
+{
+	struct rh_fixed_metadata_inspection inspection;
+	unsigned char *canonical = NULL, *reconstructed = NULL;
+	unsigned char canonical_hash[32], reconstructed_hash[32], plan_hash[32];
+	unsigned char before_hash[32], after_hash[32];
+	unsigned char matched[RH_FIXED_METADATA_MAX_SLICES] = {0};
+	size_t canonical_length = 0, i;
+	int result = -1;
+
+	memset(&inspection, 0, sizeof(inspection));
+	if (!overlay || !overlay->volume || !overlay->writer || !authority ||
+			!plan || plan->clean || !plan->operation_count ||
+			plan->staged_verified || plan->finalized ||
+			overlay->writer->operation_count != plan->writer_checkpoint ||
+			!rh_fixed_metadata_authority_valid(authority, plan->kind,
+				RH_FIXED_METADATA_STAGED, plan->volume_serial) ||
+			authority->census.generation != plan->generation ||
+			rh_fixed_metadata_inspect(overlay->volume, overlay->writer,
+				plan->kind, &inspection) || !inspection.canonical ||
+			inspection.owner_mft_record != plan->owner_mft_record ||
+			inspection.owner_sequence != plan->owner_sequence ||
+			inspection.attribute_instance != plan->attribute_instance ||
+			memcmp(inspection.mapping_hash, plan->mapping_hash, 32) ||
+			rh_fixed_metadata_canonical_build(plan->kind, &canonical,
+				&canonical_length, canonical_hash) ||
+			canonical_length != inspection.data_size ||
+			memcmp(canonical_hash, plan->canonical_hash, 32)) {
+		if (!errno)
+			errno = EPERM;
+		goto out;
+	}
+	reconstructed = malloc(canonical_length);
+	if (!reconstructed)
+		goto out;
+	memcpy(reconstructed, canonical, canonical_length);
+	for (i = 0; i < plan->operation_count; i++) {
+		const struct rh_write_operation *operation =
+			&overlay->writer->operations[
+				plan->first_operation_ordinal - 1U + i];
+		const struct rh_fixed_metadata_slice *slice =
+			rh_fixed_find_slice(&inspection, operation);
+		struct rh_write_semantic_target expected;
+		size_t slice_ordinal;
+
+		if (!slice || operation->kind != rh_fixed_write_kind(plan->kind) ||
+				memcmp(operation->after,
+					canonical + slice->logical_offset, operation->length))
+			goto out;
+		slice_ordinal = (size_t)(slice - inspection.slices);
+		if (slice_ordinal >= inspection.slice_count || matched[slice_ordinal])
+			goto out;
+		matched[slice_ordinal] = 1;
+		rh_fixed_target(&inspection, slice, &expected);
+		if (!rh_fixed_target_identity_equal(&operation->target, &expected) ||
+				operation->target.finalized ||
+				!rh_write_semantic_target_valid(operation->kind,
+					&operation->target, operation->offset,
+					operation->length, 0) ||
+				!memcmp(operation->before, operation->after,
+					operation->length))
+			goto out;
+		rh_sha256(operation->before, operation->length, before_hash);
+		rh_sha256(operation->after, operation->length, after_hash);
+		if (memcmp(before_hash, operation->target.semantic_before_hash, 32) ||
+				memcmp(after_hash,
+					operation->target.semantic_after_hash, 32))
+			goto out;
+		memcpy(reconstructed + slice->logical_offset, operation->before,
+			operation->length);
+	}
+	rh_sha256(reconstructed, canonical_length, reconstructed_hash);
+	if (memcmp(reconstructed_hash, plan->current_hash, 32) ||
+			rh_writer_plan_hash(overlay->writer,
+				overlay->writer->operation_count, plan_hash) ||
+			memcmp(plan_hash, plan->staged_plan_hash, 32))
+		goto out;
+	rh_fixed_evidence_hash(authority, &inspection,
+		plan->staged_evidence_hash);
+	plan->staged_verified = 1;
+	result = 0;
+out:
+	if (canonical) {
+		memset(canonical, 0, canonical_length);
+		free(canonical);
+	}
+	if (reconstructed) {
+		memset(reconstructed, 0, canonical_length);
+		free(reconstructed);
+	}
+	rh_fixed_metadata_inspection_destroy(&inspection);
+	if (result && !errno)
+		errno = EIO;
+	return result;
+}
+
+static int rh_fixed_metadata_verify_clean_staged(
+		struct rh_ntfs_overlay *overlay,
+		const struct rh_fixed_metadata_authority *authority,
+		struct rh_fixed_metadata_plan *plan)
+{
+	struct rh_fixed_metadata_inspection inspection;
+	int result = -1;
+
+	memset(&inspection, 0, sizeof(inspection));
+	if (!overlay || !overlay->volume || !overlay->writer || !authority ||
+			!plan || !plan->clean || plan->operation_count ||
+			!rh_fixed_metadata_authority_valid(authority, plan->kind,
+				RH_FIXED_METADATA_STAGED, plan->volume_serial) ||
+			authority->census.generation != plan->generation ||
+			rh_fixed_metadata_inspect(overlay->volume, overlay->writer,
+				plan->kind, &inspection) || !inspection.canonical ||
+			inspection.owner_mft_record != plan->owner_mft_record ||
+			inspection.owner_sequence != plan->owner_sequence ||
+			inspection.attribute_instance != plan->attribute_instance ||
+			memcmp(inspection.current_hash, plan->canonical_hash, 32) ||
+			memcmp(inspection.mapping_hash, plan->mapping_hash, 32)) {
+		if (!errno)
+			errno = EPERM;
+		goto out;
+	}
+	rh_fixed_evidence_hash(authority, &inspection,
+		plan->staged_evidence_hash);
+	plan->staged_verified = 1;
+	result = 0;
+out:
+	rh_fixed_metadata_inspection_destroy(&inspection);
+	return result;
+}
+
+int rh_fixed_metadata_verify_finalize_batch(
+		struct rh_ntfs_overlay *overlay,
+		const struct rh_fixed_metadata_authority *upcase_authority,
+		const struct rh_fixed_metadata_authority *attrdef_authority,
+		struct rh_fixed_metadata_batch *batch)
+{
+	struct rh_fixed_metadata_plan *plans[2];
+	const struct rh_fixed_metadata_authority *authorities[2];
+	unsigned char plan_hash[32];
+	size_t i, j;
+
+	if (!overlay || !overlay->volume || !overlay->writer || !batch ||
+			!batch->staged || batch->finalized ||
+			overlay->fixed_metadata_startup_only || overlay->failed ||
+			overlay->writer->operation_count < batch->writer_checkpoint) {
+		errno = EINVAL;
+		return -1;
+	}
+	plans[0] = &batch->upcase;
+	plans[1] = &batch->attrdef;
+	authorities[0] = upcase_authority;
+	authorities[1] = attrdef_authority;
+	for (i = 0; i < 2U; i++) {
+		int verify_result = plans[i]->clean ?
+			rh_fixed_metadata_verify_clean_staged(overlay, authorities[i],
+				plans[i]) :
+			rh_fixed_metadata_verify_staged(overlay, authorities[i],
+				plans[i]);
+
+		if (verify_result)
+			goto fail;
+	}
+	memset(plan_hash, 0, sizeof(plan_hash));
+	if (overlay->writer->operation_count != batch->writer_checkpoint &&
+			rh_writer_plan_hash(overlay->writer,
+				overlay->writer->operation_count, plan_hash))
+		goto fail;
+	for (i = 0; i < 2U; i++)
+		if (!plans[i]->clean &&
+				memcmp(plan_hash, plans[i]->staged_plan_hash, 32))
+			goto fail;
+	for (i = 0; i < 2U; i++) {
+		if (plans[i]->clean) {
+			plans[i]->finalized = 1;
+			continue;
+		}
+		for (j = 0; j < plans[i]->operation_count; j++)
+			if (rh_writer_finalize_target(overlay->writer,
+					plans[i]->first_operation_ordinal + j,
+					RH_FIXED_METADATA_EVIDENCE_VERSION,
+					plans[i]->generation, plans[i]->pre_evidence_hash,
+					plans[i]->staged_evidence_hash))
+				goto fail;
+		plans[i]->finalized = 1;
+	}
+	batch->finalized = 1;
+	return 0;
+fail:
+	i = batch->writer_checkpoint;
+	rh_fixed_metadata_batch_discard(overlay, i);
+	memset(batch, 0, sizeof(*batch));
+	overlay->failed = 1;
+	if (!errno)
+		errno = EPERM;
+	return -1;
+}
+
+static int rh_fixed_recovery_entry_valid(
+		const struct rh_fixed_metadata_recovery_entry *entry,
+		const struct rh_fixed_metadata_inspection *inspection,
+		const struct rh_fixed_metadata_slice *slice,
+		const unsigned char *canonical,
+		const unsigned char pre_evidence_hash[32],
+		const unsigned char *staged_evidence_hash, uint64_t generation)
+{
+	struct rh_write_semantic_target expected;
+	unsigned char old_hash[32], new_hash[32];
+
+	if (!entry || !entry->old_bytes ||
+			entry->kind != rh_fixed_write_kind(inspection->kind) ||
+			entry->target_offset != slice->physical_offset ||
+			entry->length != slice->length)
+		return 0;
+	rh_fixed_target(inspection, slice, &expected);
+	if (!rh_fixed_target_identity_equal(&entry->target, &expected) ||
+			!entry->target.finalized ||
+			entry->target.evidence_version !=
+				RH_FIXED_METADATA_EVIDENCE_VERSION ||
+			entry->target.evidence_generation != generation ||
+			memcmp(entry->target.evidence_hash, pre_evidence_hash, 32) ||
+			(staged_evidence_hash && memcmp(entry->target.staged_view_hash,
+				staged_evidence_hash, 32)) ||
+			!rh_write_semantic_target_valid(entry->kind, &entry->target,
+				entry->target_offset, entry->length, 1))
+		return 0;
+	rh_sha256(entry->old_bytes, entry->length, old_hash);
+	rh_sha256(canonical + slice->logical_offset, entry->length, new_hash);
+	return memcmp(old_hash, new_hash, 32) &&
+		!memcmp(entry->old_hash, old_hash, 32) &&
+		!memcmp(entry->new_hash, new_hash, 32) &&
+		!memcmp(entry->target.semantic_before_hash, old_hash, 32) &&
+		!memcmp(entry->target.semantic_after_hash, new_hash, 32);
+}
+
+int rh_fixed_metadata_rederive_recovery(ntfs_volume *pre_volume,
+		struct rh_writer *pre_writer,
+		const struct rh_fixed_metadata_authority *pre_authority,
+		ntfs_volume *post_volume, struct rh_writer *post_writer,
+		const struct rh_fixed_metadata_authority *post_authority,
+		const struct rh_fixed_metadata_recovery_entry *entries,
+		size_t entry_count, int committed)
+{
+	struct rh_fixed_metadata_inspection pre, post;
+	unsigned char *canonical = NULL;
+	unsigned char canonical_hash[32], pre_evidence[32], staged_evidence[32];
+	size_t canonical_length = 0, changed = 0, i;
+	int result = -1;
+	enum rh_fixed_metadata_kind kind;
+
+	memset(&pre, 0, sizeof(pre));
+	memset(&post, 0, sizeof(post));
+	if (!pre_volume || !pre_writer || !pre_authority || !post_volume ||
+			!post_writer || !post_authority || !entries ||
+			!entry_count || (committed != 0 && committed != 1) ||
+			rh_fixed_all_zero(post_authority->seal, 32)) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (entries[0].kind == RH_WRITE_UPCASE_DATA)
+		kind = RH_FIXED_METADATA_UPCASE;
+	else if (entries[0].kind == RH_WRITE_ATTRDEF_DATA)
+		kind = RH_FIXED_METADATA_ATTRDEF;
+	else {
+		errno = ENOTSUP;
+		return -1;
+	}
+	for (i = 1; i < entry_count; i++)
+		if (entries[i].kind != entries[0].kind) {
+			errno = EINVAL;
+			return -1;
+		}
+	if (rh_fixed_metadata_inspect(pre_volume, pre_writer, kind, &pre) ||
+			!rh_fixed_metadata_authority_valid(pre_authority, kind,
+				RH_FIXED_METADATA_PRETRANSACTION, pre.volume_serial) ||
+			rh_fixed_metadata_canonical_build(kind, &canonical,
+				&canonical_length, canonical_hash) ||
+			canonical_length != pre.data_size ||
+			memcmp(canonical_hash, pre.canonical_hash, 32))
+		goto out;
+	rh_fixed_evidence_hash(pre_authority, &pre, pre_evidence);
+	if (rh_fixed_metadata_inspect(post_volume, post_writer, kind, &post) ||
+				!post.canonical ||
+				!rh_fixed_metadata_authority_valid(post_authority, kind,
+					RH_FIXED_METADATA_STAGED, post.volume_serial) ||
+				post_authority->census.generation !=
+					pre_authority->census.generation ||
+				post.owner_mft_record != pre.owner_mft_record ||
+				post.owner_sequence != pre.owner_sequence ||
+				post.attribute_instance != pre.attribute_instance ||
+				memcmp(post.mapping_hash, pre.mapping_hash, 32))
+		goto out;
+	rh_fixed_evidence_hash(post_authority, &post, staged_evidence);
+	for (i = 0; i < pre.slice_count; i++) {
+		const struct rh_fixed_metadata_slice *slice = &pre.slices[i];
+
+		if (!memcmp(pre.current_data + slice->logical_offset,
+				canonical + slice->logical_offset, (size_t)slice->length))
+			continue;
+		if (changed >= entry_count ||
+				!rh_fixed_recovery_entry_valid(&entries[changed], &pre,
+					slice, canonical, pre_evidence, staged_evidence,
+					pre_authority->census.generation) ||
+				memcmp(entries[changed].old_bytes,
+					pre.current_data + slice->logical_offset,
+					(size_t)slice->length))
+			goto out;
+		changed++;
+	}
+	if (changed != entry_count)
+		goto out;
+	result = 0;
+out:
+	if (canonical) {
+		memset(canonical, 0, canonical_length);
+		free(canonical);
+	}
+	rh_fixed_metadata_inspection_destroy(&post);
+	rh_fixed_metadata_inspection_destroy(&pre);
+	if (result && !errno)
+		errno = EIO;
+	return result;
+}
