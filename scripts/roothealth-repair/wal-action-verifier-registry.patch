+	uint32_t action_id;
+	enum rh_wal_transaction_kind transaction_kind;
+	enum rh_wal_state state;
+	uint64_t generation;
+	uint64_t volume_serial;
+	uint64_t journal_record;
+	uint16_t journal_sequence;
+	uint16_t reserved16;
