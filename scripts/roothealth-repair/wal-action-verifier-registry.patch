+			if (seen[j] && wal->action_verifiers[j].verify == verify)
+				processed[j] = 1U;
+	}
+	errno = 0;
+	result = 0;
+out:
+	free(operation_snapshot);
+	free(entry_snapshot);
+	return result;
+}
