+static int roothealth_build_action_target(ntfs_volume *vol,
+		const LOG_RECORD *logr, const struct rh_replay_action_view *guarded,
+		LCN physical_lcn, const unsigned char *cluster, int mirror,
+		struct rh_write_semantic_target *target, u64 *offset,
+		size_t *length, const unsigned char **after)
+{
+	struct ATTR *pa;
+	ntfs_inode *ni = NULL;
+	ntfs_attr *na = NULL;
+	u64 raw;
+	int result = -1;
+
+	if (!vol || !logr || !guarded || physical_lcn < 0 || !cluster ||
+		!target || !offset || !length || !after ||
+		(u64)physical_lcn > UINT64_MAX / clustersz)
+		return -1;
+	raw = (u64)physical_lcn * clustersz;
+	if (guarded->action_class == RH_REPLAY_ACTION_MFT_WRITE) {
+		const MFT_RECORD *record;
+		u64 record_number;
+
+		if (guarded->target_slice_offset > clustersz ||
+			guarded->target_object_size != mftrecsz ||
+			mftrecsz > clustersz - guarded->target_slice_offset)
+			return -1;
+		record = (const MFT_RECORD *)(cluster +
+			guarded->target_slice_offset);
+		record_number = guarded->target_vcn *
+			((u64)clustersz / mftrecsz) +
+			guarded->target_slice_offset / mftrecsz;
+		if (record->magic != magic_FILE ||
+			le32_to_cpu(record->mft_record_number) != record_number ||
+			!le16_to_cpu(record->sequence_number) ||
+			record_number > (mirror ? 3U : UINT64_MAX)) {
+			printf("** Native MFT target identity mismatch: record %llu field %u "
+				"sequence %u mirror %d magic 0x%x\n",
+				(unsigned long long)record_number,
+				(unsigned int)le32_to_cpu(record->mft_record_number),
+				(unsigned int)le16_to_cpu(record->sequence_number), mirror,
+				(unsigned int)le32_to_cpu(record->magic));
+			return -1;
+		}
+		memset(target, 0, sizeof(*target));
+		target->seal_version = 1U;
+		target->object = mirror ? RH_WRITE_TARGET_MFT_RECORD_MIRROR :
+			RH_WRITE_TARGET_MFT_RECORD_PRIMARY;
+		target->owner_mft_record = record_number;
+		target->owner_sequence = le16_to_cpu(record->sequence_number);
+		target->flags = (mirror ? RH_WRITE_TARGET_MIRROR :
+			RH_WRITE_TARGET_PRIMARY) | RH_WRITE_TARGET_RESIDENT |
+			RH_WRITE_TARGET_NATIVE_LOG_DERIVED;
+		if (guarded->redo_operation == InitializeFileRecordSegment) {
+			if (mirror || record_number <= 3U)
+				return -1;
+			target->flags |= RH_WRITE_TARGET_PRETRANSACTION_FREE;
+		}
+		target->lowest_vcn = -1;
+		target->logical_vcn = -1;
+		target->logical_length = mftrecsz;
+		target->semantic_target_offset = raw +
+			guarded->target_slice_offset;
+		target->semantic_target_length = mftrecsz;
+		target->lcn = -1;
+		*offset = target->semantic_target_offset;
+		*length = mftrecsz;
+		*after = cluster + guarded->target_slice_offset;
+		if (!rh_write_semantic_target_valid(RH_WRITE_LOGFILE_REDO,
+				target, *offset, *length, 0)) {
+			printf("** Native MFT target descriptor rejected: record %llu "
+				"sequence %u offset %llu length %zu flags 0x%x\n",
+				(unsigned long long)record_number,
+				(unsigned int)target->owner_sequence,
+				(unsigned long long)*offset, *length,
+				(unsigned int)target->flags);
+			return -1;
+		}
+		return 0;
+	}
+	if (mirror)
+		return -1;
+	pa = findattrentry(le16_to_cpu(logr->target_attribute));
+	if (!pa || !pa->reference || !pa->type || (pa->namelen & 1U))
+		return -1;
+	ni = ntfs_inode_open(vol, (MFT_REF)pa->reference);
+	if (!ni)
+		goto out;
+	na = ntfs_attr_open(ni, (ATTR_TYPES)pa->type,
+		pa->namelen ? pa->name : AT_UNNAMED, pa->namelen / 2U);
+	if (!na || roothealth_build_native_attr_target(na,
+			(VCN)guarded->target_vcn, physical_lcn, raw, clustersz,
+			RH_WRITE_LOGFILE_REDO, target))
+		goto out;
+	*offset = raw;
+	*length = clustersz;
+	*after = cluster;
+	result = 0;
+out:
+	if (na)
+		ntfs_attr_close(na);
+	if (ni)
+		ntfs_inode_close(ni);
+	return result;
+}
