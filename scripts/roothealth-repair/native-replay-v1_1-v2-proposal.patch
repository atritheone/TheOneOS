+int roothealth_build_native_attr_target(ntfs_attr *na, VCN vcn,
+		LCN lcn, u64 physical_offset, size_t length,
+		enum rh_write_kind kind, struct rh_write_semantic_target *target)
+{
+	ntfs_attr_search_ctx *ctx = NULL;
+	ntfs_inode *owner;
+	ATTR_RECORD *attr;
+	VCN lowest;
+	VCN highest;
+	int result = -1;
+
+	if (!na || !na->ni || !na->ni->mrec || !NAttrNonResident(na) ||
+		!target || vcn < 0 || lcn < 0 || !length ||
+		(u64)vcn > UINT64_MAX / clustersz ||
+		physical_offset > UINT64_MAX - length)
+		return -1;
+	ctx = ntfs_attr_get_search_ctx(na->ni, NULL);
+	if (!ctx || ntfs_attr_lookup(na->type,
+			na->name_len ? na->name : AT_UNNAMED, na->name_len,
+			CASE_SENSITIVE, vcn, NULL, 0, ctx)) {
+		printf("** Native attribute extent lookup failed: owner %llu type 0x%x "
+			"vcn %lld\n", (unsigned long long)na->ni->mft_no,
+			(unsigned int)na->type, (long long)vcn);
+		goto out;
+	}
+	attr = ctx->attr;
+	owner = ctx->ntfs_ino ? ctx->ntfs_ino : na->ni;
+	if (!attr || !owner || !owner->mrec || !attr->non_resident ||
+		attr->type != na->type || attr->name_length != na->name_len ||
+		(attr->name_length && (le16_to_cpu(attr->name_offset) >
+			le32_to_cpu(attr->length) ||
+			(size_t)attr->name_length * sizeof(ntfschar) >
+			le32_to_cpu(attr->length) - le16_to_cpu(attr->name_offset) ||
+			memcmp((const unsigned char *)attr +
+				le16_to_cpu(attr->name_offset), na->name,
+				(size_t)attr->name_length * sizeof(ntfschar))))) {
+		printf("** Native attribute extent identity mismatch\n");
+		goto out;
+	}
+	lowest = sle64_to_cpu(attr->lowest_vcn);
+	highest = sle64_to_cpu(attr->highest_vcn);
+	if (lowest < 0 || highest < lowest || vcn < lowest || vcn > highest ||
+		roothealth_attr_vcn_to_lcn(na, vcn) != lcn ||
+		!le16_to_cpu(owner->mrec->sequence_number)) {
+		printf("** Native attribute mapping mismatch: lowest %lld highest %lld "
+			"vcn %lld mapped %lld logged %lld sequence %u\n",
+			(long long)lowest, (long long)highest, (long long)vcn,
+			(long long)roothealth_attr_vcn_to_lcn(na, vcn),
+			(long long)lcn,
+			(unsigned int)le16_to_cpu(owner->mrec->sequence_number));
+		goto out;
+	}
+	memset(target, 0, sizeof(*target));
+	target->seal_version = 1U;
+	target->object = RH_WRITE_TARGET_NONRESIDENT_ATTRIBUTE;
+	target->owner_mft_record = owner->mft_no;
+	target->owner_sequence = le16_to_cpu(owner->mrec->sequence_number);
+	target->attribute_instance = le16_to_cpu(attr->instance);
+	target->attribute_type = le32_to_cpu(attr->type);
+	target->attribute_name_length = attr->name_length;
+	target->flags = RH_WRITE_TARGET_NONRESIDENT |
+		RH_WRITE_TARGET_NATIVE_LOG_DERIVED;
+	rh_sha256(attr->name_length ?
+		(const unsigned char *)attr + le16_to_cpu(attr->name_offset) :
+		(const unsigned char *)"",
+		(size_t)attr->name_length * sizeof(ntfschar),
+		target->attribute_name_hash);
+	target->lowest_vcn = lowest;
+	target->logical_vcn = vcn;
+	target->logical_offset = (u64)vcn * clustersz;
+	target->logical_length = length;
+	target->semantic_target_offset = physical_offset;
+	target->semantic_target_length = length;
+	target->lcn = lcn;
+	if (!rh_write_semantic_target_valid(kind, target, physical_offset,
+			length, 0)) {
+		printf("** Native attribute descriptor rejected: owner %llu sequence %u "
+			"instance %u type 0x%x lowest %lld vcn %lld lcn %lld offset %llu "
+			"length %zu flags 0x%x\n",
+			(unsigned long long)target->owner_mft_record,
+			(unsigned int)target->owner_sequence,
+			(unsigned int)target->attribute_instance,
+			(unsigned int)target->attribute_type,
+			(long long)target->lowest_vcn, (long long)target->logical_vcn,
+			(long long)target->lcn,
+			(unsigned long long)physical_offset, length,
+			(unsigned int)target->flags);
+		goto out;
+	}
+	result = 0;
+out:
+	if (ctx)
+		ntfs_attr_put_search_ctx(ctx);
+	return result;
+}
