+	planned_bytes = rh_replay_writer->planned_bytes;
+	excluded_count = rh_replay_writer->excluded_count;
+	raw_wal_allowed_count = rh_replay_writer->raw_wal_allowed_count;
+	writer_snapshot = *rh_replay_writer;
