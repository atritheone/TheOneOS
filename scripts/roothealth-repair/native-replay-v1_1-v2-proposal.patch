+/*
+ * Windows' NtOfsRestartUpdateRelativeDataInIndex treats the first u16 at
+ * the selected view-index entry as a relative offset, then adds the logged
+ * 32- or 64-bit delta to the field at that offset.  The undo record carries
+ * the exact modular inverse delta.  Use memcpy for both the relative field
+ * and the value because neither is guaranteed to be naturally aligned.
+ */
+static int update_relative_index_data(ntfs_volume *vol,
+		const struct ACTION_RECORD *action, char *buffer, BOOL undo,
+		BOOL allocation)
+{
+	const LOG_RECORD *record = &action->record;
+	const unsigned char *data = (const unsigned char *)record + (undo ?
+		get_undo_offset(record) : get_redo_offset(record));
+	size_t object_size = allocation ? vol->indx_record_size : mftrecsz;
+	size_t entry_at = (size_t)le16_to_cpu(record->record_offset) +
+		le16_to_cpu(record->attribute_offset);
+	size_t width = undo ? le16_to_cpu(record->undo_length) :
+		le16_to_cpu(record->redo_length);
+	size_t value_at;
+	le16 relative_le;
+
