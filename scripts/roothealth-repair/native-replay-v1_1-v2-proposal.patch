+		rh_replay_writer->planned_bytes != planned_bytes ||
+		rh_replay_writer->excluded_count != excluded_count ||
+		rh_replay_writer->raw_wal_allowed_count != raw_wal_allowed_count ||
+		rh_writer_read(rh_replay_writer, physical_offset, sizeof(current),
