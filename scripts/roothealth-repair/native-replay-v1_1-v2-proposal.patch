+static int roothealth_attribute_target_matches(ntfs_volume *vol,
+		const struct ACTION_RECORD *action,
+		const struct rh_replay_action_view *guarded)
+{
+	struct ATTR *pa;
+	ntfs_inode *ni = NULL;
+	ntfs_attr *na = NULL;
+	ATTR_TYPES type;
+	LCN expected;
+	uint64_t stream_at;
+	uint64_t stream_bytes;
