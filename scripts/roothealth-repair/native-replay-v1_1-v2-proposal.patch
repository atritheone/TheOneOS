+	if (stream_at > (uint64_t)na->allocated_size ||
+		clustersz > (uint64_t)na->allocated_size - stream_at)
+		goto out;
+	expected = roothealth_attr_vcn_to_lcn(na, (VCN)guarded->target_vcn);
+	if (expected < 0 || expected != (LCN)guarded->first_lcn)
+		goto out;
+	if (guarded->action_class == RH_REPLAY_ACTION_BITMAP_WRITE) {
+		const unsigned char *record =
+			(const unsigned char *)&action->record;
+		uint64_t first = getle32((const char *)record,
+			(int)guarded->redo_data_offset);
+		uint64_t count = getle32((const char *)record,
+			(int)guarded->redo_data_offset + 4);
