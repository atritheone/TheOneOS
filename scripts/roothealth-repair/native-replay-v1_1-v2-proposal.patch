+	intent.volume_serial = roothealth_load_u64(boot + 72U);
+	intent.record_number = record_number;
+	intent.physical_offset = physical_offset;
+	intent.mft_vcn = guarded->target_vcn;
+	intent.mft_lcn = (s64)guarded->first_lcn;
