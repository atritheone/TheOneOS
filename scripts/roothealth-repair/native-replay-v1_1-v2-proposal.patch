+	return intent && seal &&
+		seal->version == RH_REPLAY_SLOT_AUTHORITY_SEAL_VERSION &&
+		!seal->reserved32 && !seal->reserved16 && !seal->reserved_flags &&
+		!seal->reserved8 && seal->generation &&
+		seal->volume_serial == intent->volume_serial &&
+		seal->record_number == intent->record_number &&
+		seal->physical_offset == intent->physical_offset &&
+		seal->mft_vcn == intent->mft_vcn &&
+		seal->mft_lcn == intent->mft_lcn &&
+		seal->owner_sequence == intent->owner_sequence &&
+		!memcmp(seal->journal_uuid, intent->journal_uuid,
+			sizeof(seal->journal_uuid)) &&
+		!memcmp(seal->raw_before_hash, intent->raw_before_hash,
+			sizeof(seal->raw_before_hash)) &&
+		!memcmp(seal->redo_payload_hash, intent->redo_payload_hash,
+			sizeof(seal->redo_payload_hash)) &&
+		!roothealth_all_zero(seal->mft_bitmap_census_hash,
+			sizeof(seal->mft_bitmap_census_hash)) &&
+		!roothealth_all_zero(seal->namespace_census_hash,
+			sizeof(seal->namespace_census_hash)) &&
+		!roothealth_all_zero(seal->mft_extent_mapping_hash,
+			sizeof(seal->mft_extent_mapping_hash)) &&
+		seal->mft_slots_completed > intent->record_number &&
+		seal->namespace_entries_examined && seal->identity_bound == 1U &&
+		seal->mft_bitmap_bit_clear == 1U &&
+		seal->namespace_census_complete == 1U &&
+		seal->slot_unreferenced == 1U && seal->extent_mapping_exact == 1U &&
+		seal->target_outside_wal == 1U &&
+		seal->target_outside_protected == 1U;
+}
