+static int roothealth_authorize_initialize_slot(ntfs_volume *vol,
+		const struct ACTION_RECORD *action,
+		const struct rh_replay_action_view *guarded, uint64_t record_number,
+		const unsigned char *raw_before)
+{
+	const struct rh_replay_slot_authority_provider *provider =
+		rh_replay_slot_authority_provider;
+	struct rh_replay_initialize_intent intent;
+	struct rh_replay_slot_authority_seal seal;
+	struct rh_writer writer_snapshot;
+	unsigned char current[1024];
+	unsigned char boot[512];
+	unsigned char bitmap;
+	size_t operation_count, excluded_count, raw_wal_allowed_count;
+	uint64_t planned_bytes, physical_offset;
+	int result;
+
+	if (!vol || !action || !guarded || !raw_before || !provider ||
+		!rh_replay_writer || guarded->target_object_size != sizeof(current) ||
+		guarded->redo_length != sizeof(current) ||
+		guarded->first_lcn > UINT64_MAX / clustersz ||
+		guarded->target_slice_offset > clustersz ||
+		sizeof(current) > clustersz - guarded->target_slice_offset)
+		return -1;
+	physical_offset = guarded->first_lcn * clustersz +
+		guarded->target_slice_offset;
+	if (physical_offset > rh_replay_writer->device_size ||
+		sizeof(current) > rh_replay_writer->device_size - physical_offset ||
+		rh_writer_range_excluded(rh_replay_writer, physical_offset,
+			sizeof(current)) ||
