+	if (!vol || !action || !guarded || guarded->lcn_count != 1U)
+		return -1;
+	pa = findattrentry(le16_to_cpu(action->record.target_attribute));
+	if (!pa || !pa->type || !pa->reference || (pa->namelen & 1U))
+		return -1;
+	type = (ATTR_TYPES)pa->type;
+	is_i30 = pa->namelen == 8U &&
+		le16_to_cpu(pa->name[0]) == '$' &&
+		le16_to_cpu(pa->name[1]) == 'I' &&
+		le16_to_cpu(pa->name[2]) == '3' &&
+		le16_to_cpu(pa->name[3]) == '0';
