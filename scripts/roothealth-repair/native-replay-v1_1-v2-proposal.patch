+			return -1;
+	} else if (guarded->action_class == RH_REPLAY_ACTION_INDX_WRITE) {
+		if (type != AT_INDEX_ALLOCATION ||
+			pa->bytes_per_index != vol->indx_record_size)
+			return -1;
+		if ((guarded->redo_operation == UpdateFileNameAllocation && !is_i30) ||
+			(guarded->redo_operation == UpdateRecordDataAllocation && is_i30) ||
+			(guarded->redo_operation == UpdateRelativeDataInIndex2 && is_i30))
+			return -1;
+	} else if (guarded->action_class != RH_REPLAY_ACTION_RAW_WRITE &&
+		guarded->action_class != RH_REPLAY_ACTION_BITMAP_WRITE) {
+		return -1;
+	} else if (type == AT_INDEX_ALLOCATION) {
+		return -1;
+	}
+	if (guarded->action_class == RH_REPLAY_ACTION_RAW_WRITE &&
+		(type == AT_BITMAP || MREF(pa->reference) == FILE_MFT ||
+		 MREF(pa->reference) == FILE_MFTMirr ||
+		 MREF(pa->reference) == FILE_Bitmap))
+		return -1;
+	if (guarded->action_class == RH_REPLAY_ACTION_BITMAP_WRITE &&
+		type != AT_BITMAP &&
+		!(type == AT_DATA && MREF(pa->reference) == FILE_Bitmap))
+		return -1;
