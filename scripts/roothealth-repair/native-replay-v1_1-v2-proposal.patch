+static int roothealth_guard_storage(ntfs_volume *vol, const LOG_RECORD *logr,
+		u32 protected_size, struct rh_replay_action_view *view)
+{
+	struct rh_replay_geometry geometry;
+	struct rh_replay_action_view local_view;
+	u32 client_length;
+	size_t record_size;
+
+	if (!vol || !logr)
+		return -1;
+	client_length = le32_to_cpu(logr->client_data_length);
+	if (client_length > RH_REPLAY_MAX_ACTION_SIZE - LOG_RECORD_HEAD_SZ)
+		return -1;
+	record_size = (size_t)client_length + LOG_RECORD_HEAD_SZ;
+	memset(&geometry, 0, sizeof(geometry));
+	geometry.page_size = blocksz;
+	geometry.cluster_size = clustersz;
+	geometry.mft_record_size = mftrecsz;
+	geometry.index_record_size = vol->indx_record_size;
+	geometry.logfile_size = logfilesz;
+	geometry.volume_clusters = vol->nr_clusters;
+	geometry.sequence_bits = le32_to_cpu(restart.seq_number_bits);
+	geometry.client_sequence = le16_to_cpu(client.seq_number);
+	geometry.client_index = 0U;
+	if (!view)
+		view = &local_view;
+	if (rh_replay_guard_action((const unsigned char *)logr, record_size,
+			&geometry, RH_REPLAY_SOURCE_UNKNOWN, view))
+		return -1;
+	if (protected_size && protected_size != view->target_object_size)
+		return -1;
+	return 0;
+}
