+
+	if (!record || available < 48U || memcmp(record, "FILE", 4) ||
+		roothealth_load_u32(record + 28) != storage_size ||
+		(expected_record != UINT64_MAX &&
+		 roothealth_load_u32(record + 44) != expected_record) ||
+		!roothealth_load_u16(record + 16) ||
+		(require_in_use && !(roothealth_load_u16(record + 22) & 1U)))
+		return -1;
+	usa_offset = roothealth_load_u16(record + 4);
+	usa_count = roothealth_load_u16(record + 6);
+	if (usa_count != storage_size / bytespersect + 1U ||
+		!roothealth_range(available, usa_offset, (size_t)usa_count * 2U))
+		return -1;
+	offset = roothealth_load_u16(record + 20);
+	bytes_in_use = roothealth_load_u32(record + 24);
+	if ((offset & 7U) || offset < 48U || bytes_in_use > available ||
+		bytes_in_use > storage_size || bytes_in_use < offset + 8U)
+		return -1;
+	while (roothealth_range(bytes_in_use, offset, 8U)) {
+		struct roothealth_attr_view local;
+		u32 type = roothealth_load_u32(record + offset);
+
+		if (type == 0xffffffffU) {
+			if (offset + 8U != bytes_in_use || !found)
+				return -1;
+			return 0;
+		}
+		if (roothealth_validate_attribute(record + offset,
+				bytes_in_use - offset, 0, &local))
+			return -1;
+		local.offset = offset;
+		if (offset == requested_attribute) {
+			if (requested)
+				*requested = local;
+			found = 1;
+		}
+		offset += local.length;
+	}
+	return -1;
+}
+
+static int roothealth_validate_index_entry(const unsigned char *entry,
+		size_t available, size_t *entry_length, int require_node)
+{
+	u16 length, key_length, flags;
+	size_t payload;
+
+	if (!entry || available < 16U)
+		return -1;
+	length = roothealth_load_u16(entry + 8);
+	key_length = roothealth_load_u16(entry + 10);
+	flags = roothealth_load_u16(entry + 12);
+	if (length < 16U || (length & 7U) || length > available ||
+		(flags & ~3U))
+		return -1;
+	payload = length - 16U;
+	if (flags & 1U) {
+		if (payload < 8U)
+			return -1;
+		payload -= 8U;
+	} else if (require_node) {
+		return -1;
+	}
+	if (key_length > payload)
+		return -1;
+	if (entry_length)
+		*entry_length = length;
+	return 0;
+}
+
+static int roothealth_validate_index(const unsigned char *index, size_t size,
+		size_t requested_entry, size_t *requested_length)
+{
+	size_t offset, end;
+	u32 entries_offset, index_length, allocated;
+	u16 usa_offset, usa_count;
+	int found = requested_entry == SIZE_MAX;
+
+	if (!index || size != RH_REPLAY_PAGE_SIZE || memcmp(index, "INDX", 4))
+		return -1;
+	usa_offset = roothealth_load_u16(index + 4);
+	usa_count = roothealth_load_u16(index + 6);
+	if (usa_count != size / bytespersect + 1U ||
+		!roothealth_range(size, usa_offset, (size_t)usa_count * 2U))
+		return -1;
+	entries_offset = roothealth_load_u32(index + 24);
+	index_length = roothealth_load_u32(index + 28);
+	allocated = roothealth_load_u32(index + 32);
+	if (allocated != size - 24U || entries_offset > index_length ||
+		index_length > allocated || (entries_offset & 7U) ||
+		(index_length & 7U) || !roothealth_range(size, 24U, index_length))
+		return -1;
+	offset = 24U + entries_offset;
+	end = 24U + index_length;
+	while (offset < end) {
+		size_t length;
+		u16 flags;
+
+		if (roothealth_validate_index_entry(index + offset, end - offset,
+				&length, 0))
+			return -1;
+		flags = roothealth_load_u16(index + offset + 12);
+		if (offset == requested_entry) {
+			if (requested_length)
+				*requested_length = length;
+			found = 1;
+		}
+		offset += length;
+		if (flags & 2U)
+			return (offset == end && found) ? 0 : -1;
+	}
+	return -1;
+}
+
+struct roothealth_index_root_view {
+	size_t attribute_offset;
+	size_t value_offset;
+	size_t entries_offset;
+	size_t entries_end;
+	u32 indexed_type;
+};
+
+static int roothealth_validate_index_root(const unsigned char *record,
+		size_t record_size, u64 record_number, size_t attribute_offset,
+		size_t requested_entry, size_t *requested_length,
+		struct roothealth_index_root_view *view)
+{
+	struct roothealth_attr_view attr;
+	size_t root_at, header_at, offset, end;
+	u32 entries_offset, index_length, allocated, indexed_type;
+	u8 flags;
+	int found = requested_entry == SIZE_MAX;
+
+	if (roothealth_validate_mft(record, record_size, record_size,
+			record_number, 1, attribute_offset, &attr) || attr.nonresident ||
+		attr.type != 0x90U || attr.value_length < 32U)
+		return -1;
+	root_at = attr.offset + attr.value_offset;
+	if (!roothealth_range(record_size, root_at, attr.value_length))
+		return -1;
+	indexed_type = roothealth_load_u32(record + root_at);
+	if ((indexed_type && ((indexed_type & 0xfU) || indexed_type > 0x100U)) ||
+		roothealth_load_u32(record + root_at + 8U) != RH_REPLAY_PAGE_SIZE ||
+		record[root_at + 12U] != 1U ||
+		!roothealth_all_zero(record + root_at + 13U, 3U))
+		return -1;
+	header_at = root_at + 16U;
+	entries_offset = roothealth_load_u32(record + header_at);
+	index_length = roothealth_load_u32(record + header_at + 4U);
+	allocated = roothealth_load_u32(record + header_at + 8U);
+	flags = record[header_at + 12U];
+	if (entries_offset < 16U || (entries_offset & 7U) ||
+		index_length < entries_offset || (index_length & 7U) ||
+		allocated != index_length || flags > 1U ||
+		!roothealth_all_zero(record + header_at + 13U, 3U) ||
+		attr.value_length != 16U + index_length)
+		return -1;
+	offset = header_at + entries_offset;
+	end = header_at + index_length;
+	if (end > root_at + attr.value_length)
+		return -1;
+	while (offset < end) {
+		size_t length;
+		u16 entry_flags;
+
+		if (roothealth_validate_index_entry(record + offset, end - offset,
+				&length, 0))
+			return -1;
+		entry_flags = roothealth_load_u16(record + offset + 12U);
+		if ((entry_flags & 2U) && roothealth_load_u16(record + offset + 10U))
+			return -1;
+		if (offset == requested_entry) {
+			if (requested_length)
+				*requested_length = length;
+			found = 1;
+		}
+		offset += length;
+		if (entry_flags & 2U) {
+			if (offset != end || !found)
+				return -1;
+			if (view) {
+				view->attribute_offset = attr.offset;
+				view->value_offset = root_at;
+				view->entries_offset = header_at + entries_offset;
+				view->entries_end = end;
+				view->indexed_type = indexed_type;
+			}
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static int roothealth_validate_sizes(const unsigned char *data, size_t length)
+{
+	u64 allocated, file_size, initialized;
+
+	if (!data || (length != 24U && length != 32U))
+		return -1;
+	allocated = roothealth_load_u64(data);
+	file_size = roothealth_load_u64(data + 8);
+	initialized = roothealth_load_u64(data + 16);
+	return (initialized <= file_size && file_size <= allocated) ? 0 : -1;
+}
+
+static int roothealth_validate_mft_tail(const unsigned char *bytes,
+		size_t length)
+{
+	size_t offset = 0;
+
+	if (!bytes || length < 8U || (length & 7U))
+		return -1;
+	while (roothealth_range(length, offset, 8U)) {
+		u32 type = roothealth_load_u32(bytes + offset);
+		struct roothealth_attr_view attr;
+
+		if (type == 0xffffffffU)
+			return offset + 8U == length &&
+				roothealth_all_zero(bytes + offset + 4U, 4U) ? 0 : -1;
+		if (roothealth_validate_attribute(bytes + offset, length - offset,
+				0, &attr))
+			return -1;
+		offset += attr.length;
+	}
+	return -1;
+}
+
+static u64 roothealth_action_record_number(
+		const struct rh_replay_action_view *guarded)
+{
+	return guarded->target_vcn * ((u64)clustersz / mftrecsz) +
+		guarded->target_slice_offset / mftrecsz;
+}
+
+static int roothealth_validate_semantic_target(const struct ACTION_RECORD *action,
+		const unsigned char *target,
+		const struct rh_replay_action_view *guarded, int allow_blank_initialize,
+		int validate_operation)
+{
+	const unsigned char *record = (const unsigned char *)&action->record;
+	const unsigned char *redo = record + guarded->redo_data_offset;
+	const unsigned char *undo = record + guarded->undo_data_offset;
+	struct roothealth_attr_view attr;
+	struct roothealth_index_root_view root_view;
+	size_t target_at = (size_t)guarded->record_offset +
+		guarded->attribute_offset;
+	size_t entry_length;
+	u64 record_number;
+
+	if (!action || !target || !guarded)
+		return -1;
+	switch (guarded->action_class) {
+	case RH_REPLAY_ACTION_MFT_WRITE:
+		record_number = roothealth_action_record_number(guarded);
+		if (allow_blank_initialize && guarded->redo_operation ==
+				InitializeFileRecordSegment) {
+			if (roothealth_validate_mft(redo, guarded->redo_length,
+					guarded->target_object_size, record_number, 0,
+					SIZE_MAX, NULL))
+				return -1;
+		} else if (roothealth_validate_mft(target,
+				guarded->target_object_size, guarded->target_object_size,
+				record_number,
+				guarded->redo_operation == DeallocateFileRecordSegment ? 0 : 1,
+				SIZE_MAX, NULL)) {
+			return -1;
+		}
+		break;
+	case RH_REPLAY_ACTION_INDX_WRITE:
+		if (roothealth_validate_index(target, guarded->target_object_size,
+				SIZE_MAX, NULL))
+			return -1;
+		break;
+	case RH_REPLAY_ACTION_RAW_WRITE:
+	case RH_REPLAY_ACTION_BITMAP_WRITE:
+		break;
+	default:
+		return -1;
+	}
+	switch (guarded->redo_operation) {
+	case AddIndexEntryRoot:
+	case DeleteIndexEntryRoot:
+	case SetIndexEntryVcnRoot:
+	case UpdateFileNameRoot:
+	case UpdateRecordDataRoot:
+	case UpdateRelativeDataInIndex:
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, SIZE_MAX, NULL, NULL))
+			return -1;
+		break;
+	default:
+		break;
+	}
+	if (!validate_operation)
+		return 0;
+
+	switch (guarded->redo_operation) {
+	case InitializeFileRecordSegment:
+		return 0;
+	case DeallocateFileRecordSegment: {
+		u16 target_flags = roothealth_load_u16(target + 22U);
+		u16 target_sequence = roothealth_load_u16(target + 16U);
+		u16 undo_flags = roothealth_load_u16(undo + 22U);
+		u16 undo_sequence = roothealth_load_u16(undo + 16U);
+
+		if (guarded->redo_length || guarded->undo_length != 24U ||
+			target_at || memcmp(undo, "FILE", 4) ||
+			roothealth_load_u16(undo + 4U) !=
+				roothealth_load_u16(target + 4U) ||
+			roothealth_load_u16(undo + 6U) !=
+				roothealth_load_u16(target + 6U) ||
+			!undo_sequence || undo_sequence == UINT16_MAX ||
+			!(undo_flags & MFT_RECORD_IN_USE) ||
+			roothealth_load_u16(undo + 18U) !=
+				roothealth_load_u16(target + 18U) ||
+			roothealth_load_u16(undo + 20U) !=
+				roothealth_load_u16(target + 20U))
+			return -1;
+		if (target_flags & MFT_RECORD_IN_USE) {
+			if (target_sequence != undo_sequence ||
+				target_flags != undo_flags)
+				return -1;
+		} else if (target_sequence != (u16)(undo_sequence + 1U) ||
+			target_flags != (u16)(undo_flags & ~MFT_RECORD_IN_USE)) {
+			return -1;
+		}
+		return 0;
+	}
+	case WriteEndofFileRecordSegment: {
+		size_t used = roothealth_load_u32(target + 24U);
+
+		if (guarded->attribute_offset || (guarded->record_offset & 7U) ||
+			guarded->record_offset < roothealth_load_u16(target + 20U) ||
+			guarded->record_offset > used - 8U ||
+			roothealth_validate_mft_tail(target + guarded->record_offset,
+				used - guarded->record_offset) ||
+			roothealth_validate_mft_tail(redo, guarded->redo_length) ||
+			roothealth_validate_mft_tail(undo, guarded->undo_length))
+			return -1;
+		return 0;
+	}
+	case CreateAttribute:
+	case DeleteAttribute: {
+		const unsigned char *payload = guarded->redo_operation ==
+			CreateAttribute ? redo : undo;
+		size_t payload_length = guarded->redo_operation ==
+			CreateAttribute ? guarded->redo_length : guarded->undo_length;
+		size_t bytes_in_use = roothealth_load_u32(target + 24);
+
+		if ((target_at & 7U) || target_at < roothealth_load_u16(target + 20) ||
+			target_at > bytes_in_use - 8U ||
+			roothealth_validate_attribute(payload, payload_length, 1, NULL))
+			return -1;
+		if (guarded->redo_operation == DeleteAttribute &&
+			(roothealth_validate_mft(target, guarded->target_object_size,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded), 1,
+				target_at, &attr) || attr.length != payload_length))
+			return -1;
+		return 0;
+	}
+	case UpdateResidentValue:
+		if (roothealth_validate_mft(target, guarded->target_object_size,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded), 1,
+				guarded->record_offset, &attr) || attr.nonresident ||
+			target_at < attr.offset + attr.value_offset ||
+			!roothealth_range(attr.offset + attr.length, target_at,
+				guarded->redo_length) ||
+			target_at + guarded->redo_length >
+				attr.offset + attr.value_offset + attr.value_length)
+			return -1;
+		return 0;
+	case UpdateNonResidentValue:
+		return 0;
+	case UpdateMappingPairs:
+		if (roothealth_validate_mft(target, guarded->target_object_size,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded), 1,
+				guarded->record_offset, &attr) || !attr.nonresident ||
+				guarded->attribute_offset != attr.mapping_offset ||
+			roothealth_validate_mapping_pairs(redo, guarded->redo_length) ||
+			roothealth_validate_mapping_pairs(undo, guarded->undo_length))
+			return -1;
+		return 0;
+	case SetNewAttributeSizes:
+		if (guarded->attribute_offset ||
+			roothealth_validate_mft(target, guarded->target_object_size,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded), 1,
+				guarded->record_offset, &attr) || !attr.nonresident ||
+			roothealth_validate_sizes(redo, guarded->redo_length) ||
+			roothealth_validate_sizes(undo, guarded->undo_length))
+			return -1;
+		return 0;
+	case AddIndexEntryAllocation:
+	case DeleteIndexEntryAllocation: {
+		const unsigned char *payload = guarded->redo_operation ==
+			AddIndexEntryAllocation ? redo : undo;
+		size_t payload_length = guarded->redo_operation ==
+			AddIndexEntryAllocation ? guarded->redo_length :
+			guarded->undo_length;
+
+		if (guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			roothealth_validate_index_entry(payload, payload_length,
+				&entry_length, 0) || entry_length != payload_length)
+			return -1;
+		return 0;
+	}
+	case AddIndexEntryRoot:
+	case DeleteIndexEntryRoot: {
+		const unsigned char *payload = guarded->redo_operation ==
+			AddIndexEntryRoot ? redo : undo;
+		size_t payload_length = guarded->redo_operation ==
+			AddIndexEntryRoot ? guarded->redo_length : guarded->undo_length;
+		size_t current_length;
+
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &current_length,
+				&root_view) ||
+			roothealth_validate_index_entry(payload, payload_length,
+				&entry_length, 0) || entry_length != payload_length ||
+			(roothealth_load_u16(payload + 12U) & 2U))
+			return -1;
+		if (guarded->redo_operation == DeleteIndexEntryRoot &&
+			current_length != payload_length)
+			return -1;
+		return 0;
+	}
+	case WriteEndOfIndexBuffer:
+		if (guarded->record_offset || (target_at & 7U) ||
+			!roothealth_range(guarded->target_object_size, target_at,
+				guarded->redo_length))
+			return -1;
+		return 0;
+	case SetIndexEntryVcnAllocation:
+		if (guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			roothealth_validate_index_entry(target + guarded->attribute_offset,
+				entry_length, NULL, 1))
+			return -1;
+		return 0;
+	case SetIndexEntryVcnRoot:
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &entry_length,
+				&root_view) ||
+			roothealth_validate_index_entry(target + target_at,
+				entry_length, NULL, 1))
+			return -1;
+		return 0;
+	case UpdateFileNameRoot:
+		if (guarded->redo_length != 56U || guarded->undo_length != 56U ||
+			roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &entry_length,
+				&root_view) || root_view.indexed_type != 0x30U ||
+			(roothealth_load_u16(target + target_at + 12U) & 2U) ||
+			roothealth_load_u16(target + target_at + 10U) < 66U ||
+			!roothealth_range(entry_length, 24U, 56U))
+			return -1;
+		return 0;
+	case UpdateFileNameAllocation:
+		if (guarded->redo_length != 56U || guarded->undo_length != 56U ||
+			guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			(roothealth_load_u16(target + guarded->attribute_offset + 12U) & 2U) ||
+			roothealth_load_u16(target + guarded->attribute_offset + 10U) < 66U ||
+			!roothealth_range(entry_length, 24U, 56U))
+			return -1;
+		return 0;
+	case SetBitsInNonResidentBitMap:
+	case ClearBitsInNonResidentBitMap:
+		return 0;
+	case UpdateRecordDataAllocation:
+	{
+		u16 data_offset, data_length;
+
+		if (guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			guarded->redo_length != guarded->undo_length ||
+			!guarded->redo_length)
+			return -1;
+		data_offset = roothealth_load_u16(target + guarded->attribute_offset);
+		data_length = roothealth_load_u16(target + guarded->attribute_offset + 2U);
+		if (data_offset < 16U || data_offset > entry_length ||
+			data_length > entry_length - data_offset ||
+			guarded->redo_length > data_length)
+			return -1;
+		return 0;
+	}
+	case UpdateRecordDataRoot: {
+		u16 data_offset, data_length;
+
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &entry_length,
+				&root_view) || root_view.indexed_type ||
+			(guarded->redo_length != guarded->undo_length) ||
+			!guarded->redo_length)
+			return -1;
+		data_offset = roothealth_load_u16(target + target_at);
+		data_length = roothealth_load_u16(target + target_at + 2U);
+		if (data_offset < 16U || data_offset > entry_length ||
+			data_length > entry_length - data_offset ||
+			guarded->redo_length > data_length)
+			return -1;
+		return 0;
+	}
+	case UpdateRelativeDataInIndex: {
+		u16 data_offset, data_length;
+
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &entry_length,
+				&root_view) || root_view.indexed_type ||
+			(guarded->redo_length != 4U && guarded->redo_length != 8U) ||
+			guarded->undo_length != guarded->redo_length)
+			return -1;
+		data_offset = roothealth_load_u16(target + target_at);
+		data_length = roothealth_load_u16(target + target_at + 2U);
+		if (data_offset < 16U || data_offset > entry_length ||
+			data_length > entry_length - data_offset ||
+			guarded->redo_length > data_length)
+			return -1;
+		return 0;
+	}
+	case UpdateRelativeDataInIndex2: {
+		u16 data_offset, data_length;
+
+		if (guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			(guarded->redo_length != 4U && guarded->redo_length != 8U) ||
+			guarded->undo_length != guarded->redo_length)
+			return -1;
+		data_offset = roothealth_load_u16(target + guarded->attribute_offset);
