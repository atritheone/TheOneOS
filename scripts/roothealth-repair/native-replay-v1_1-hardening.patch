+#define TABLE_HEADER 24U
+#define TABLE_ENTRY 40U
+#define ALLOCATED UINT32_C(0xffffffff)
+
+static unsigned int failures;
+
+static void expect(int condition, const char *label)
+{
+	if (!condition) {
+		fprintf(stderr, "FAIL: %s\n", label);
+		++failures;
+	}
