+	wr16(open_record + 52, 0x28);
+	wr16(open_record + 54, 44);
+	wr16(open_record + 60, TABLE_HEADER);
+	wr32(open_record + 80, ALLOCATED);
+	wr64(open_record + 88, (UINT64_C(1) << 48) | 0U);
