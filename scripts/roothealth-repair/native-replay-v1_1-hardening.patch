+			return 0;
+		}
+		if ((bytes & 1U) || bytes > 510U ||
+			bytes > length - offset - 4U || !findattrentry(key))
+			return -1;
+		pa = getattrentry(key, bytes);
+		if (!pa)
+			return -1;
+		pa->namelen = bytes;
+		memcpy(pa->name, names + offset + 4U, bytes);
+		offset += 4U + bytes;
+	}
+	return -1;
+}
