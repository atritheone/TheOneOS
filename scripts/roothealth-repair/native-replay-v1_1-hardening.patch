+
+	for (op = 0; op < 38; ++op) {
+		memcpy(changed, valid, sizeof(valid));
+		wr16(changed + 48, (uint16_t)op);
+		if (op != 7)
+			expect(rh_replay_guard_action(changed, sizeof(valid), &geometry,
+				0x5040, NULL), "every unqualified opcode rejected");
