+static int update_record_data(ntfs_volume *vol,
+		const struct ACTION_RECORD *action, char *buffer, BOOL undo,
+		BOOL allocation)
+{
+	const LOG_RECORD *record = &action->record;
+	const char *data = (const char *)record + (undo ?
+		get_undo_offset(record) : get_redo_offset(record));
+	const char *expected = (const char *)record + (undo ?
+		get_redo_offset(record) : get_undo_offset(record));
+	u32 entry_at = le16_to_cpu(record->record_offset) +
+		le16_to_cpu(record->attribute_offset);
+	INDEX_ENTRY *entry;
+	u32 entry_length, data_offset, length, target;
+
+	if (!buffer || entry_at > (allocation ? vol->indx_record_size : mftrecsz) -
+			sizeof(INDEX_ENTRY_HEADER))
+		return 1;
+	entry = (INDEX_ENTRY *)(buffer + entry_at);
+	entry_length = le16_to_cpu(entry->length);
+	data_offset = le16_to_cpu(entry->data_offset);
+	length = undo ? le16_to_cpu(record->undo_length) :
+		le16_to_cpu(record->redo_length);
+	if (entry_length < sizeof(INDEX_ENTRY_HEADER) ||
+		data_offset > entry_length || length > entry_length - data_offset)
+		return 1;
+	target = entry_at + data_offset;
+	/*
+	 * View-index record data is not required to be eight-byte sized.  Do not
+	 * route it through the legacy resident-value helper, which rejects valid
+	 * four-byte view data and treats an unexpected before-image as success.
+	 * The hardened path accepts only the exact logged before or after image.
+	 */
+	if (!memcmp(buffer + target, data, length))
+		return 0;
+	if (memcmp(buffer + target, expected, length))
+		return 1;
+	memcpy(buffer + target, data, length);
+	return write_protected(vol, &action->record, buffer,
+		allocation ? vol->indx_record_size : mftrecsz);
+}
