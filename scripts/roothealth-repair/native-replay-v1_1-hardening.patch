+static int roothealth_preflight_sequence(ntfs_volume *vol,
+		const struct ACTION_RECORD *firstaction)
+{
+	struct roothealth_preflight_target *targets = NULL;
+	const struct ACTION_RECORD *action;
+	const struct ACTION_RECORD *lastaction = NULL;
+	struct rh_replay_geometry geometry;
+	int err = -1;
+
+	memset(&geometry, 0, sizeof(geometry));
+	geometry.page_size = blocksz;
+	geometry.cluster_size = clustersz;
+	geometry.mft_record_size = mftrecsz;
+	geometry.index_record_size = vol->indx_record_size;
+	geometry.logfile_size = logfilesz;
+	geometry.volume_clusters = vol->nr_clusters;
+	geometry.sequence_bits = le32_to_cpu(restart.seq_number_bits);
+	geometry.client_sequence = le16_to_cpu(client.seq_number);
+	geometry.client_index = 0U;
+	for (action = firstaction; action; action = action->next) {
+		struct rh_replay_action_view guarded;
+		struct roothealth_preflight_target *target;
+		size_t record_size = (size_t)le32_to_cpu(
+			action->record.client_data_length) + LOG_RECORD_HEAD_SZ;
+
+		lastaction = action;
+		if (rh_replay_guard_action((const unsigned char *)&action->record,
+				record_size, &geometry, RH_REPLAY_SOURCE_UNKNOWN, &guarded))
+			goto out;
+		if (!(action->flags & ACTION_TO_REDO))
+			continue;
+		target = roothealth_get_preflight_target(vol, action, &guarded,
+			&targets);
+		if (!target || roothealth_semantic_cycle(vol, action, target->bytes,
+				&guarded))
+			goto out;
+		roothealth_semantic_preflight = 1;
+		if (distribute_redos(vol, action, (char *)target->bytes)) {
+			roothealth_semantic_preflight = 0;
+			goto out;
+		}
+		roothealth_semantic_preflight = 0;
+	}
+	for (action = lastaction; action; action = action->prev) {
+		struct rh_replay_action_view guarded;
+		struct roothealth_preflight_target *target;
+		size_t record_size;
+
+		if (!(action->flags & ACTION_TO_UNDO))
+			continue;
+		record_size = (size_t)le32_to_cpu(action->record.client_data_length) +
+			LOG_RECORD_HEAD_SZ;
+		if (rh_replay_guard_action((const unsigned char *)&action->record,
+				record_size, &geometry, RH_REPLAY_SOURCE_UNKNOWN, &guarded))
+			goto out;
+		target = roothealth_get_preflight_target(vol, action, &guarded,
+			&targets);
+		if (!target)
+			goto out;
+		roothealth_semantic_preflight = 1;
+		if (distribute_undos(vol, action, (char *)target->bytes)) {
+			roothealth_semantic_preflight = 0;
+			goto out;
+		}
+		roothealth_semantic_preflight = 0;
+	}
+	err = 0;
+out:
+	roothealth_semantic_preflight = 0;
+	roothealth_free_preflight_targets(targets);
+	return err;
 }
 
