+				le32_to_cpu(entry->mft_record_number) != record_number ||
+				!le16_to_cpu(entry->sequence_number) ||
+				!(le16_to_cpu(entry->flags) & MFT_RECORD_IN_USE)) {
+				free(target->bytes);
+				target->bytes = NULL;
+			}
+		}
+		break;
+	}
+	case RH_REPLAY_ACTION_INDX_WRITE:
+		target->bytes = (unsigned char *)read_protected(vol, record,
+			vol->indx_record_size, TRUE);
+		break;
+	case RH_REPLAY_ACTION_RAW_WRITE:
+	case RH_REPLAY_ACTION_BITMAP_WRITE:
+		target->bytes = (unsigned char *)read_raw(vol, record);
+		break;
+	default:
+		goto fail;
+	}
+	if (!target->bytes)
+		goto fail;
+	target->next = *targets;
+	*targets = target;
+	return target;
+fail:
+	free(target->bytes);
+	free(target);
+	return NULL;
+}
