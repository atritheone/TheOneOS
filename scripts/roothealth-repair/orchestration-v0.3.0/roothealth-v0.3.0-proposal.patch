-static int report_printf(int fd, const char *format, ...)
-{
-	va_list ap;
-	char *buffer = NULL;
-	int length;
-
-	va_start(ap, format);
-	length = vasprintf(&buffer, format, ap);
-	va_end(ap);
-	if (length < 0)
-		return -1;
-	if (report_write_all(fd, buffer, (size_t)length)) {
-		free(buffer);
-		return -1;
-	}
-	free(buffer);
-	return 0;
-}
