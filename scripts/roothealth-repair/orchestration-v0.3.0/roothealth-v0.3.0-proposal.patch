-static int report_write_all(int fd, const void *buffer, size_t length)
-{
-	const unsigned char *p = buffer;
-
-	while (length) {
-		ssize_t written = write(fd, p, length);
-		if (written < 0) {
-			if (errno == EINTR)
-				continue;
-			return -1;
-		}
-		if (!written) {
-			errno = EIO;
-			return -1;
-		}
-		p += written;
-		length -= (size_t)written;
-	}
-	return 0;
-}
