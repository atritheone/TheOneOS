index 0000000..5f78bb5
--- /dev/null
+++ b/src/roothealth_orchestrator.c
@@ -0,0 +1,1140 @@
+/* ROOTHEALTH_REPAIR_ROLE(ORCHESTRATOR) ROOTHEALTH_IO_ROLE(DIAGNOSTIC) */
+#include "config.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <getopt.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdint.h>
