-static int parse_serial(const char *text, uint64_t *serial)
-{
-	uint64_t value = 0;
-	size_t digits = 0;
-	const unsigned char *p;
-	unsigned int nibble;
-
-	if (!text || !*text)
-		return -1;
-	p = (const unsigned char *)text;
-	if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X'))
-		p += 2;
-	for (; *p; p++) {
-		if (*p == '-')
-			continue;
-		if (*p >= '0' && *p <= '9')
-			nibble = *p - '0';
-		else if (*p >= 'a' && *p <= 'f')
-			nibble = *p - 'a' + 10;
-		else if (*p >= 'A' && *p <= 'F')
-			nibble = *p - 'A' + 10;
-		else
-			return -1;
-		if (digits++ >= 16)
-			return -1;
-		value = (value << 4) | nibble;
-	}
-	if (digits != 16 || !value)
-		return -1;
-	*serial = value;
-	return 0;
-}
