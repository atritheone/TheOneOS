+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "roothealth_policy.h"
+
+/*
+ * Private output of an exhaustive diagnostic pass.  Repair adapters do not
+ * include this header and cannot manufacture individual policy facts.
+ */
