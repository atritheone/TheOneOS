+	if ((key <= 65535) && !(key & 3)) {
+		pa = getattrentry(key,0);
+		if (pa) {
+			if (!pa->namelen)
+				p = "Unnamed";
+			else {
+				p = name;
+					/* Assume ascii for now */
+				for (i=0; 2*i<pa->namelen; i++)
+					name[i] = le16_to_cpu(pa->name[i]);
+				name[i] = 0;
+			}
+		} else
+			p = "Undefined";
+	} else
+		p = "Invalid";
+	return (p);
+}
