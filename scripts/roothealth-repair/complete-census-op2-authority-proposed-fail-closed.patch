+	qsort(runs, wal->run_count, sizeof(*runs), rh_wal_run_device_compare);
+	backup_offset = wal->writer->device_size - wal->sector_size;
+	for (i = 0; i < wal->writer->excluded_count; i++) {
+		if (i && rh_run_overlap(excluded[i - 1U].offset,
