+ROOTHEALTH_PROBLEM_POLICY(PR_PRE_SCAN_MFT, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_RESET_LOG_FILE, DENY)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_FLAG_MISMATCH, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_DIR_NONZERO_SIZE, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_REPARSE_TAG_MISMATCH, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_ALLOCATED_SIZE_MISMATCH, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_DATA_SIZE_MISMATCH, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_DIR_FLAG_MISMATCH_IDX_FN, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_DIR_FLAG_MISMATCH_MFT_FN, DENY)
+ROOTHEALTH_PROBLEM_POLICY(PR_DIR_IR_NOT_EXIST, DENY)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_FLAG_MISMATCH_IDX_FN, CONDITIONAL)
