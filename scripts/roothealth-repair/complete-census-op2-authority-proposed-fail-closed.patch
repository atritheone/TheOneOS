@@ -0,0 +1,484 @@
+/* ROOTHEALTH_REPAIR_ROLE(DIAGNOSTIC) */
+#include "config.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "device.h"
+#include "endians.h"
+#include "layout.h"
