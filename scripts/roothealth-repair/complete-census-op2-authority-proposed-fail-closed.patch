+ROOTHEALTH_PROBLEM_POLICY(PR_ATTR_LOWEST_VCN_IS_NOT_ZERO, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_ATTR_NON_RESIDENT_SIZES_MISMATCH, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_ATTR_VALUE_OFFSET_BADLY_ALIGNED, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_ATTR_VALUE_OFFSET_CORRUPTED, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_ATTR_NAME_OFFSET_CORRUPTED, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_ATTR_LENGTH_CORRUPTED, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_ATTR_FN_FLAG_MISMATCH, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_IA_MAGIC_CORRUPTED, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_MAGIC_CORRUPTED, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_SIZE_CORRUPTED, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_ATTR_OFFSET_CORRUPTED, DENY)
+ROOTHEALTH_PROBLEM_POLICY(PR_MFT_BIU_CORRUPTED, CONDITIONAL)
+ROOTHEALTH_PROBLEM_POLICY(PR_IE_ZERO_LENGTH, CONDITIONAL)
