+static const char *commitment(u64 lsn)
+{
+	const char *commit;
+	s64 diff;
+
+	/* Computations assume lsn could wraparound, they probably never do */
+	diff = lsn - synced_lsn;
+	if (diff <= 0)
+		commit = "synced";
+	else {
+		diff = lsn - committed_lsn;
+		if (diff <= 0)
+			commit = "committed";
+		else {
+			/* may find lsn from older session */
+			diff = lsn - latest_lsn;
+			if (diff <= 0)
+				commit = "*uncommitted*";
+			else
+				commit = "*stale*";
+		}
+	}
+	return (commit);
+}
