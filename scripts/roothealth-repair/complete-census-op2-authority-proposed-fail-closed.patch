+static int update_record_data(ntfs_volume *vol,
+		const struct ACTION_RECORD *action, char *buffer, BOOL undo,
+		BOOL allocation)
+{
+	const LOG_RECORD *record = &action->record;
+	const char *data = (const char *)record + (undo ?
+		get_undo_offset(record) : get_redo_offset(record));
+	const char *expected = (const char *)record + (undo ?
+		get_redo_offset(record) : get_undo_offset(record));
+	u32 entry_at = le16_to_cpu(record->record_offset) +
+		le16_to_cpu(record->attribute_offset);
+	INDEX_ENTRY *entry;
+	u32 entry_length, data_offset, length, target;
+
+	if (!buffer || entry_at > (allocation ? vol->indx_record_size : mftrecsz) -
+			sizeof(INDEX_ENTRY_HEADER))
+		return 1;
+	entry = (INDEX_ENTRY *)(buffer + entry_at);
+	entry_length = le16_to_cpu(entry->length);
+	data_offset = le16_to_cpu(entry->data_offset);
+	length = undo ? le16_to_cpu(record->undo_length) :
+		le16_to_cpu(record->redo_length);
+	if (entry_length < sizeof(INDEX_ENTRY_HEADER) ||
+		data_offset > entry_length || length > entry_length - data_offset)
+		return 1;
+	target = entry_at + data_offset;
+	/*
+	 * View-index record data is not required to be eight-byte sized.  Do not
+	 * route it through the legacy resident-value helper, which rejects valid
+	 * four-byte view data and treats an unexpected before-image as success.
+	 * The hardened path accepts only the exact logged before or after image.
+	 */
+	if (!memcmp(buffer + target, data, length))
+		return 0;
+	if (memcmp(buffer + target, expected, length))
+		return 1;
+	memcpy(buffer + target, data, length);
+	return write_protected(vol, &action->record, buffer,
+		allocation ? vol->indx_record_size : mftrecsz);
+}
+
+/*
+ * Windows' NtOfsRestartUpdateRelativeDataInIndex treats the first u16 at
+ * the selected view-index entry as a relative offset, then adds the logged
+ * 32- or 64-bit delta to the field at that offset.  The undo record carries
+ * the exact modular inverse delta.  Use memcpy for both the relative field
+ * and the value because neither is guaranteed to be naturally aligned.
+ */
+static int update_relative_index_data(ntfs_volume *vol,
+		const struct ACTION_RECORD *action, char *buffer, BOOL undo,
+		BOOL allocation)
+{
+	const LOG_RECORD *record = &action->record;
+	const unsigned char *data = (const unsigned char *)record + (undo ?
+		get_undo_offset(record) : get_redo_offset(record));
+	size_t object_size = allocation ? vol->indx_record_size : mftrecsz;
+	size_t entry_at = (size_t)le16_to_cpu(record->record_offset) +
+		le16_to_cpu(record->attribute_offset);
+	size_t width = undo ? le16_to_cpu(record->undo_length) :
+		le16_to_cpu(record->redo_length);
+	size_t value_at;
+	le16 relative_le;
+
+	if (!buffer || (width != 4U && width != 8U) ||
+		entry_at > object_size || object_size - entry_at < sizeof(relative_le))
+		return 1;
+	memcpy(&relative_le, buffer + entry_at, sizeof(relative_le));
+	value_at = le16_to_cpu(relative_le);
+	if (value_at > object_size - entry_at ||
+		width > object_size - entry_at - value_at)
+		return 1;
+	value_at += entry_at;
+	if (width == 4U) {
+		le32 current_le, delta_le;
+		u32 value;
+
+		memcpy(&current_le, buffer + value_at, sizeof(current_le));
+		memcpy(&delta_le, data, sizeof(delta_le));
+		value = le32_to_cpu(current_le) + le32_to_cpu(delta_le);
+		current_le = cpu_to_le32(value);
+		memcpy(buffer + value_at, &current_le, sizeof(current_le));
+	} else {
+		le64 current_le, delta_le;
+		u64 value;
+
+		memcpy(&current_le, buffer + value_at, sizeof(current_le));
+		memcpy(&delta_le, data, sizeof(delta_le));
+		value = le64_to_cpu(current_le) + le64_to_cpu(delta_le);
+		current_le = cpu_to_le64(value);
+		memcpy(buffer + value_at, &current_le, sizeof(current_le));
+	}
+	return write_protected(vol, &action->record, buffer,
+		allocation ? vol->indx_record_size : mftrecsz);
+}
