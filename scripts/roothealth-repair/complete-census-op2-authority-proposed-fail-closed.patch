+void showname(const char *prefix, const char *name, int cnt)
+{
+	const le16 *n;
+	int i;
+	int c;
+
+	printf("%s",prefix);
+	n = (const le16*)name;
+	for (i=0; (i<cnt) && n[i]; i++) {
+		c = le16_to_cpu(n[i]);
+		if (c < 0x20)
+			printf(".");
+		else
+			if (c < 0x80)
+				printf("%c",c);
+			else
+				if (c < 0x800)
+					printf("%c%c",
+						(c >> 6) + 0xc0,
+						(c & 63) + 0x80);
+				else
+					printf("%c%c%c",
+						(c >> 12) + 0xe0,
+						((c >> 6) & 63) + 0x80,
+						(c & 63) + 0x80);
+	}
+	printf("\n");
+}
