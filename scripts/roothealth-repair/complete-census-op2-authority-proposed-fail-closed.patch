+		s64 (*callback)(struct ntfs_device *dev, const void *buf,
+			s64 count, s64 offset, void *opaque), void *opaque)
+{
+	if (!dev || !callback || dev->d_roothealth_plan_write) {
+		errno = EINVAL;
+		return -1;
