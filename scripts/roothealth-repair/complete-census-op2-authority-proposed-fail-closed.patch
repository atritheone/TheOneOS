+			}
+			if (optv > 1) {
+				printf("-> data record %s\n",
+					(changed ? "updated" : "unchanged"));
+			}
+		}
+	} else {
+		/*
+		 * No undo data, we cannot undo, sometimes the redo
+		 * data even overflows from record.
+		 * Just ignore for now.
+		 */
+		if (optv)
+			printf("Cannot undo, there is no undo data\n");
+		err = 0;
+	}
+
+	return (err);
+}
+
+static int undo_write_end(ntfs_volume *vol,
+			const struct ACTION_RECORD *action, char *buffer)
+{
+	LCN lcn;
+	const char *data;
+	u32 target;
+	u32 length;
+	u32 oldlength;
+	u32 end;
+	u32 undo;
+	int err;
+	int changed;
+
+	if (optv > 1)
+		printf("-> %s()\n",__func__);
+	err = 1;
+	end = le32_to_cpu(action->record.client_data_length)
+			+ LOG_RECORD_HEAD_SZ;
+	length = le16_to_cpu(action->record.undo_length);
+	undo = get_undo_offset(&action->record);
+	if ((undo + length) > end)
+		data = (char*)NULL;
+	else
+		data = ((const char*)&action->record) + undo;
+	oldlength = le16_to_cpu(action->record.redo_length);
+	target = le16_to_cpu(action->record.record_offset)
+		+ le16_to_cpu(action->record.attribute_offset);
+	if (length == oldlength) {
+		if (optv > 1) {
+			lcn = sle64_to_cpu(action->record.lcn_list[0]);
+			printf("-> inode %lld lcn 0x%llx target 0x%x"
+				" length %d\n",
+				(long long)inode_number(&action->record),
+				(long long)lcn, (int)target, (int)length);
+		}
+		if (optv > 1) {
+			printf("-> existing record :\n");
+			dump(&buffer[target], length);
+		}
+		if ((target + length) <= mftrecsz) {
+			changed = memcmp(buffer + target, data, length);
+			err = 0;
+			if (changed) {
+				memcpy(buffer + target, data, length);
+				if (optv > 1) {
+					printf("-> new record :\n");
+					dump(buffer + target, length);
+				}
+				err = write_protected(vol, &action->record,
+						buffer, mftrecsz);
+			}
+			if (optv > 1) {
+				printf("-> MFT record %s\n",
+					(changed ? "updated" : "unchanged"));
+			}
+		}
+	} else {
+		if (length > oldlength)
+			err = add_resident(vol, action, buffer, data,
+					target, length, oldlength);
+		else
+			err = delete_resident(vol, action, buffer, data,
+					target, length, oldlength);
+	}
+	return (err);
+}
+
+static int undo_write_index(ntfs_volume *vol,
+			const struct ACTION_RECORD *action, char *buffer)
+{
+	LCN lcn;
+	const char *data;
+	u32 target;
+	u32 length;
+	u32 oldlength;
+	u32 end;
+	u32 undo;
+	int err;
+	int changed;
+
+	if (optv > 1)
+		printf("-> %s()\n",__func__);
+	err = 1;
+	end = le32_to_cpu(action->record.client_data_length)
+			+ LOG_RECORD_HEAD_SZ;
+	length = le16_to_cpu(action->record.undo_length);
+	undo = get_undo_offset(&action->record);
+	if ((undo + length) > end)
+		data = (char*)NULL;
+	else
+		data = ((const char*)&action->record) + undo;
+	oldlength = le16_to_cpu(action->record.redo_length);
+	target = le16_to_cpu(action->record.record_offset)
+		+ le16_to_cpu(action->record.attribute_offset);
+	if (length == oldlength) {
+		if (optv > 1) {
+			lcn = sle64_to_cpu(action->record.lcn_list[0]);
+			printf("-> inode %lld lcn 0x%llx target 0x%x"
+				" length %d\n",
+				(long long)inode_number(&action->record),
+				(long long)lcn, (int)target, (int)length);
+		}
+		if (optv > 1) {
+			printf("-> existing record :\n");
+			dump(&buffer[target], length);
+		}
+		if ((target + length) <= vol->indx_record_size) {
+			changed = memcmp(buffer + target, data, length);
+			err = 0;
+			if (changed) {
+				memcpy(buffer + target, data, length);
+				if (optv > 1) {
+					printf("-> new record :\n");
+					dump(buffer + target, length);
+				}
+				err = write_protected(vol, &action->record,
+						buffer, mftrecsz);
+			}
+			if (optv > 1) {
+				printf("-> MFT record %s\n",
+					(changed ? "updated" : "unchanged"));
+			}
+		}
+	} else {
+		if (length > oldlength)
+			err = add_non_resident(/*vol, action, data,
+					target, length, oldlength*/);
+		else
+			err = delete_non_resident(/*vol, action, data,
+					target, length, oldlength*/);
+	}
+	return (err);
+}
+
+enum ACTION_KIND { ON_NONE, ON_MFT, ON_INDX, ON_RAW } ;
+
+static enum ACTION_KIND get_action_kind(const struct ACTION_RECORD *action)
+{
+	struct ATTR *pa;
+	const char *data;
+	enum ACTION_KIND kind;
+		/*
+		 * If we are sure the action was defined by Vista
+		 * or subsequent, just use attribute_flags.
+		 * Unfortunately, only on some cases we can determine
+		 * the action was defined by Win10 (or subsequent).
+		 */
+	if (action->record.log_record_flags
+			& (LOG_RECORD_DELETING | LOG_RECORD_ADDING)) {
+		if (action->record.attribute_flags & ACTS_ON_INDX)
+			kind = ON_INDX;
+		else
+			if (action->record.attribute_flags & ACTS_ON_MFT)
+				kind = ON_MFT;
+			else
+				kind = ON_RAW;
+	} else {
+		/*
+		 * In other cases, we have to rely on the attribute
+		 * definition, but this has defects when undoing.
+		 */
+		pa = getattrentry(le16_to_cpu(
+					action->record.target_attribute),0);
+		if (!pa || !pa->type) {
+		/*
+		 * Even when the attribute has not been recorded,
+		 * we can sometimes tell the record does not apply
+		 * to MFT or INDX : such records always have a zero
+		 * record_offset, and if attribute_offset is zero, their
+		 * magic can be checked. If neither condition is true,
+		 * the action cannot apply to MFT or INDX.
+		 * (this is useful for undoing)
+		 */
+			data = (const char*)&action->record
+				+ get_redo_offset(&action->record);
+			if (action->record.record_offset
+			    || (!action->record.attribute_offset
+				&& (le16_to_cpu(action->record.redo_length)
+									>= 4)
+				&& memcmp(data,"FILE",4)
+				&& memcmp(data,"INDX",4))) {
+					kind = ON_RAW;
+			} else {
+				printf("** Error : attribute 0x%x"
+					" is not defined\n",
+					(int)le16_to_cpu(
+					action->record.target_attribute));
+				kind = ON_NONE;
+			}
+		} else {
+			if (pa->type == AT_INDEX_ALLOCATION)
+				kind = ON_INDX;
+			else
+				kind = ON_RAW;
+		}
+	}
+	return (kind);
+}
+
+
+/*
+ *		Display the redo actions which were executed
+ *
+ *	Useful for getting indications on the coverage of a test
+ */
+
+void show_redos(void)
+{
+	int i;
+
+	if (optv && redos_met) {
+		printf("Redo actions which were executed :\n");
+		for (i=0; i<64; i++)
+			if ((((u64)1) << i) & redos_met)
+				printf("%s\n", actionname(i));
+	}
+}
+
+static int distribute_redos(ntfs_volume *vol,
+			const struct ACTION_RECORD *action, char *buffer)
+{
+	int rop, uop;
+	int err;
+
+	/* A branch must explicitly prove its pair and assign success. */
+	err = 1;
+	rop = le16_to_cpu(action->record.redo_operation);
+	uop = le16_to_cpu(action->record.undo_operation);
+	switch (rop) {
+	case AddIndexEntryAllocation :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(DeleteIndexEntryAllocation))
+			err = redo_add_index(vol, action, buffer);
+		break;
+	case AddIndexEntryRoot :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(DeleteIndexEntryRoot))
+			err = redo_add_root_index(vol, action, buffer);
+		break;
+	case ClearBitsInNonResidentBitMap :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(SetBitsInNonResidentBitMap))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_force_bits(vol, action, buffer);
+		break;
+	case CompensationlogRecord :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(Noop))
+			err = redo_compensate(vol, action, buffer);
+		break;
+	case CreateAttribute :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(DeleteAttribute))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_create_attribute(vol, action, buffer);
+		break;
+	case DeallocateFileRecordSegment :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(InitializeFileRecordSegment))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_delete_file(vol, action, buffer);
+		break;
+	case DeleteAttribute :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(CreateAttribute))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_delete_attribute(vol, action, buffer);
+		break;
+	case DeleteIndexEntryAllocation :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(AddIndexEntryAllocation))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_delete_index(vol, action, buffer);
+		break;
+	case DeleteIndexEntryRoot :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(AddIndexEntryRoot))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_delete_root_index(vol, action, buffer);
+		break;
+	case InitializeFileRecordSegment :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(Noop))
+			err = redo_create_file(vol, action, buffer);
+		break;
+	case OpenNonResidentAttribute :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(Noop))
+			err = redo_open_attribute(vol, action);
+		break;
+	case SetBitsInNonResidentBitMap :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(ClearBitsInNonResidentBitMap))
+			err = redo_force_bits(vol, action, buffer);
+		break;
+	case SetIndexEntryVcnAllocation :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(SetIndexEntryVcnAllocation))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_update_vcn(vol, action, buffer);
+		break;
+	case SetIndexEntryVcnRoot :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(SetIndexEntryVcnRoot))
+			err = redo_update_root_vcn(vol, action, buffer);
+		break;
+	case SetNewAttributeSizes :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(SetNewAttributeSizes))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_sizes(vol, action, buffer);
+		break;
+	case UpdateFileNameAllocation :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(UpdateFileNameAllocation))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_update_index(vol, action, buffer);
+		break;
+	case UpdateFileNameRoot :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(UpdateFileNameRoot))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_update_root_index(vol, action, buffer);
+		break;
+	case UpdateMappingPairs :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(UpdateMappingPairs))
+			err = redo_update_mapping(vol, action, buffer);
+		break;
+	case UpdateNonResidentValue :
+		if (uop == UpdateNonResidentValue ||
+			uop == CompensationlogRecord) {
+			switch (get_action_kind(action)) {
+			case ON_INDX :
+				err = redo_update_index_value(vol, action, buffer);
+				break;
+			case ON_RAW :
+				err = redo_update_value(vol, action, buffer);
+				break;
+			default :
+				printf("** Bad attribute type\n");
+				break;
+			}
+		}
+		break;
+	case UpdateResidentValue :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(UpdateResidentValue))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_update_resident(vol, action, buffer);
+		break;
+	case UpdateRecordDataRoot :
+		if (uop == UpdateRecordDataRoot)
+			err = update_record_data(vol, action, buffer, FALSE, FALSE);
+		break;
+	case UpdateRecordDataAllocation :
+		if (uop == UpdateRecordDataAllocation)
+			err = update_record_data(vol, action, buffer, FALSE, TRUE);
+		break;
+	case UpdateRelativeDataInIndex :
+		if (uop == UpdateRelativeDataInIndex)
+			err = update_relative_index_data(vol, action, buffer, FALSE, FALSE);
+		break;
+	case UpdateRelativeDataInIndex2 :
+		if (uop == UpdateRelativeDataInIndex2)
+			err = update_relative_index_data(vol, action, buffer, FALSE, TRUE);
+		break;
+	case ZeroEndOfFileRecord :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(Noop))
+			err = redo_action37(vol, action, buffer);
+		break;
+	case WriteEndofFileRecordSegment :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(WriteEndofFileRecordSegment))
+			err = redo_write_end(vol, action, buffer);
+		break;
+	case WriteEndOfIndexBuffer :
+		if ((action->record.undo_operation
+			== const_cpu_to_le16(WriteEndOfIndexBuffer))
+		    || (action->record.undo_operation
+			== const_cpu_to_le16(CompensationlogRecord)))
+			err = redo_write_index(vol, action, buffer);
+		break;
+	case ForgetTransaction :
+		if (uop == Noop)
+			err = 0;
+		break;
+	case Noop :
+		if (uop == Noop)
+			err = 0;
+		break;
+	case AttributeNamesDump :
+	case DirtyPageTableDump :
+	case OpenAttributeTableDump :
+	case TransactionTableDump :
+	default :
+		printf("** Unsupported redo %s\n", actionname(rop));
+		break;
+	}
+	if (rop >= 0 && rop < 64)
+		redos_met |= ((u64)1) << rop;
+	if (err)
+		printf("* Redoing action %d %s (%s) failed\n",
+			action->num,actionname(rop), actionname(uop));
+	return (err);
+}
+
+static int distribute_undos(ntfs_volume *vol,
+		const struct ACTION_RECORD *action, char *buffer);
+
+/*
+ *		Redo a single action
+ *
+ *	The record the action acts on is read and, when it is an MFT or
+ *	INDX one, the need for redoing is checked.
+ *
+ *	When this is an action which creates a new MFT or INDX record
+ *	and the old one cannot be read (usually because it was not
+ *	initialized), a zeroed buffer is allocated.
+ */
+
+static int play_one_redo(ntfs_volume *vol, const struct ACTION_RECORD *action)
+{
+	MFT_RECORD *entry;
+	INDEX_BLOCK *indx;
+	char *buffer;
+	s64 this_lsn;
+	s64 data_lsn;
+	u32 xsize;
+	int err;
+	BOOL warn;
+	BOOL executed;
+	enum ACTION_KIND kind;
+	u16 rop;
+	u16 uop;
+
+	err = 0;
+	rop = le16_to_cpu(action->record.redo_operation);
+	uop = le16_to_cpu(action->record.undo_operation);
+	this_lsn = sle64_to_cpu(action->record.this_lsn);
+	if (optv)
+		printf("Redo action %d %s (%s) 0x%llx\n",
+			action->num,
+			actionname(rop), actionname(uop),
+			(long long)sle64_to_cpu(
+				action->record.this_lsn));
+	buffer = (char*)NULL;
+	switch (rop) {
+			/* Actions always acting on MFT */
+	case AddIndexEntryRoot :
+	case CreateAttribute :
+	case DeallocateFileRecordSegment :
+	case DeleteAttribute :
+	case DeleteIndexEntryRoot :
+	case InitializeFileRecordSegment :
+	case SetIndexEntryVcnRoot :
+	case SetNewAttributeSizes :
+	case UpdateFileNameRoot :
+	case UpdateMappingPairs :
+	case UpdateResidentValue :
+	case ZeroEndOfFileRecord :
+	case WriteEndofFileRecordSegment :
+	case UpdateRecordDataRoot :
+	case UpdateRelativeDataInIndex :
+		kind = ON_MFT;
+		break;
+			/* Actions always acting on INDX */
+	case AddIndexEntryAllocation :
+	case DeleteIndexEntryAllocation :
+	case SetIndexEntryVcnAllocation :
+	case UpdateFileNameAllocation :
+	case WriteEndOfIndexBuffer :
+	case UpdateRecordDataAllocation :
+	case UpdateRelativeDataInIndex2 :
+		kind = ON_INDX;
+		break;
+			/* Actions never acting on MFT or INDX */
+	case ClearBitsInNonResidentBitMap :
+	case SetBitsInNonResidentBitMap :
+		kind = ON_RAW;
+		break;
+			/* Actions which may act on MFT */
+	case Noop : /* on MFT if DeallocateFileRecordSegment */
+		kind = ON_NONE;
+		break;
+			/* Actions which may act on INDX */
+	case UpdateNonResidentValue :
+		/* Known cases : INDX, $SDS, ATTR_LIST */
+		kind = get_action_kind(action);
+		if (kind == ON_NONE)
+			err = 1;
+		break;
+	case CompensationlogRecord :
+	case OpenNonResidentAttribute :
+		/* probably not important */
+		kind = ON_NONE;
+		break;
+			/* Actions currently ignored */
+	case AttributeNamesDump :
+	case DirtyPageTableDump :
+	case ForgetTransaction :
+	case OpenAttributeTableDump :
+	case TransactionTableDump :
+		kind = ON_NONE;
+		break;
+			/* Actions with no known use case */
+	case CommitTransaction :
+	case DeleteDirtyClusters :
+	case EndTopLevelAction :
+	case HotFix :
+	case PrepareTransaction :
+	default :
+		err = 1;
+		kind = ON_NONE;
+		break;
+	}
+	executed = FALSE;
+	switch (kind) {
+	case ON_MFT :
+/*
+ the check below cannot be used on WinXP
+if (!(action->record.attribute_flags & ACTS_ON_MFT))
+printf("** %s (action %d) not acting on MFT\n",actionname(rop),(int)action->num);
+*/
+		/* Check whether data is to be discarded */
+		warn = (rop != InitializeFileRecordSegment)
+			|| !check_full_mft(action,TRUE);
+		buffer = read_protected(vol, &action->record,
+					mftrecsz, warn);
+		entry = (MFT_RECORD*)buffer;
+		if (entry && (entry->magic == magic_FILE)) {
+			data_lsn = sle64_to_cpu(entry->lsn);
+			/*
+			 * Beware of records not updated
+			 * during the last session which may
+			 * have a stale lsn (consequence
+			 * of ntfs-3g resetting the log)
+			 */
+			executed = ((s64)(data_lsn - this_lsn) >= 0)
+			    && (((s64)(data_lsn - latest_lsn)) <= 0)
+			    && !exception(action->num);
+		} else {
+			if (!warn) {
+				/* Old record not needed */
+				if (!buffer)
+					buffer = (char*)calloc(1, mftrecsz);
+				if (buffer)
+					executed = FALSE;
+				else
+					err = 1;
+			} else {
+				printf("** %s (action %d) not"
+					" acting on MFT\n",
+					actionname(rop),
+					(int)action->num);
+				err = 1;
+			}
+		}
+		break;
+	case ON_INDX :
+/*
+ the check below cannot be used on WinXP
+if (!(action->record.attribute_flags & ACTS_ON_INDX))
+printf("** %s (action %d) not acting on INDX\n",actionname(rop),(int)action->num);
+*/
+		xsize = vol->indx_record_size;
+		/* Check whether data is to be discarded */
+		warn = (rop != UpdateNonResidentValue)
+			|| !check_full_index(action,TRUE);
+		buffer = read_protected(vol, &action->record,
+						xsize, warn);
+		indx = (INDEX_BLOCK*)buffer;
+		if (indx && (indx->magic == magic_INDX)) {
+			data_lsn = sle64_to_cpu(indx->lsn);
+			/*
+			 * Beware of records not updated
+			 * during the last session which may
+			 * have a stale lsn (consequence
+			 * of ntfs-3g resetting the log)
+			 */
+			executed = ((s64)(data_lsn - this_lsn) >= 0)
+			    && (((s64)(data_lsn - latest_lsn)) <= 0)
+			    && ! exception(action->num);
+		} else {
+			if (!warn) {
+				/* Old record not needed */
+				if (!buffer)
+					buffer = (char*)calloc(1, xsize);
+				if (buffer)
+					executed = FALSE;
+				else
+					err = 1;
+			} else {
+				printf("** %s (action %d) not"
+					" acting on INDX\n",
+					actionname(rop),
+					(int)action->num);
+				err = 1;
+			}
+		}
+		break;
+	case ON_RAW :
+		if (action->record.attribute_flags
+				& (ACTS_ON_INDX | ACTS_ON_MFT)) {
+			printf("** Error : action %s on MFT"
+				" or INDX\n",
+				actionname(rop));
+			err = 1;
+		} else {
+			buffer = read_raw(vol, &action->record);
+			if (!buffer)
+				err = 1;
+		}
+		break;
+	default :
+		buffer = (char*)NULL;
+		break;
+	}
+	if (!err && (!executed || !opts)) {
+		err = distribute_redos(vol, action, buffer);
+		redocount++;
+	} else {
+		if (optv)
+			printf("Action %d %s (%s) not redone\n",
+				action->num,
+				actionname(rop),
+				actionname(uop));
+	}
+	if (buffer)
+		free(buffer);
+	return (err);
+}
+
+
+struct roothealth_attr_view {
+	size_t offset;
+	size_t length;
+	size_t value_offset;
+	size_t value_length;
+	size_t mapping_offset;
+	u32 type;
+	int nonresident;
+};
+
+static u16 roothealth_load_u16(const unsigned char *p)
+{
+	return (u16)p[0] | ((u16)p[1] << 8);
+}
+
+static u32 roothealth_load_u32(const unsigned char *p)
+{
+	return (u32)p[0] | ((u32)p[1] << 8) |
+		((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static u64 roothealth_load_u64(const unsigned char *p)
+{
+	return (u64)roothealth_load_u32(p) |
+		((u64)roothealth_load_u32(p + 4) << 32);
+}
+
+static int roothealth_range(size_t size, size_t offset, size_t length)
+{
+	return offset <= size && length <= size - offset;
+}
+
+static int roothealth_validate_mapping_pairs(const unsigned char *bytes,
+		size_t length)
+{
+	size_t offset = 0;
+
+	while (offset < length) {
+		u8 header = bytes[offset++];
+		size_t run_bytes = header & 0xfU;
+		size_t lcn_bytes = header >> 4;
+		u64 run = 0;
+		size_t i;
+
+		if (!header)
+			return roothealth_all_zero(bytes + offset, length - offset) ? 0 : -1;
+		if (!run_bytes || run_bytes > 8U || lcn_bytes > 8U ||
+			!roothealth_range(length, offset, run_bytes + lcn_bytes))
+			return -1;
+		for (i = 0; i < run_bytes; ++i)
+			run |= (u64)bytes[offset + i] << (8U * i);
+		if (!run)
+			return -1;
+		offset += run_bytes + lcn_bytes;
+	}
+	return -1;
+}
+
+static int roothealth_validate_attribute(const unsigned char *attribute,
+		size_t available, int exact, struct roothealth_attr_view *view)
+{
+	u32 type, length;
+	u8 nonresident, name_length;
+	u16 name_offset;
+	size_t minimum;
+
+	if (!attribute || available < 24U)
+		return -1;
+	type = roothealth_load_u32(attribute);
+	length = roothealth_load_u32(attribute + 4);
+	nonresident = attribute[8];
+	name_length = attribute[9];
+	name_offset = roothealth_load_u16(attribute + 10);
+	if (!type || type == 0xffffffffU || (type & 0xfU) || type > 0x100U ||
+		(nonresident != 0U && nonresident != 1U) || length < 24U ||
+		(length & 7U) || length > available || (exact && length != available))
+		return -1;
+	minimum = nonresident ? 64U : 24U;
+	if (length < minimum || (name_length &&
+		(name_offset < minimum ||
+		 !roothealth_range(length, name_offset, (size_t)name_length * 2U))))
+		return -1;
+	if (view) {
+		memset(view, 0, sizeof(*view));
+		view->length = length;
+		view->type = type;
+		view->nonresident = nonresident;
+	}
+	if (nonresident) {
+		u64 lowest = roothealth_load_u64(attribute + 16);
+		u64 highest = roothealth_load_u64(attribute + 24);
+		u16 mapping = roothealth_load_u16(attribute + 32);
+		u64 allocated = roothealth_load_u64(attribute + 40);
+		u64 data = roothealth_load_u64(attribute + 48);
+		u64 initialized = roothealth_load_u64(attribute + 56);
+
+		if (highest < lowest || mapping < minimum || mapping >= length ||
+			initialized > data || data > allocated ||
+			roothealth_validate_mapping_pairs(attribute + mapping,
+				length - mapping))
+			return -1;
+		if (view)
+			view->mapping_offset = mapping;
+	} else {
+		u32 value_length = roothealth_load_u32(attribute + 16);
+		u16 value_offset = roothealth_load_u16(attribute + 20);
+
+		if (value_offset < minimum ||
+			!roothealth_range(length, value_offset, value_length))
+			return -1;
+		if (view) {
+			view->value_offset = value_offset;
+			view->value_length = value_length;
+		}
+	}
+	return 0;
+}
+
+static int roothealth_validate_mft(const unsigned char *record,
+		size_t available, size_t storage_size, u64 expected_record,
+		int require_in_use, size_t requested_attribute,
+		struct roothealth_attr_view *requested)
+{
+	size_t offset, bytes_in_use;
+	u16 usa_offset, usa_count;
+	int found = requested_attribute == SIZE_MAX;
+
+	if (!record || available < 48U || memcmp(record, "FILE", 4) ||
+		roothealth_load_u32(record + 28) != storage_size ||
+		(expected_record != UINT64_MAX &&
+		 roothealth_load_u32(record + 44) != expected_record) ||
+		!roothealth_load_u16(record + 16) ||
+		(require_in_use && !(roothealth_load_u16(record + 22) & 1U)))
+		return -1;
+	usa_offset = roothealth_load_u16(record + 4);
+	usa_count = roothealth_load_u16(record + 6);
+	if (usa_count != storage_size / bytespersect + 1U ||
+		!roothealth_range(available, usa_offset, (size_t)usa_count * 2U))
+		return -1;
+	offset = roothealth_load_u16(record + 20);
+	bytes_in_use = roothealth_load_u32(record + 24);
+	if ((offset & 7U) || offset < 48U || bytes_in_use > available ||
+		bytes_in_use > storage_size || bytes_in_use < offset + 8U)
+		return -1;
+	while (roothealth_range(bytes_in_use, offset, 8U)) {
+		struct roothealth_attr_view local;
+		u32 type = roothealth_load_u32(record + offset);
+
+		if (type == 0xffffffffU) {
+			if (offset + 8U != bytes_in_use || !found)
+				return -1;
+			return 0;
+		}
+		if (roothealth_validate_attribute(record + offset,
+				bytes_in_use - offset, 0, &local))
+			return -1;
+		local.offset = offset;
+		if (offset == requested_attribute) {
+			if (requested)
+				*requested = local;
+			found = 1;
+		}
+		offset += local.length;
+	}
+	return -1;
+}
+
+static int roothealth_validate_index_entry(const unsigned char *entry,
+		size_t available, size_t *entry_length, int require_node)
+{
+	u16 length, key_length, flags;
+	size_t payload;
+
+	if (!entry || available < 16U)
+		return -1;
+	length = roothealth_load_u16(entry + 8);
+	key_length = roothealth_load_u16(entry + 10);
+	flags = roothealth_load_u16(entry + 12);
+	if (length < 16U || (length & 7U) || length > available ||
+		(flags & ~3U))
+		return -1;
+	payload = length - 16U;
+	if (flags & 1U) {
+		if (payload < 8U)
+			return -1;
+		payload -= 8U;
+	} else if (require_node) {
+		return -1;
+	}
+	if (key_length > payload)
+		return -1;
+	if (entry_length)
+		*entry_length = length;
+	return 0;
+}
+
+static int roothealth_validate_index(const unsigned char *index, size_t size,
+		size_t requested_entry, size_t *requested_length)
+{
+	size_t offset, end;
+	u32 entries_offset, index_length, allocated;
+	u16 usa_offset, usa_count;
+	int found = requested_entry == SIZE_MAX;
+
+	if (!index || size != RH_REPLAY_PAGE_SIZE || memcmp(index, "INDX", 4))
+		return -1;
+	usa_offset = roothealth_load_u16(index + 4);
+	usa_count = roothealth_load_u16(index + 6);
+	if (usa_count != size / bytespersect + 1U ||
+		!roothealth_range(size, usa_offset, (size_t)usa_count * 2U))
+		return -1;
+	entries_offset = roothealth_load_u32(index + 24);
+	index_length = roothealth_load_u32(index + 28);
+	allocated = roothealth_load_u32(index + 32);
+	if (allocated != size - 24U || entries_offset > index_length ||
+		index_length > allocated || (entries_offset & 7U) ||
+		(index_length & 7U) || !roothealth_range(size, 24U, index_length))
+		return -1;
+	offset = 24U + entries_offset;
+	end = 24U + index_length;
+	while (offset < end) {
+		size_t length;
+		u16 flags;
+
+		if (roothealth_validate_index_entry(index + offset, end - offset,
+				&length, 0))
+			return -1;
+		flags = roothealth_load_u16(index + offset + 12);
+		if (offset == requested_entry) {
+			if (requested_length)
+				*requested_length = length;
+			found = 1;
+		}
+		offset += length;
+		if (flags & 2U)
+			return (offset == end && found) ? 0 : -1;
+	}
+	return -1;
+}
+
+struct roothealth_index_root_view {
+	size_t attribute_offset;
+	size_t value_offset;
+	size_t entries_offset;
+	size_t entries_end;
+	u32 indexed_type;
+};
+
+static int roothealth_validate_index_root(const unsigned char *record,
+		size_t record_size, u64 record_number, size_t attribute_offset,
+		size_t requested_entry, size_t *requested_length,
+		struct roothealth_index_root_view *view)
+{
+	struct roothealth_attr_view attr;
+	size_t root_at, header_at, offset, end;
+	u32 entries_offset, index_length, allocated, indexed_type;
+	u8 flags;
+	int found = requested_entry == SIZE_MAX;
+
+	if (roothealth_validate_mft(record, record_size, record_size,
+			record_number, 1, attribute_offset, &attr) || attr.nonresident ||
+		attr.type != 0x90U || attr.value_length < 32U)
+		return -1;
+	root_at = attr.offset + attr.value_offset;
+	if (!roothealth_range(record_size, root_at, attr.value_length))
+		return -1;
+	indexed_type = roothealth_load_u32(record + root_at);
+	if ((indexed_type && ((indexed_type & 0xfU) || indexed_type > 0x100U)) ||
+		roothealth_load_u32(record + root_at + 8U) != RH_REPLAY_PAGE_SIZE ||
+		record[root_at + 12U] != 1U ||
+		!roothealth_all_zero(record + root_at + 13U, 3U))
+		return -1;
+	header_at = root_at + 16U;
+	entries_offset = roothealth_load_u32(record + header_at);
+	index_length = roothealth_load_u32(record + header_at + 4U);
+	allocated = roothealth_load_u32(record + header_at + 8U);
+	flags = record[header_at + 12U];
+	if (entries_offset < 16U || (entries_offset & 7U) ||
+		index_length < entries_offset || (index_length & 7U) ||
+		allocated != index_length || flags > 1U ||
+		!roothealth_all_zero(record + header_at + 13U, 3U) ||
+		attr.value_length != 16U + index_length)
+		return -1;
+	offset = header_at + entries_offset;
+	end = header_at + index_length;
+	if (end > root_at + attr.value_length)
+		return -1;
+	while (offset < end) {
+		size_t length;
+		u16 entry_flags;
+
+		if (roothealth_validate_index_entry(record + offset, end - offset,
+				&length, 0))
+			return -1;
+		entry_flags = roothealth_load_u16(record + offset + 12U);
+		if ((entry_flags & 2U) && roothealth_load_u16(record + offset + 10U))
+			return -1;
+		if (offset == requested_entry) {
+			if (requested_length)
+				*requested_length = length;
+			found = 1;
+		}
+		offset += length;
+		if (entry_flags & 2U) {
+			if (offset != end || !found)
+				return -1;
+			if (view) {
+				view->attribute_offset = attr.offset;
+				view->value_offset = root_at;
+				view->entries_offset = header_at + entries_offset;
+				view->entries_end = end;
+				view->indexed_type = indexed_type;
+			}
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static int roothealth_validate_sizes(const unsigned char *data, size_t length)
+{
+	u64 allocated, file_size, initialized;
+
+	if (!data || (length != 24U && length != 32U))
+		return -1;
+	allocated = roothealth_load_u64(data);
+	file_size = roothealth_load_u64(data + 8);
+	initialized = roothealth_load_u64(data + 16);
+	return (initialized <= file_size && file_size <= allocated) ? 0 : -1;
+}
+
+static int roothealth_validate_mft_tail(const unsigned char *bytes,
+		size_t length)
+{
+	size_t offset = 0;
+
+	if (!bytes || length < 8U || (length & 7U))
+		return -1;
+	while (roothealth_range(length, offset, 8U)) {
+		u32 type = roothealth_load_u32(bytes + offset);
+		struct roothealth_attr_view attr;
+
+		if (type == 0xffffffffU)
+			return offset + 8U == length &&
+				roothealth_all_zero(bytes + offset + 4U, 4U) ? 0 : -1;
+		if (roothealth_validate_attribute(bytes + offset, length - offset,
+				0, &attr))
+			return -1;
+		offset += attr.length;
+	}
+	return -1;
+}
+
+static u64 roothealth_action_record_number(
+		const struct rh_replay_action_view *guarded)
+{
+	return guarded->target_vcn * ((u64)clustersz / mftrecsz) +
+		guarded->target_slice_offset / mftrecsz;
+}
+
+static int roothealth_validate_semantic_target(const struct ACTION_RECORD *action,
+		const unsigned char *target,
+		const struct rh_replay_action_view *guarded, int allow_blank_initialize,
+		int validate_operation)
+{
+	const unsigned char *record = (const unsigned char *)&action->record;
+	const unsigned char *redo = record + guarded->redo_data_offset;
+	const unsigned char *undo = record + guarded->undo_data_offset;
+	struct roothealth_attr_view attr;
+	struct roothealth_index_root_view root_view;
+	size_t target_at = (size_t)guarded->record_offset +
+		guarded->attribute_offset;
+	size_t entry_length;
+	u64 record_number;
+
+	if (!action || !target || !guarded)
+		return -1;
+	switch (guarded->action_class) {
+	case RH_REPLAY_ACTION_MFT_WRITE:
+		record_number = roothealth_action_record_number(guarded);
+		if (allow_blank_initialize && guarded->redo_operation ==
+				InitializeFileRecordSegment) {
+			if (roothealth_validate_mft(redo, guarded->redo_length,
+					guarded->target_object_size, record_number, 0,
+					SIZE_MAX, NULL))
+				return -1;
+		} else if (roothealth_validate_mft(target,
+				guarded->target_object_size, guarded->target_object_size,
+				record_number,
+				guarded->redo_operation == DeallocateFileRecordSegment ? 0 : 1,
+				SIZE_MAX, NULL)) {
+			return -1;
+		}
+		break;
+	case RH_REPLAY_ACTION_INDX_WRITE:
+		if (roothealth_validate_index(target, guarded->target_object_size,
+				SIZE_MAX, NULL))
+			return -1;
+		break;
+	case RH_REPLAY_ACTION_RAW_WRITE:
+	case RH_REPLAY_ACTION_BITMAP_WRITE:
+		break;
+	default:
+		return -1;
+	}
+	switch (guarded->redo_operation) {
+	case AddIndexEntryRoot:
+	case DeleteIndexEntryRoot:
+	case SetIndexEntryVcnRoot:
+	case UpdateFileNameRoot:
+	case UpdateRecordDataRoot:
+	case UpdateRelativeDataInIndex:
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, SIZE_MAX, NULL, NULL))
+			return -1;
+		break;
+	default:
+		break;
+	}
+	if (!validate_operation)
+		return 0;
+
+	switch (guarded->redo_operation) {
+	case InitializeFileRecordSegment:
+		return 0;
+	case DeallocateFileRecordSegment: {
+		u16 target_flags = roothealth_load_u16(target + 22U);
+		u16 target_sequence = roothealth_load_u16(target + 16U);
+		u16 undo_flags = roothealth_load_u16(undo + 22U);
+		u16 undo_sequence = roothealth_load_u16(undo + 16U);
+
+		if (guarded->redo_length || guarded->undo_length != 24U ||
+			target_at || memcmp(undo, "FILE", 4) ||
+			roothealth_load_u16(undo + 4U) !=
+				roothealth_load_u16(target + 4U) ||
+			roothealth_load_u16(undo + 6U) !=
+				roothealth_load_u16(target + 6U) ||
+			!undo_sequence || undo_sequence == UINT16_MAX ||
+			!(undo_flags & MFT_RECORD_IN_USE) ||
+			roothealth_load_u16(undo + 18U) !=
+				roothealth_load_u16(target + 18U) ||
+			roothealth_load_u16(undo + 20U) !=
+				roothealth_load_u16(target + 20U))
+			return -1;
+		if (target_flags & MFT_RECORD_IN_USE) {
+			if (target_sequence != undo_sequence ||
+				target_flags != undo_flags)
+				return -1;
+		} else if (target_sequence != (u16)(undo_sequence + 1U) ||
+			target_flags != (u16)(undo_flags & ~MFT_RECORD_IN_USE)) {
+			return -1;
+		}
+		return 0;
+	}
+	case WriteEndofFileRecordSegment: {
+		size_t used = roothealth_load_u32(target + 24U);
+
+		if (guarded->attribute_offset || (guarded->record_offset & 7U) ||
+			guarded->record_offset < roothealth_load_u16(target + 20U) ||
+			guarded->record_offset > used - 8U ||
+			roothealth_validate_mft_tail(target + guarded->record_offset,
+				used - guarded->record_offset) ||
+			roothealth_validate_mft_tail(redo, guarded->redo_length) ||
+			roothealth_validate_mft_tail(undo, guarded->undo_length))
+			return -1;
+		return 0;
+	}
+	case CreateAttribute:
+	case DeleteAttribute: {
+		const unsigned char *payload = guarded->redo_operation ==
+			CreateAttribute ? redo : undo;
+		size_t payload_length = guarded->redo_operation ==
+			CreateAttribute ? guarded->redo_length : guarded->undo_length;
+		size_t bytes_in_use = roothealth_load_u32(target + 24);
+
+		if ((target_at & 7U) || target_at < roothealth_load_u16(target + 20) ||
+			target_at > bytes_in_use - 8U ||
+			roothealth_validate_attribute(payload, payload_length, 1, NULL))
+			return -1;
+		if (guarded->redo_operation == DeleteAttribute &&
+			(roothealth_validate_mft(target, guarded->target_object_size,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded), 1,
+				target_at, &attr) || attr.length != payload_length))
+			return -1;
+		return 0;
+	}
+	case UpdateResidentValue:
+		if (roothealth_validate_mft(target, guarded->target_object_size,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded), 1,
+				guarded->record_offset, &attr) || attr.nonresident ||
+			target_at < attr.offset + attr.value_offset ||
+			!roothealth_range(attr.offset + attr.length, target_at,
+				guarded->redo_length) ||
+			target_at + guarded->redo_length >
+				attr.offset + attr.value_offset + attr.value_length)
+			return -1;
+		return 0;
+	case UpdateNonResidentValue:
+		return 0;
+	case UpdateMappingPairs:
+		if (roothealth_validate_mft(target, guarded->target_object_size,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded), 1,
+				guarded->record_offset, &attr) || !attr.nonresident ||
+				guarded->attribute_offset != attr.mapping_offset ||
+			roothealth_validate_mapping_pairs(redo, guarded->redo_length) ||
+			roothealth_validate_mapping_pairs(undo, guarded->undo_length))
+			return -1;
+		return 0;
+	case SetNewAttributeSizes:
+		if (guarded->attribute_offset ||
+			roothealth_validate_mft(target, guarded->target_object_size,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded), 1,
+				guarded->record_offset, &attr) || !attr.nonresident ||
+			roothealth_validate_sizes(redo, guarded->redo_length) ||
+			roothealth_validate_sizes(undo, guarded->undo_length))
+			return -1;
+		return 0;
+	case AddIndexEntryAllocation:
+	case DeleteIndexEntryAllocation: {
+		const unsigned char *payload = guarded->redo_operation ==
+			AddIndexEntryAllocation ? redo : undo;
+		size_t payload_length = guarded->redo_operation ==
+			AddIndexEntryAllocation ? guarded->redo_length :
+			guarded->undo_length;
+
+		if (guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			roothealth_validate_index_entry(payload, payload_length,
+				&entry_length, 0) || entry_length != payload_length)
+			return -1;
+		return 0;
+	}
+	case AddIndexEntryRoot:
+	case DeleteIndexEntryRoot: {
+		const unsigned char *payload = guarded->redo_operation ==
+			AddIndexEntryRoot ? redo : undo;
+		size_t payload_length = guarded->redo_operation ==
+			AddIndexEntryRoot ? guarded->redo_length : guarded->undo_length;
+		size_t current_length;
+
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &current_length,
+				&root_view) ||
+			roothealth_validate_index_entry(payload, payload_length,
+				&entry_length, 0) || entry_length != payload_length ||
+			(roothealth_load_u16(payload + 12U) & 2U))
+			return -1;
+		if (guarded->redo_operation == DeleteIndexEntryRoot &&
+			current_length != payload_length)
+			return -1;
+		return 0;
+	}
+	case WriteEndOfIndexBuffer:
+		if (guarded->record_offset || (target_at & 7U) ||
+			!roothealth_range(guarded->target_object_size, target_at,
+				guarded->redo_length))
+			return -1;
+		return 0;
+	case SetIndexEntryVcnAllocation:
+		if (guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			roothealth_validate_index_entry(target + guarded->attribute_offset,
+				entry_length, NULL, 1))
+			return -1;
+		return 0;
+	case SetIndexEntryVcnRoot:
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &entry_length,
+				&root_view) ||
+			roothealth_validate_index_entry(target + target_at,
+				entry_length, NULL, 1))
+			return -1;
+		return 0;
+	case UpdateFileNameRoot:
+		if (guarded->redo_length != 56U || guarded->undo_length != 56U ||
+			roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &entry_length,
+				&root_view) || root_view.indexed_type != 0x30U ||
+			(roothealth_load_u16(target + target_at + 12U) & 2U) ||
+			roothealth_load_u16(target + target_at + 10U) < 66U ||
+			!roothealth_range(entry_length, 24U, 56U))
+			return -1;
+		return 0;
+	case UpdateFileNameAllocation:
+		if (guarded->redo_length != 56U || guarded->undo_length != 56U ||
+			guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			(roothealth_load_u16(target + guarded->attribute_offset + 12U) & 2U) ||
+			roothealth_load_u16(target + guarded->attribute_offset + 10U) < 66U ||
+			!roothealth_range(entry_length, 24U, 56U))
+			return -1;
+		return 0;
+	case SetBitsInNonResidentBitMap:
+	case ClearBitsInNonResidentBitMap:
+		return 0;
+	case UpdateRecordDataAllocation:
+	{
+		u16 data_offset, data_length;
+
+		if (guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			guarded->redo_length != guarded->undo_length ||
+			!guarded->redo_length)
+			return -1;
+		data_offset = roothealth_load_u16(target + guarded->attribute_offset);
+		data_length = roothealth_load_u16(target + guarded->attribute_offset + 2U);
+		if (data_offset < 16U || data_offset > entry_length ||
+			data_length > entry_length - data_offset ||
+			guarded->redo_length > data_length)
+			return -1;
+		return 0;
+	}
+	case UpdateRecordDataRoot: {
+		u16 data_offset, data_length;
+
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &entry_length,
+				&root_view) || root_view.indexed_type ||
+			(guarded->redo_length != guarded->undo_length) ||
+			!guarded->redo_length)
+			return -1;
+		data_offset = roothealth_load_u16(target + target_at);
+		data_length = roothealth_load_u16(target + target_at + 2U);
+		if (data_offset < 16U || data_offset > entry_length ||
+			data_length > entry_length - data_offset ||
+			guarded->redo_length > data_length)
+			return -1;
+		return 0;
+	}
+	case UpdateRelativeDataInIndex: {
+		u16 data_offset, data_length;
+
+		if (roothealth_validate_index_root(target,
+				guarded->target_object_size,
+				roothealth_action_record_number(guarded),
+				guarded->record_offset, target_at, &entry_length,
+				&root_view) || root_view.indexed_type ||
+			(guarded->redo_length != 4U && guarded->redo_length != 8U) ||
+			guarded->undo_length != guarded->redo_length)
+			return -1;
+		data_offset = roothealth_load_u16(target + target_at);
+		data_length = roothealth_load_u16(target + target_at + 2U);
+		if (data_offset < 16U || data_offset > entry_length ||
+			data_length > entry_length - data_offset ||
+			guarded->redo_length > data_length)
+			return -1;
+		return 0;
+	}
+	case UpdateRelativeDataInIndex2: {
+		u16 data_offset, data_length;
+
+		if (guarded->record_offset ||
+			roothealth_validate_index(target, guarded->target_object_size,
+				guarded->attribute_offset, &entry_length) ||
+			(guarded->redo_length != 4U && guarded->redo_length != 8U) ||
+			guarded->undo_length != guarded->redo_length)
+			return -1;
+		data_offset = roothealth_load_u16(target + guarded->attribute_offset);
+		data_length = roothealth_load_u16(target +
+			guarded->attribute_offset + 2U);
+		if (data_offset < 16U || data_offset > entry_length ||
+			data_length > entry_length - data_offset ||
+			guarded->redo_length > data_length)
+			return -1;
+		return 0;
+	}
+	case ZeroEndOfFileRecord:
+		if (target_at < roothealth_load_u32(target + 24U) ||
+			target_at + guarded->redo_length != guarded->target_object_size)
+			return -1;
+		return 0;
+	default:
+		return -1;
+	}
+}
+
+/*
+ *		Play the redo actions from earliest to latest
+ *
+ *	Currently we can only redo the last undone transaction,
+ *	otherwise the attribute table would be out of phase.
+ */
+
+static int roothealth_semantic_images_equal(
+		const struct rh_replay_action_view *guarded,
+		const unsigned char *left, const unsigned char *right)
+{
+	if (guarded->redo_operation == DeallocateFileRecordSegment)
+		return !memcmp(left, right, 8U) &&
+			!memcmp(left + 16U, right + 16U,
+				guarded->target_object_size - 16U);
+	return !memcmp(left, right, guarded->target_object_size);
+}
+
+static int roothealth_semantic_cycle(ntfs_volume *vol,
+		const struct ACTION_RECORD *action, unsigned char *target,
+		const struct rh_replay_action_view *guarded)
+{
+	unsigned char *work = NULL;
+	size_t value_offset;
+	int err = -1;
+
+	if (!target || !guarded || !guarded->target_object_size ||
+		roothealth_validate_semantic_target(action, target, guarded, 1, 1))
+		return -1;
+	value_offset = (size_t)guarded->record_offset + guarded->attribute_offset;
+	if (guarded->redo_operation == InitializeFileRecordSegment) {
+		if (guarded->action_class != RH_REPLAY_ACTION_MFT_WRITE ||
+			guarded->undo_operation != Noop)
+			return -1;
+		work = (unsigned char *)malloc(guarded->target_object_size);
+		if (!work)
+			return -1;
+		memcpy(work, target, guarded->target_object_size);
+		roothealth_semantic_preflight = 1;
+		err = distribute_redos(vol, action, (char *)work) ||
+			roothealth_validate_semantic_target(action, work, guarded, 0, 0);
+		roothealth_semantic_preflight = 0;
+		free(work);
+		return err ? -1 : 0;
+	}
+	if (guarded->redo_operation == ZeroEndOfFileRecord) {
+		if (guarded->action_class != RH_REPLAY_ACTION_MFT_WRITE ||
+			guarded->undo_operation != Noop)
+			return -1;
+		work = (unsigned char *)malloc(guarded->target_object_size);
+		if (!work)
+			return -1;
+		memcpy(work, target, guarded->target_object_size);
+		roothealth_semantic_preflight = 1;
+		err = distribute_redos(vol, action, (char *)work) ||
+			roothealth_validate_semantic_target(action, work, guarded, 0, 0) ||
+			memcmp(work, target, value_offset) ||
+			!roothealth_all_zero(work + value_offset,
+				guarded->target_object_size - value_offset);
+		roothealth_semantic_preflight = 0;
+		free(work);
+		return err ? -1 : 0;
+	}
+	if (guarded->undo_operation == Noop ||
+		guarded->undo_operation == CompensationlogRecord)
+		return -1;
+	work = (unsigned char *)malloc(guarded->target_object_size);
+	if (!work)
+		return -1;
+
+	/*
+	 * A deallocation record has two structurally distinct endpoints.  When
+	 * the FILE record already carries the logged deallocated after-image,
+	 * redo is intentionally inapplicable (the sequence number must not be
+	 * incremented twice).  Prove the inverse cycle directly instead.
+	 */
+	if (guarded->redo_operation == DeallocateFileRecordSegment &&
+		!(((const MFT_RECORD *)target)->flags & MFT_RECORD_IN_USE))
+		goto after_image;
+
+	/* Before image: redo followed by inverse undo must restore every byte. */
+	memcpy(work, target, guarded->target_object_size);
+	roothealth_semantic_preflight = 1;
+	if (!distribute_redos(vol, action, (char *)work) &&
+		!roothealth_validate_semantic_target(action, work, guarded, 0, 0) &&
+		!distribute_undos(vol, action, (char *)work) &&
+		!roothealth_validate_semantic_target(action, work, guarded, 0, 0) &&
+		roothealth_semantic_images_equal(guarded, work, target))
+		err = 0;
+	roothealth_semantic_preflight = 0;
+	if (!err)
+		goto out;
+
+after_image:
+	/* After image: inverse undo followed by redo must restore every byte. */
+	memcpy(work, target, guarded->target_object_size);
+	roothealth_semantic_preflight = 1;
+	if (!distribute_undos(vol, action, (char *)work) &&
+		!roothealth_validate_semantic_target(action, work, guarded, 0, 0) &&
+		!distribute_redos(vol, action, (char *)work) &&
+		!roothealth_validate_semantic_target(action, work, guarded, 0, 0) &&
+		roothealth_semantic_images_equal(guarded, work, target))
+		err = 0;
+	roothealth_semantic_preflight = 0;
+out:
+	free(work);
+	return err;
+}
+
+struct roothealth_preflight_target {
+	struct roothealth_preflight_target *next;
+	enum rh_replay_action_class action_class;
+	uint64_t first_lcn;
+	size_t target_slice_offset;
+	size_t target_object_size;
+	unsigned char *bytes;
+};
+
+static void roothealth_free_preflight_targets(
+		struct roothealth_preflight_target *target)
+{
+	while (target) {
+		struct roothealth_preflight_target *next = target->next;
+		free(target->bytes);
+		free(target);
+		target = next;
+	}
+}
+
+static int roothealth_preflight_action_applied(
+		const struct roothealth_preflight_target *target,
+		const struct rh_replay_action_view *guarded)
+{
+	u64 target_lsn;
+
+	if (guarded->action_class != RH_REPLAY_ACTION_MFT_WRITE &&
+		guarded->action_class != RH_REPLAY_ACTION_INDX_WRITE)
+		return 0;
+	target_lsn = roothealth_load_u64(target->bytes + 8U);
+	return (s64)(target_lsn - guarded->this_lsn) >= 0 &&
+		(s64)(target_lsn - latest_lsn) <= 0;
+}
+
+static void roothealth_preflight_set_lsn(
+		struct roothealth_preflight_target *target,
+		const struct rh_replay_action_view *guarded)
+{
+	le64 value;
+
+	if (guarded->action_class != RH_REPLAY_ACTION_MFT_WRITE &&
+		guarded->action_class != RH_REPLAY_ACTION_INDX_WRITE)
+		return;
+	value = cpu_to_le64(guarded->this_lsn);
+	memcpy(target->bytes + 8U, &value, sizeof(value));
+}
+
+static int roothealth_attribute_target_matches(ntfs_volume *vol,
+		const struct ACTION_RECORD *action,
+		const struct rh_replay_action_view *guarded)
+{
+	struct ATTR *pa;
+	ntfs_inode *ni = NULL;
+	ntfs_attr *na = NULL;
+	ATTR_TYPES type;
+	LCN expected;
+	uint64_t stream_at;
+	uint64_t stream_bytes;
+	int result = -1;
+	int is_i30;
+
+	if (!vol || !action || !guarded || guarded->lcn_count != 1U)
+		return -1;
+	pa = findattrentry(le16_to_cpu(action->record.target_attribute));
+	if (!pa || !pa->type || !pa->reference || (pa->namelen & 1U))
+		return -1;
+	type = (ATTR_TYPES)pa->type;
+	is_i30 = pa->namelen == 8U &&
+		le16_to_cpu(pa->name[0]) == '$' &&
+		le16_to_cpu(pa->name[1]) == 'I' &&
+		le16_to_cpu(pa->name[2]) == '3' &&
+		le16_to_cpu(pa->name[3]) == '0';
+	if (guarded->action_class == RH_REPLAY_ACTION_MFT_WRITE) {
+		if (type != AT_DATA || MREF(pa->reference) != FILE_MFT ||
+			pa->namelen || pa->bytes_per_index)
+			return -1;
+	} else if (guarded->action_class == RH_REPLAY_ACTION_INDX_WRITE) {
+		if (type != AT_INDEX_ALLOCATION ||
+			pa->bytes_per_index != vol->indx_record_size)
+			return -1;
+		if ((guarded->redo_operation == UpdateFileNameAllocation && !is_i30) ||
+			(guarded->redo_operation == UpdateRecordDataAllocation && is_i30) ||
+			(guarded->redo_operation == UpdateRelativeDataInIndex2 && is_i30))
+			return -1;
+	} else if (guarded->action_class != RH_REPLAY_ACTION_RAW_WRITE &&
+		guarded->action_class != RH_REPLAY_ACTION_BITMAP_WRITE) {
+		return -1;
+	} else if (type == AT_INDEX_ALLOCATION) {
+		return -1;
+	}
+	if (guarded->action_class == RH_REPLAY_ACTION_RAW_WRITE &&
+		(type == AT_BITMAP || MREF(pa->reference) == FILE_MFT ||
+		 MREF(pa->reference) == FILE_MFTMirr ||
+		 MREF(pa->reference) == FILE_Bitmap))
+		return -1;
+	if (guarded->action_class == RH_REPLAY_ACTION_BITMAP_WRITE &&
+		type != AT_BITMAP &&
+		!(type == AT_DATA && MREF(pa->reference) == FILE_Bitmap))
+		return -1;
+	/* $LogFile may never be a replay mutation target. */
+	if (MREF(pa->reference) == FILE_LogFile)
+		return -1;
+	ni = ntfs_inode_open(vol, (MFT_REF)pa->reference);
+	if (!ni)
+		goto out;
+	na = ntfs_attr_open(ni, type,
+		pa->namelen ? pa->name : AT_UNNAMED, pa->namelen / 2U);
+	if (!na || !NAttrNonResident(na))
+		goto out;
+	if (na->allocated_size < 0 || na->data_size < 0 ||
+		guarded->target_vcn > UINT64_MAX / clustersz)
+		goto out;
+	stream_at = guarded->target_vcn * clustersz;
+	if (stream_at > (uint64_t)na->allocated_size ||
+		clustersz > (uint64_t)na->allocated_size - stream_at)
+		goto out;
+	expected = roothealth_attr_vcn_to_lcn(na, (VCN)guarded->target_vcn);
+	if (expected < 0 || expected != (LCN)guarded->first_lcn)
+		goto out;
+	if (guarded->action_class == RH_REPLAY_ACTION_BITMAP_WRITE) {
+		const unsigned char *record =
+			(const unsigned char *)&action->record;
+		uint64_t first = getle32((const char *)record,
+			(int)guarded->redo_data_offset);
+		uint64_t count = getle32((const char *)record,
+			(int)guarded->redo_data_offset + 4);
+
+		if (stream_at >= (uint64_t)na->data_size)
+			goto out;
+		stream_bytes = (uint64_t)na->data_size - stream_at;
+		if (stream_bytes > clustersz)
+			stream_bytes = clustersz;
+		if (first >= stream_bytes * 8U ||
+			count > stream_bytes * 8U - first)
+			goto out;
+	}
+	result = 0;
+out:
+	if (na)
+		ntfs_attr_close(na);
+	if (ni)
+		ntfs_inode_close(ni);
+	return result;
+}
+
+static int roothealth_initialize_seal_matches(
+		const struct rh_replay_initialize_intent *intent,
+		const struct rh_replay_slot_authority_seal *seal)
+{
+	return intent && seal &&
+		seal->version == RH_REPLAY_SLOT_AUTHORITY_SEAL_VERSION &&
+		!seal->reserved32 && !seal->reserved16 && !seal->reserved_flags &&
+		!seal->reserved8 && seal->generation &&
+		seal->volume_serial == intent->volume_serial &&
+		seal->record_number == intent->record_number &&
+		seal->physical_offset == intent->physical_offset &&
+		seal->mft_vcn == intent->mft_vcn &&
+		seal->mft_lcn == intent->mft_lcn &&
+		seal->owner_sequence == intent->owner_sequence &&
+		!memcmp(seal->journal_uuid, intent->journal_uuid,
+			sizeof(seal->journal_uuid)) &&
+		!memcmp(seal->raw_before_hash, intent->raw_before_hash,
+			sizeof(seal->raw_before_hash)) &&
+		!memcmp(seal->redo_payload_hash, intent->redo_payload_hash,
+			sizeof(seal->redo_payload_hash)) &&
+		!roothealth_all_zero(seal->mft_bitmap_census_hash,
+			sizeof(seal->mft_bitmap_census_hash)) &&
+		!roothealth_all_zero(seal->namespace_census_hash,
+			sizeof(seal->namespace_census_hash)) &&
+		!roothealth_all_zero(seal->mft_extent_mapping_hash,
+			sizeof(seal->mft_extent_mapping_hash)) &&
+		seal->mft_slots_completed > intent->record_number &&
+		seal->namespace_entries_examined && seal->identity_bound == 1U &&
+		seal->mft_bitmap_bit_clear == 1U &&
+		seal->namespace_census_complete == 1U &&
+		seal->slot_unreferenced == 1U && seal->extent_mapping_exact == 1U &&
+		seal->target_outside_wal == 1U &&
+		seal->target_outside_protected == 1U;
+}
+
+static int roothealth_authorize_initialize_slot(ntfs_volume *vol,
+		const struct ACTION_RECORD *action,
+		const struct rh_replay_action_view *guarded, uint64_t record_number,
+		const unsigned char *raw_before)
+{
+	const struct rh_replay_slot_authority_provider *provider =
+		rh_replay_slot_authority_provider;
+	struct rh_replay_initialize_intent intent;
+	struct rh_replay_slot_authority_seal seal;
+	struct rh_writer writer_snapshot;
+	unsigned char current[1024];
+	unsigned char boot[512];
+	unsigned char bitmap;
+	size_t operation_count, excluded_count, raw_wal_allowed_count;
+	uint64_t planned_bytes, physical_offset;
+	int result;
+
+	if (!vol || !action || !guarded || !raw_before || !provider ||
+		!rh_replay_writer || guarded->target_object_size != sizeof(current) ||
+		guarded->redo_length != sizeof(current) ||
+		guarded->first_lcn > UINT64_MAX / clustersz ||
+		guarded->target_slice_offset > clustersz ||
+		sizeof(current) > clustersz - guarded->target_slice_offset)
+		return -1;
+	physical_offset = guarded->first_lcn * clustersz +
+		guarded->target_slice_offset;
+	if (physical_offset > rh_replay_writer->device_size ||
+		sizeof(current) > rh_replay_writer->device_size - physical_offset ||
+		rh_writer_range_excluded(rh_replay_writer, physical_offset,
+			sizeof(current)) ||
+		rh_writer_read(rh_replay_writer, 0, sizeof(boot), boot) ||
+		ntfs_attr_pread(vol->mftbmp_na, record_number >> 3, 1, &bitmap) != 1 ||
+		(bitmap & (1U << (record_number & 7U))))
+		return -1;
+	memset(&intent, 0, sizeof(intent));
+	intent.version = RH_REPLAY_SLOT_AUTHORITY_SEAL_VERSION;
+	intent.volume_serial = roothealth_load_u64(boot + 72U);
+	intent.record_number = record_number;
+	intent.physical_offset = physical_offset;
+	intent.mft_vcn = guarded->target_vcn;
+	intent.mft_lcn = (s64)guarded->first_lcn;
+	intent.owner_sequence = roothealth_load_u16(
+		(const unsigned char *)&action->record +
+		guarded->redo_data_offset + 16U);
+	memcpy(intent.journal_uuid, provider->expected_journal_uuid,
+		sizeof(intent.journal_uuid));
+	rh_sha256(raw_before, sizeof(current), intent.raw_before_hash);
+	rh_sha256((const unsigned char *)&action->record +
+		guarded->redo_data_offset, guarded->redo_length,
+		intent.redo_payload_hash);
+	if (!intent.volume_serial ||
+		intent.volume_serial != provider->expected_volume_serial ||
+		!intent.owner_sequence ||
+		roothealth_all_zero(intent.journal_uuid,
+			sizeof(intent.journal_uuid)))
+		return -1;
+	operation_count = rh_replay_writer->operation_count;
+	planned_bytes = rh_replay_writer->planned_bytes;
+	excluded_count = rh_replay_writer->excluded_count;
+	raw_wal_allowed_count = rh_replay_writer->raw_wal_allowed_count;
+	writer_snapshot = *rh_replay_writer;
+	memset(&seal, 0, sizeof(seal));
+	result = provider->authorize_initialize(provider->opaque, &intent, &seal);
+	if (result || memcmp(&writer_snapshot, rh_replay_writer,
+			sizeof(writer_snapshot)) ||
+		rh_replay_writer->operation_count != operation_count ||
+		rh_replay_writer->planned_bytes != planned_bytes ||
+		rh_replay_writer->excluded_count != excluded_count ||
+		rh_replay_writer->raw_wal_allowed_count != raw_wal_allowed_count ||
+		rh_writer_read(rh_replay_writer, physical_offset, sizeof(current),
+			current) ||
+		memcmp(current, raw_before, sizeof(current)) ||
+		!roothealth_initialize_seal_matches(&intent, &seal))
+		return -1;
+	return 0;
+}
+
+static struct roothealth_preflight_target *roothealth_get_preflight_target(
+		ntfs_volume *vol, const struct ACTION_RECORD *action,
+		const struct rh_replay_action_view *guarded,
+		struct roothealth_preflight_target **targets)
+{
+	struct roothealth_preflight_target *target;
+	const LOG_RECORD *record = &action->record;
+	LCN expected_lcn;
+
+	/* Bind every action, including cache hits, to its owning open attribute. */
+	switch (guarded->action_class) {
+	case RH_REPLAY_ACTION_MFT_WRITE:
+	case RH_REPLAY_ACTION_INDX_WRITE:
+	case RH_REPLAY_ACTION_RAW_WRITE:
+	case RH_REPLAY_ACTION_BITMAP_WRITE:
+		if (roothealth_attribute_target_matches(vol, action, guarded))
+			return NULL;
+		break;
+	default:
+		return NULL;
+	}
+	for (target = *targets; target; target = target->next)
+		if (target->action_class == guarded->action_class &&
+			target->first_lcn == guarded->first_lcn &&
+			target->target_slice_offset == guarded->target_slice_offset &&
+			target->target_object_size == guarded->target_object_size)
+			return target;
+	target = (struct roothealth_preflight_target *)calloc(1, sizeof(*target));
+	if (!target)
+		return NULL;
+	target->action_class = guarded->action_class;
+	target->first_lcn = guarded->first_lcn;
+	target->target_slice_offset = guarded->target_slice_offset;
+	target->target_object_size = guarded->target_object_size;
+	switch (guarded->action_class) {
+	case RH_REPLAY_ACTION_MFT_WRITE: {
+		uint64_t record_number;
+		unsigned char *raw = NULL;
+		const MFT_RECORD *entry;
+
+		expected_lcn = roothealth_attr_vcn_to_lcn(vol->mft_na,
+			(VCN)guarded->target_vcn);
+		if (expected_lcn < 0 || expected_lcn != (LCN)guarded->first_lcn)
+			goto fail;
+		record_number = guarded->target_vcn *
+			((uint64_t)clustersz / mftrecsz) +
+			guarded->target_slice_offset / mftrecsz;
+		if (vol->mft_na->initialized_size < 0 ||
+			vol->mft_na->allocated_size < 0 ||
+			record_number >= (uint64_t)vol->mft_na->allocated_size /
+				mftrecsz ||
+			(guarded->redo_operation != InitializeFileRecordSegment &&
+			 record_number >= (uint64_t)vol->mft_na->initialized_size /
+				mftrecsz))
+			goto fail;
+		if (record_number < 4U) {
+			LCN mirror_lcn = roothealth_attr_vcn_to_lcn(vol->mftmirr_na,
+				(VCN)guarded->target_vcn);
+			if (mirror_lcn < 0 || mirror_lcn == expected_lcn ||
+				(uint64_t)mirror_lcn >= (uint64_t)vol->nr_clusters)
+				goto fail;
+		}
+		if (guarded->redo_operation == InitializeFileRecordSegment) {
+			u64 target_lsn;
+
+			entry = (const MFT_RECORD *)((const unsigned char *)record +
+				guarded->redo_data_offset);
+			if (record_number <= 3U ||
+				roothealth_validate_mft((const unsigned char *)entry,
+					guarded->redo_length, mftrecsz, record_number, 0,
+					SIZE_MAX, NULL))
+				goto fail;
+			/* An exact, LSN-proven after-image is a zero-write action. */
+			target->bytes = (unsigned char *)read_protected(vol, record,
+				mftrecsz, TRUE);
+			if (target->bytes &&
+				!roothealth_validate_mft(target->bytes, mftrecsz,
+					mftrecsz, record_number, 0, SIZE_MAX, NULL) &&
+				!memcmp(target->bytes, entry, mftrecsz)) {
+				target_lsn = roothealth_load_u64(target->bytes + 8U);
+				if ((s64)(target_lsn - guarded->this_lsn) >= 0 &&
+					(s64)(target_lsn - latest_lsn) <= 0)
+					break;
+			}
+			free(target->bytes);
+			target->bytes = NULL;
+			raw = (unsigned char *)read_raw(vol, record);
+			if (raw && !roothealth_authorize_initialize_slot(vol, action,
+					guarded, record_number, raw +
+					guarded->target_slice_offset)) {
+				target->bytes = (unsigned char *)malloc(mftrecsz);
+				if (target->bytes)
+					memcpy(target->bytes, raw +
+						guarded->target_slice_offset, mftrecsz);
+				free(raw);
+				if (target->bytes)
+					break;
+			} else {
+				free(raw);
+			}
+			/*
+			 * The typed writer can bind any exact stale 1 KiB preimage, but
+			 * parser acceptance stays closed until the main checker supplies
+			 * an immutable seal proving the pre-transaction MFT bitmap bit is
+			 * clear, the complete namespace census has no reference to this
+			 * slot, the $MFT extent is exact, and the sealed range is outside
+			 * the WAL/protected extents.  The current bitmap-only census cannot
+			 * make that namespace statement, so no Initialize action is allowed
+			 * to reach the planner through the legacy, provider-free API.
+			 */
+			fprintf(stderr, "** InitializeFileRecordSegment lacks sealed "
+				"pre-transaction slot authority for record %llu\n",
+				(unsigned long long)record_number);
+			goto fail;
+		}
+		target->bytes = (unsigned char *)read_protected(vol, record,
+			mftrecsz, TRUE);
+		if (target->bytes && guarded->redo_operation !=
+				InitializeFileRecordSegment) {
+			entry = (const MFT_RECORD *)target->bytes;
+			if (entry->magic != magic_FILE ||
+				le32_to_cpu(entry->mft_record_number) != record_number ||
+				!le16_to_cpu(entry->sequence_number) ||
+				(guarded->redo_operation != DeallocateFileRecordSegment &&
+				 !(le16_to_cpu(entry->flags) & MFT_RECORD_IN_USE))) {
+				free(target->bytes);
+				target->bytes = NULL;
+			}
+		}
+		break;
+	}
+	case RH_REPLAY_ACTION_INDX_WRITE:
+		target->bytes = (unsigned char *)read_protected(vol, record,
+			vol->indx_record_size, TRUE);
+		break;
+	case RH_REPLAY_ACTION_RAW_WRITE:
+	case RH_REPLAY_ACTION_BITMAP_WRITE:
+		target->bytes = (unsigned char *)read_raw(vol, record);
+		break;
+	default:
+		goto fail;
+	}
+	if (!target->bytes)
+		goto fail;
+	target->next = *targets;
+	*targets = target;
+	return target;
+fail:
+	free(target->bytes);
+	free(target);
+	return NULL;
+}
+
+static int roothealth_preflight_sequence(ntfs_volume *vol,
+		const struct ACTION_RECORD *firstaction)
+{
+	struct roothealth_preflight_target *targets = NULL;
+	const struct ACTION_RECORD *action;
+	const struct ACTION_RECORD *lastaction = NULL;
+	struct rh_replay_geometry geometry;
+	int err = -1;
+
+	memset(&geometry, 0, sizeof(geometry));
+	geometry.page_size = blocksz;
+	geometry.cluster_size = clustersz;
+	geometry.mft_record_size = mftrecsz;
+	geometry.index_record_size = vol->indx_record_size;
+	geometry.logfile_size = logfilesz;
+	geometry.volume_clusters = vol->nr_clusters;
+	geometry.sequence_bits = le32_to_cpu(restart.seq_number_bits);
+	geometry.client_sequence = le16_to_cpu(client.seq_number);
+	geometry.client_index = 0U;
+	for (action = firstaction; action; action = action->next) {
+		struct rh_replay_action_view guarded;
+		struct roothealth_preflight_target *target;
+		size_t record_size = (size_t)le32_to_cpu(
+			action->record.client_data_length) + LOG_RECORD_HEAD_SZ;
+
+		lastaction = action;
+		if (rh_replay_guard_action((const unsigned char *)&action->record,
+				record_size, &geometry, RH_REPLAY_SOURCE_UNKNOWN, &guarded)) {
+			fprintf(stderr, "** Structural preflight failed for action %d\n",
+				action->num);
+			goto out;
+		}
+		if (!(action->flags & ACTION_TO_REDO))
+			continue;
+		target = roothealth_get_preflight_target(vol, action, &guarded,
+			&targets);
+		if (!target || roothealth_semantic_cycle(vol, action, target->bytes,
+				&guarded)) {
+			fprintf(stderr, "** Semantic preflight failed for action %d %s\n",
+				action->num, actionname(guarded.redo_operation));
+			goto out;
+		}
+		if (roothealth_preflight_action_applied(target, &guarded))
+			continue;
+		roothealth_semantic_preflight = 1;
+		if (distribute_redos(vol, action, (char *)target->bytes)) {
+			roothealth_semantic_preflight = 0;
+			fprintf(stderr, "** Redo simulation failed for action %d\n",
+				action->num);
+			goto out;
+		}
+		roothealth_semantic_preflight = 0;
+		roothealth_preflight_set_lsn(target, &guarded);
+	}
+	for (action = lastaction; action; action = action->prev) {
+		struct rh_replay_action_view guarded;
+		struct roothealth_preflight_target *target;
+		size_t record_size;
+
+		if (!(action->flags & ACTION_TO_UNDO))
+			continue;
+		record_size = (size_t)le32_to_cpu(action->record.client_data_length) +
+			LOG_RECORD_HEAD_SZ;
+		if (rh_replay_guard_action((const unsigned char *)&action->record,
+				record_size, &geometry, RH_REPLAY_SOURCE_UNKNOWN, &guarded))
+			goto out;
+		target = roothealth_get_preflight_target(vol, action, &guarded,
+			&targets);
+		if (!target)
+			goto out;
+		if (!roothealth_preflight_action_applied(target, &guarded))
+			continue;
+		roothealth_semantic_preflight = 1;
+		if (distribute_undos(vol, action, (char *)target->bytes)) {
+			roothealth_semantic_preflight = 0;
+			fprintf(stderr, "** Undo simulation failed for action %d\n",
+				action->num);
+			goto out;
+		}
+		roothealth_semantic_preflight = 0;
+		roothealth_preflight_set_lsn(target, &guarded);
+	}
+	err = 0;
+out:
+	roothealth_semantic_preflight = 0;
+	roothealth_free_preflight_targets(targets);
+	return err;
+}
+
+static int roothealth_preflight_redos(ntfs_volume *vol,
+		const struct ACTION_RECORD *firstaction)
+{
+	const struct ACTION_RECORD *action;
+	unsigned int data_count = 0;
+	unsigned int action_count = 0;
+
+	for (action = firstaction; action; action = action->next) {
+		const LOG_RECORD *record = &action->record;
+		struct rh_replay_geometry geometry;
+		struct rh_replay_action_view guarded;
+		size_t record_size =
+			(size_t)le32_to_cpu(record->client_data_length) +
+			LOG_RECORD_HEAD_SZ;
+
+		memset(&geometry, 0, sizeof(geometry));
+		geometry.page_size = blocksz;
+		geometry.cluster_size = clustersz;
+		geometry.mft_record_size = mftrecsz;
+		geometry.index_record_size = vol->indx_record_size;
+		geometry.logfile_size = logfilesz;
+		geometry.volume_clusters = vol->nr_clusters;
+		geometry.sequence_bits = le32_to_cpu(restart.seq_number_bits);
+		geometry.client_sequence = le16_to_cpu(client.seq_number);
+		geometry.client_index = 0U;
+		if (++action_count > RH_REPLAY_MAX_ACTIONS ||
+			rh_replay_guard_action((const unsigned char *)record,
+				record_size, &geometry, RH_REPLAY_SOURCE_UNKNOWN,
+				&guarded) || guarded.this_lsn < synced_lsn ||
+			guarded.this_lsn > latest_lsn)
+			return -1;
+		switch (guarded.action_class) {
+		case RH_REPLAY_ACTION_MFT_WRITE:
+		case RH_REPLAY_ACTION_INDX_WRITE:
+		case RH_REPLAY_ACTION_RAW_WRITE:
+		case RH_REPLAY_ACTION_BITMAP_WRITE:
+			if (!(action->flags & ACTION_TO_REDO))
+				return -1;
+			if (++data_count > RH_REPLAY_MAX_ACTIONS - 1U)
+				return -1;
+			break;
+		case RH_REPLAY_ACTION_CHECKPOINT:
+		case RH_REPLAY_ACTION_CONTROL:
+		case RH_REPLAY_ACTION_TRANSACTION_END:
+			if (action->flags & (ACTION_TO_REDO | ACTION_TO_UNDO))
+				return -1;
+			break;
+		default:
+			return -1;
+		}
+	}
+	if (!data_count || !action_count)
+		return -1;
+	/* Resolve and simulate every target only after the pure structural pass. */
+	return roothealth_preflight_sequence(vol, firstaction);
+}
+
+int play_redos(ntfs_volume *vol, const struct ACTION_RECORD *firstaction)
+{
+	const struct ACTION_RECORD *action;
+	int err;
+
+	err = roothealth_preflight_redos(vol, firstaction);
+	action = firstaction;
+	while (action && !err) {
+			/* Only committed actions should be redone */
+		if ((!optc || within_lcn_range(&action->record))
+		    && (action->flags & ACTION_TO_REDO))
+			err = play_one_redo(vol, action);
+		if (!err)
+			action = action->next;
+	}
+	return (err);
+}
+
+static int distribute_undos(ntfs_volume *vol, const struct ACTION_RECORD *action,
+			char *buffer)
+{
+	int rop, uop;
+	int err;
+
+	err = 1;
+	rop = le16_to_cpu(action->record.redo_operation);
+	uop = le16_to_cpu(action->record.undo_operation);
+	switch (rop) {
+	case AddIndexEntryAllocation :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(DeleteIndexEntryAllocation))
+			err = undo_add_index(vol, action, buffer);
+		break;
+	case AddIndexEntryRoot :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(DeleteIndexEntryRoot))
+			err = undo_add_root_index(vol, action, buffer);
+		break;
+	case ClearBitsInNonResidentBitMap :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(SetBitsInNonResidentBitMap))
+			err = undo_force_bits(vol, action, buffer);
+		break;
+	case CreateAttribute :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(DeleteAttribute))
+			err = undo_create_attribute(vol, action, buffer);
+		break;
+	case DeallocateFileRecordSegment :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(InitializeFileRecordSegment))
+			err = undo_delete_file(vol, action, buffer);
+		break;
+	case DeleteAttribute :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(CreateAttribute))
+			err = undo_delete_attribute(vol, action, buffer);
+		break;
+	case DeleteIndexEntryAllocation :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(AddIndexEntryAllocation))
+			err = undo_delete_index(vol, action, buffer);
+		break;
+	case DeleteIndexEntryRoot :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(AddIndexEntryRoot))
+			err = undo_delete_root_index(vol, action, buffer);
+		break;
+	case InitializeFileRecordSegment :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(Noop))
+			err = undo_create_file(vol, action, buffer);
+		break;
+	case OpenNonResidentAttribute :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(Noop))
+			err = undo_open_attribute(vol, action);
+		break;
+	case SetBitsInNonResidentBitMap :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(ClearBitsInNonResidentBitMap))
+			err = undo_force_bits(vol, action, buffer);
+		break;
+	case SetIndexEntryVcnAllocation :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(SetIndexEntryVcnAllocation))
+			err = undo_update_vcn(vol, action, buffer);
+		break;
+	case SetIndexEntryVcnRoot :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(SetIndexEntryVcnRoot))
+			err = undo_update_root_vcn(vol, action, buffer);
+		break;
+	case SetNewAttributeSizes :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(SetNewAttributeSizes))
+			err = undo_sizes(vol, action, buffer);
+		break;
+	case UpdateFileNameAllocation :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(UpdateFileNameAllocation))
+			err = undo_update_index(vol, action, buffer);
+		break;
+	case UpdateFileNameRoot :
+		if (action->record.undo_operation
+		        == const_cpu_to_le16(UpdateFileNameRoot))
+			err = undo_update_root_index(vol, action, buffer);
+		break;
+	case UpdateMappingPairs :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(UpdateMappingPairs))
+			err = undo_update_mapping(vol, action, buffer);
+		break;
+	case UpdateNonResidentValue :
+		if (uop == UpdateNonResidentValue) {
+			switch (get_action_kind(action)) {
+			case ON_INDX :
+				err = undo_update_index_value(vol, action, buffer);
+				break;
+			case ON_RAW :
+				err = undo_update_value(vol, action, buffer);
+				break;
+			default :
+				printf("** Bad attribute type\n");
+				break;
+			}
+		}
+		break;
+	case UpdateResidentValue :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(UpdateResidentValue))
+			err = undo_update_resident(vol, action, buffer);
+		break;
+	case UpdateRecordDataRoot :
+		if (uop == UpdateRecordDataRoot)
+			err = update_record_data(vol, action, buffer, TRUE, FALSE);
+		break;
+	case UpdateRecordDataAllocation :
+		if (uop == UpdateRecordDataAllocation)
+			err = update_record_data(vol, action, buffer, TRUE, TRUE);
+		break;
+	case UpdateRelativeDataInIndex :
+		if (uop == UpdateRelativeDataInIndex)
+			err = update_relative_index_data(vol, action, buffer, TRUE, FALSE);
+		break;
+	case UpdateRelativeDataInIndex2 :
+		if (uop == UpdateRelativeDataInIndex2)
+			err = update_relative_index_data(vol, action, buffer, TRUE, TRUE);
+		break;
+	case ZeroEndOfFileRecord :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(Noop))
+			err = undo_action37(vol, action, buffer);
+		break;
+	case WriteEndofFileRecordSegment :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(WriteEndofFileRecordSegment))
+			err = undo_write_end(vol, action, buffer);
+		break;
+	case WriteEndOfIndexBuffer :
+		if (action->record.undo_operation
+		    == const_cpu_to_le16(WriteEndOfIndexBuffer))
+			err = undo_write_index(vol, action, buffer);
+		break;
+	case AttributeNamesDump :
+	case CompensationlogRecord :
+	case DirtyPageTableDump :
+	case ForgetTransaction :
+	case Noop :
+	case OpenAttributeTableDump :
+		break;
+	default :
+		printf("** Unsupported undo %s\n", actionname(rop));
+		err = 1;
+		break;
+	}
+	if (err)
+		printf("* Undoing action %d %s (%s) failed\n",
+			action->num,actionname(rop), actionname(uop));
+	return (err);
+}
+
+/*
+ *		Undo a single action
+ *
+ *	The record the action acts on is read and, when it is an MFT or
+ *	INDX one, the need for undoing is checked.
+ */
+
+static int play_one_undo(ntfs_volume *vol, const struct ACTION_RECORD *action)
+{
+	MFT_RECORD *entry;
+	INDEX_BLOCK *indx;
+	char *buffer;
+	u32 xsize;
+	u16 rop;
+	u16 uop;
+	int err;
+	BOOL executed;
+	enum ACTION_KIND kind;
+
+	err = 0;
+	rop = le16_to_cpu(action->record.redo_operation);
+	uop = le16_to_cpu(action->record.undo_operation);
+	if (optv)
+		printf("Undo action %d %s (%s) lsn 0x%llx\n",
+			action->num,
+			actionname(rop), actionname(uop),
+			(long long)sle64_to_cpu(
+				action->record.this_lsn));
+	buffer = (char*)NULL;
+	executed = FALSE;
+	kind = ON_NONE;
+	switch (rop) {
+			/* Actions always acting on MFT */
+	case AddIndexEntryRoot :
+	case CreateAttribute :
+	case DeallocateFileRecordSegment :
+	case DeleteAttribute :
+	case DeleteIndexEntryRoot :
+	case InitializeFileRecordSegment :
+	case SetIndexEntryVcnRoot :
+	case SetNewAttributeSizes :
+	case UpdateFileNameRoot :
+	case UpdateMappingPairs :
+	case UpdateResidentValue :
+	case ZeroEndOfFileRecord :
+	case WriteEndofFileRecordSegment :
+	case UpdateRecordDataRoot :
+	case UpdateRelativeDataInIndex :
+		kind = ON_MFT;
+		break;
+			/* Actions always acting on INDX */
+	case AddIndexEntryAllocation :
+	case DeleteIndexEntryAllocation :
+	case SetIndexEntryVcnAllocation :
+	case UpdateFileNameAllocation :
+	case WriteEndOfIndexBuffer :
+	case UpdateRecordDataAllocation :
+	case UpdateRelativeDataInIndex2 :
+		kind = ON_INDX;
+		break;
+			/* Actions never acting on MFT or INDX */
+	case ClearBitsInNonResidentBitMap :
+	case SetBitsInNonResidentBitMap :
+		kind = ON_RAW;
+		break;
+			/* Actions which may act on MFT */
+	case Noop : /* on MFT if DeallocateFileRecordSegment */
+		break;
+			/* Actions which may act on INDX */
+	case UpdateNonResidentValue :
+		/* Known cases : INDX, $SDS, ATTR_LIST */
+		kind = get_action_kind(action);
+		if (kind == ON_NONE)
+			err = 1;
+		break;
+	case OpenNonResidentAttribute :
+		/* probably not important */
+		kind = ON_NONE;
+		break;
+			/* Actions currently ignored */
+	case AttributeNamesDump :
+	case CommitTransaction :
+	case CompensationlogRecord :
+	case DeleteDirtyClusters :
+	case DirtyPageTableDump :
+	case EndTopLevelAction :
+	case ForgetTransaction :
+	case HotFix :
+	case OpenAttributeTableDump :
+	case PrepareTransaction :
+	case TransactionTableDump :
+		kind = ON_NONE;
+		break;
+	}
+	switch (kind) {
+	case ON_MFT :
+/*
+ the check below cannot be used on WinXP
+if (!(action->record.attribute_flags & ACTS_ON_MFT))
+printf("** %s (action %d) not acting on MFT\n",actionname(rop),(int)action->num);
+*/
+		buffer = read_protected(vol, &action->record, mftrecsz, TRUE);
+		entry = (MFT_RECORD*)buffer;
+		if (entry) {
+			if (entry->magic == magic_FILE) {
+				executed = !older_record(entry,
+					&action->record);
+				if (!executed
+				    && exception(action->num))
+					executed = TRUE;
+if (optv > 1)
+printf("record lsn 0x%llx is %s than action %d lsn 0x%llx\n",
+(long long)sle64_to_cpu(entry->lsn),
+(executed ? "not older" : "older"),
+(int)action->num,
+(long long)sle64_to_cpu(action->record.this_lsn));
+			} else {
+				printf("** %s (action %d) not acting on MFT\n",
+					actionname(rop), (int)action->num);
+				err = 1;
+			}
+		} else {
+			/*
+			 * Could not read the MFT record :
+			 * if this is undoing a record create (from scratch)
+			 * which did not take place, there is nothing to redo,
+			 * otherwise this is an error.
+			 */
+			if (check_full_mft(action,TRUE))
+				executed = FALSE;
+			else
+				err = 1;
+		}
+		break;
+	case ON_INDX :
+/*
+ the check below cannot be used on WinXP
+if (!(action->record.attribute_flags & ACTS_ON_INDX))
+printf("** %s (action %d) not acting on INDX\n",actionname(rop),(int)action->num);
+*/
+		xsize = vol->indx_record_size;
+		buffer = read_protected(vol, &action->record, xsize, TRUE);
+		indx = (INDEX_BLOCK*)buffer;
+		if (indx) {
+			if (indx->magic == magic_INDX) {
+				executed = !older_record(indx,
+					&action->record);
+				if (!executed
+				    && exception(action->num))
+					executed = TRUE;
+if (optv > 1)
+printf("index lsn 0x%llx is %s than action %d lsn 0x%llx\n",
+(long long)sle64_to_cpu(indx->lsn),
+(executed ? "not older" : "older"),
+(int)action->num,
+(long long)sle64_to_cpu(action->record.this_lsn));
+			} else {
+				printf("** %s (action %d) not acting on INDX\n",
+					actionname(rop), (int)action->num);
+				err = 1;
+			}
+		} else {
+			/*
+			 * Could not read the INDX record :
+			 * if this is undoing a record create (from scratch)
+			 * which did not take place, there is nothing to redo,
+			 * otherwise this must be an error.
+			 * However, after deleting the last index allocation
+			 * in a block, the block is apparently zeroed
+			 * and cannot be read. In this case we have to
+			 * create an initial index block and apply the undo.
+			 */
+			if (check_full_index(action,TRUE))
+				executed = FALSE;
+			else {
+				err = 1;
+				if (uop == AddIndexEntryAllocation) {
+					executed = TRUE;
+					buffer = (char*)calloc(1, xsize);
+					if (buffer)
+						err = create_indx(vol,
+							action, buffer);
+				}
+			}
+		}
+		break;
+	case ON_RAW :
+		if (action->record.attribute_flags
+				& (ACTS_ON_INDX | ACTS_ON_MFT)) {
+			printf("** Error : action %s on MFT or INDX\n",
+				actionname(rop));
+			err = 1;
+		} else {
+			buffer = read_raw(vol, &action->record);
+			if (!buffer)
+				err = 1;
+		}
+		executed = TRUE;
+		break;
+	default :
+		executed = TRUE;
+		buffer = (char*)NULL;
+		break;
+	}
+	if (!err && executed) {
+		err = distribute_undos(vol, action, buffer);
+		undocount++;
+	}
+	if (buffer)
+		free(buffer);
+
+	return (err);
+}
+
+/*
+ *		Play the undo actions from latest to earliest
+ *
+ *	For structured record, a check is made on the lsn to only
+ *	try to undo the actions which were executed. This implies
+ *	identifying actions on a structured record.
+ *
+ *	Returns 0 if successful
+ */
+
+int play_undos(ntfs_volume *vol, const struct ACTION_RECORD *lastaction)
+{
+	const struct ACTION_RECORD *action;
+	int err;
+
+	err = 0;
+	action = lastaction;
+	while (action && !err) {
+		if ((action->flags & ACTION_TO_UNDO) &&
+			(!optc || within_lcn_range(&action->record)))
+			err = play_one_undo(vol, action);
+		if (!err)
+			action = action->prev;
+	}
+	return (err);
+}
