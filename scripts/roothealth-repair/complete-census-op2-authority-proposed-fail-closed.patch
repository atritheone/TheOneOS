+LCN roothealth_attr_vcn_to_lcn(ntfs_attr *na, VCN vcn)
+{
+	runlist_element *rl;
+	VCN delta;
+
+	rl = ntfs_attr_find_vcn(na, vcn);
+	if (!rl)
+		return LCN_EIO;
+	if (rl->lcn < 0)
+		return rl->lcn;
+	delta = vcn - rl->vcn;
+	if (delta < 0 || delta >= rl->length ||
+			rl->lcn > INT64_MAX - delta) {
+		errno = EIO;
+		return LCN_EIO;
+	}
+	return rl->lcn + delta;
+}
