+	for (i = 0; i < wal->writer->excluded_count; i++) {
+		excluded[i].offset = wal->writer->excluded[i].offset;
+		excluded[i].length = wal->writer->excluded[i].length;
+		if (!excluded[i].length ||
+				excluded[i].offset > wal->writer->device_size ||
+				excluded[i].length > wal->writer->device_size -
+					excluded[i].offset) {
+			errno = EIO;
+			goto out;
+		}
+	}
+	for (i = 0; i < wal->run_count; i++) {
+		allowed[i].offset = wal->writer->raw_wal_allowed[i].offset;
+		allowed[i].length = wal->writer->raw_wal_allowed[i].length;
+		runs[i] = wal->runs[i];
+		if (!allowed[i].length || allowed[i].offset > wal->writer->device_size ||
+				allowed[i].length > wal->writer->device_size -
+					allowed[i].offset || !runs[i].length ||
+				runs[i].device_offset > wal->writer->device_size ||
+				runs[i].length > wal->writer->device_size -
+					runs[i].device_offset) {
+			errno = EIO;
+			goto out;
+		}
+		if (wal->runs[i].stream_offset != expected_stream ||
+				wal->runs[i].length > UINT64_MAX - expected_stream) {
+			errno = EIO;
+			goto out;
+		}
+		expected_stream += wal->runs[i].length;
