+static void roothealth_note_log_page(unsigned int page)
+{
+	if (!rh_examined_pages || page >= rh_pages_expected) {
+		++rh_parse_errors;
+		return;
+	}
+	if (!rh_examined_pages[page]) {
+		rh_examined_pages[page] = 1;
+		++rh_pages_examined;
+	}
