+void hexdump(const char *buf, unsigned int lth)
+{
+	unsigned int i,j,k;
+
+	for (i=0; i<lth; i+=16) {
+		printf("%04x ",i);
+		k = ((lth - i) < 16 ? lth : 16 + i);
+		for (j=i; j<k; j++)
+			printf((j & 3 ? "%02x" : " %02x"),buf[j] & 255);
+		printf("%*c",(152 - 9*(j - i))/4,' ');
+		for (j=i; j<k; j++)
+			if ((buf[j] > 0x20) && (buf[j] < 0x7f))
+				printf("%c",buf[j]);
+			else
+				printf(".");
+		printf("\n");
+	}
+}
