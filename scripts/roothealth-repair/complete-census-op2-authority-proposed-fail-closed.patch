+	const struct rh_overlay_expected_write *writes;
+	size_t write_count;
+};
+
+typedef int (*rh_overlay_action_fn)(ntfs_volume *volume, void *opaque);
+
+enum rh_overlay_action_result {
+	RH_OVERLAY_ACTION_OK = 0,
+	RH_OVERLAY_ACTION_REFUSED = 1,
