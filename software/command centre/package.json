{
  "name": "t1os-command-centre",
  "productName": "T1OS Command Centre",
  "version": "0.3.1",
  "private": true,
  "author": "The One OS project",
  "description": "The One OS build, validation, virtual-machine, and hardware release command centre",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --port 5173\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "npm run build:main && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron@43.4.0": true
  },
  "build": {
    "appId": "t1os.command-centre",
    "productName": "T1OS Command Centre",
    "artifactName": "T1OS Command Centre Portable.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/t1oscommandcentrelogo.png",
        "to": "t1oscommandcentrelogo.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
