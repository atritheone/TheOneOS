{
  "name": "t1os-usb-flasher",
  "productName": "The One OS USB Flasher",
  "version": "0.1.0",
  "private": true,
  "description": "Install The One OS on a USB drive.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --port 5174\" \"wait-on tcp:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "npm run build:main && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.28.1": true
  },
  "build": {
    "appId": "t1os.usb-flasher",
    "productName": "The One OS USB Flasher",
    "artifactName": "The One OS USB Flasher Portable.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/t1os-logo-white-transparent.png",
        "to": "t1os-logo-white-transparent.png"
      },
      {
        "from": "../../scripts/flash hardware usb.ps1",
        "to": "scripts/flash production usb.ps1"
      },
      {
        "from": "../../scripts/validate roothealth journal.py",
        "to": "scripts/validate roothealth journal.py"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
