+struct t1os_required_path {
+	const char *path;
+	BOOL directory;
+};
+
+static int t1os_check_required_path(ntfs_volume *vol,
+		const struct t1os_required_path *required)
+{
+	ntfs_inode *ni;
+	BOOL is_directory;
+
+	ni = ntfs_pathname_to_inode(vol, NULL, required->path);
+	if (!ni) {
+		ntfs_log_error("Required T1OS path is missing or unreadable: %s\n",
+				required->path);
+		return STATUS_ERROR;
+	}
+	is_directory = !!(ni->mrec->flags & MFT_RECORD_IS_DIRECTORY);
+	if (is_directory != required->directory) {
+		ntfs_log_error("Required T1OS path has the wrong type: %s\n",
+				required->path);
+		ntfsck_close_inode(ni);
+		return STATUS_ERROR;
+	}
+	ntfsck_close_inode(ni);
+	return STATUS_OK;
+}
+
+static int t1os_check_forbidden_path(ntfs_volume *vol, const char *path)
+{
+	ntfs_inode *ni;
+
+	errno = 0;
+	ni = ntfs_pathname_to_inode(vol, NULL, path);
+	if (ni) {
+		ntfs_log_error("Forbidden Linux root path is present: %s\n", path);
+		ntfsck_close_inode(ni);
+		return STATUS_ERROR;
+	}
+	if (errno != ENOENT) {
+		ntfs_log_error("Could not prove that forbidden root path is absent: %s\n",
+				path);
+		return STATUS_ERROR;
+	}
+	return STATUS_OK;
+}
+
+static int t1os_check_root_identity(ntfs_volume *vol)
+{
+	static const struct t1os_required_path required[] = {
+		{ "the one", TRUE },
+		{ "the one/software/python/bin/python3.13", FALSE },
+		{ "the one/build/GODDESS/GODDESS.py", FALSE },
+		{ "the one/build/drivers/driverserver.py", FALSE },
+		{ "the one/drivers/tools/modprobe", FALSE },
+		{ "the one/drivers/settings/policy.json", FALSE },
+		{ "the one/drivers/modules/module-manifest.sha256", FALSE },
+	};
+	static const char *forbidden[] = {
+		"bin", "dev", "etc", "home", "lib", "lib64", "mnt", "opt",
+		"proc", "root", "run", "sbin", "srv", "sys", "tmp", "usr", "var",
+	};
+	size_t i;
+
+	t1os_identity_checked = TRUE;
+	for (i = 0; i < sizeof(required) / sizeof(required[0]); i++)
+		if (t1os_check_required_path(vol, &required[i]))
+			return STATUS_ERROR;
+	for (i = 0; i < sizeof(forbidden) / sizeof(forbidden[0]); i++)
+		if (t1os_check_forbidden_path(vol, forbidden[i]))
+			return STATUS_ERROR;
+	t1os_identity_valid = TRUE;
+	ntfs_log_info("Verified the raw T1OS root identity.\n");
+	return STATUS_OK;
+}
+
+static void t1os_write_report(int ret, BOOL dirty)
+{
+	FILE *report;
+	const char *result;
+
+	if (!option.report_path)
+		return;
+	if (ret == RETURN_FS_NO_ERRORS)
+		result = "clean";
+	else if (ret == RETURN_FS_ERRORS_CORRECTED)
+		result = "repaired";
+	else if (ret == RETURN_FS_ERRORS_LEFT_UNCORRECTED)
+		result = "errors";
+	else
+		result = "operational-error";
+	report = fopen(option.report_path, "w");
+	if (!report) {
+		ntfs_log_perror("Could not create T1OS NTFS report");
+		return;
+	}
+	fprintf(report,
+		"{\n"
+		"  \"format\": 1,\n"
+		"  \"checker\": \"roothealth\",\n"
+		"  \"checker_version\": \"%s\",\n"
+		"  \"engine\": \"ntfsprogs-plus\",\n"
+		"  \"engine_version\": \"%s\",\n"
+		"  \"mode\": \"check-only\",\n"
+		"  \"t1os_identity_required\": %s,\n"
+		"  \"t1os_identity_checked\": %s,\n"
+		"  \"t1os_identity_valid\": %s,\n"
+		"  \"dirty\": %s,\n"
+		"  \"errors\": %d,\n"
+		"  \"fixes\": %d,\n"
+		"  \"writes_attempted\": 0,\n"
+		"  \"result\": \"%s\",\n"
+		"  \"exit_code\": %d\n"
+		"}\n",
+		ROOTHEALTH_VERSION, VERSION,
+		option.require_t1os_root ? "true" : "false",
+		t1os_identity_checked ? "true" : "false",
+		t1os_identity_valid ? "true" : "false",
+		dirty ? "true" : "false", fsck_errors, fsck_fixes, result, ret);
+	if (fclose(report))
+		ntfs_log_perror("Could not finish T1OS NTFS report");
+}
