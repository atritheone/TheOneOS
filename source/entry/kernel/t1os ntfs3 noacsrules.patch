diff --git a/fs/ntfs3/inode.c b/fs/ntfs3/inode.c
index 7837aac90628..2fbf14abcb29 100644
--- a/fs/ntfs3/inode.c
+++ b/fs/ntfs3/inode.c
@@ -378,7 +378,9 @@ static struct inode *ntfs_read_mft(struct inode *inode,
 			 * ntfs_get_wsl_perm updates inode->i_uid, inode->i_gid, inode->i_mode
 			 */
-			inode->i_mode = mode;
-			ntfs_get_wsl_perm(inode);
-			mode = inode->i_mode;
+			if (!sbi->options->noacsrules) {
+				inode->i_mode = mode;
+				ntfs_get_wsl_perm(inode);
+				mode = inode->i_mode;
+			}
 		}
 		goto next_attr;
@@ -418,7 +420,14 @@ end_enum:
 		goto out;
 	}
 
-	if (std5->fa & FILE_ATTRIBUTE_READONLY)
+	/*
+	 * Windows uses READONLY on directories for folder customisation; it is
+	 * not a directory write-access rule.  A synthetic noacsrules mount must
+	 * therefore not turn such a directory (including a volume root) into
+	 * 0555 and strand an otherwise writable removable volume.
+	 */
+	if ((std5->fa & FILE_ATTRIBUTE_READONLY) &&
+	    (!S_ISDIR(mode) || !sbi->options->noacsrules))
 		mode &= ~0222;
 
 	if (!names) {
diff --git a/fs/ntfs3/ntfs_fs.h b/fs/ntfs3/ntfs_fs.h
index 068b09ef3ae9..d48f7363e194 100644
--- a/fs/ntfs3/ntfs_fs.h
+++ b/fs/ntfs3/ntfs_fs.h
@@ -109,6 +109,7 @@ struct ntfs_mount_options {
 	unsigned force : 1; /* RW mount dirty volume. */
 	unsigned prealloc : 1; /* Preallocate space when file is growing. */
 	unsigned nocase : 1; /* case insensitive. */
+	unsigned noacsrules : 1; /* Ignore stored WSL uid/gid/mode EAs. */
 	unsigned delalloc : 1; /* delay allocation. */
 };
 
