+/*
+ * Decode a little-endian signed mapping-pair field without shifting a
+ * negative signed value.  Mapping-pair fields are at most 64 bits wide.
+ */
+static int ntfs_mapping_pair_sign_extend(const u8 *buf, u8 size, s64 *value)
+{
+	sle64 encoded;
