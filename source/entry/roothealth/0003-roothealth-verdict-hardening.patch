+static int t1os_status_to_exit(int status)
+{
+	if (status == -ENOMEM)
+		return T1OS_EXIT_INTERNAL;
+	if (status == -EIO)
+		return T1OS_EXIT_IO;
+	return T1OS_EXIT_UNSAFE;
+}
+
+static int t1os_failure_status(int status)
+{
+	if (status == -ENOMEM || errno == ENOMEM)
+		return -ENOMEM;
+	if (status == -EIO || errno == EIO || errno == ENXIO || errno == ENODEV)
+		return -EIO;
+	return status == STATUS_OK ? STATUS_ERROR : status;
+}
+
+static int t1os_merge_status(int current, int candidate)
+{
+	if (current == -ENOMEM || candidate == -ENOMEM)
+		return -ENOMEM;
+	if (current == -EIO || candidate == -EIO)
+		return -EIO;
+	return current == STATUS_OK ? candidate : current;
+}
