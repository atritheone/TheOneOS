+static int t1os_check_logfile_state(ntfs_volume *vol)
+{
+	ntfs_inode *ni;
+	ntfs_attr *na;
+	RESTART_PAGE_HEADER *rp = NULL;
+	int ret = STATUS_ERROR;
+	int saved_errno;
+
+	t1os_logfile_checked = TRUE;
+	errno = 0;
+	ni = ntfs_inode_open(vol, FILE_LogFile);
+	if (!ni) {
+		if (!errno)
+			errno = EIO;
+		return -errno;
+	}
+	na = ntfs_attr_open(ni, AT_DATA, AT_UNNAMED, 0);
+	if (!na) {
+		if (!errno)
+			errno = EIO;
+		ret = -errno;
+		goto out;
+	}
+	errno = 0;
+	if (!ntfs_check_logfile(na, &rp)) {
+		if (errno == ENOMEM)
+			ret = -ENOMEM;
+		else if (errno == EIO)
+			ret = -EIO;
+		else
+			ret = STATUS_ERROR;
+		goto close_attr;
+	}
+	t1os_logfile_clean = ntfs_is_logfile_clean(na, rp);
+	ret = t1os_logfile_clean ? STATUS_OK : STATUS_NOT_FOUND;
+
+close_attr:
+	free(rp);
+	ntfs_attr_close(na);
+out:
+	saved_errno = errno;
+	if (ntfs_inode_close(ni) && ret == STATUS_OK) {
+		ret = -EIO;
+		saved_errno = EIO;
+	}
+	errno = saved_errno;
+	return ret;
+}
